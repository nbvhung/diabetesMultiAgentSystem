// Generated from checksum-verified NIDDK corpus. Education only; no patient records.
// Import into a fresh Neo4j database with cypher-shell -f kb_diabetes.cypher
// Repeated imports of this release are idempotent. No DELETE, APOC or credentials.
CREATE CONSTRAINT diabetessource_id IF NOT EXISTS FOR (n:DiabetesSource) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT diabetesevidence_id IF NOT EXISTS FOR (n:DiabetesEvidence) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT diabetestopic_id IF NOT EXISTS FOR (n:DiabetesTopic) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT diabetesconcept_id IF NOT EXISTS FOR (n:DiabetesConcept) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT diabetesassertion_id IF NOT EXISTS FOR (n:DiabetesAssertion) REQUIRE n.id IS UNIQUE;
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"011474eee8e2a56797d24ddbbf2196c378db94f80681c0c57f29741d747ea735"}) SET c += {`id`:"011474eee8e2a56797d24ddbbf2196c378db94f80681c0c57f29741d747ea735",`source_id`:"eye",`text`:"During vitrectomy, a clear salt solution is gently pumped into the eye to maintain eye pressure during surgery and to replace the removed vitreous. Vitrectomy is done in a surgery center or hospital with pain medicine.",`section`:"Vitrectomy",`section_context`:"How do doctors treat diabetic eye disease? / Vitrectomy",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"01b8b0ebb69f0dbf1677112d2860ac240acfc0b0c8eee1e514243c61dc19bcca"}) SET c += {`id`:"01b8b0ebb69f0dbf1677112d2860ac240acfc0b0c8eee1e514243c61dc19bcca",`source_id`:"prediabetes",`text`:"If you’re worried about your child’s weight and they have insulin resistance or prediabetes, talk with their health care professional before your child starts a new weight-loss plan.",`section`:"Managing your weight",`section_context`:"How can I prevent or reverse insulin resistance and prediabetes? / Managing your weight",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"01e5d84f9e4317bef9274597171d3c2dc7dfb0f849b9bb24752bd35685669fd6"}) SET c += {`id`:"01e5d84f9e4317bef9274597171d3c2dc7dfb0f849b9bb24752bd35685669fd6",`source_id`:"management",`text`:"The diabetes ABCs can help you manage your blood glucose, blood pressure, and cholesterol levels. If you smoke, quitting is also important. Managing your ABCs may lower your chances of having health problems from diabetes, such as a heart attack, stroke, kidney disease, blindness, and foot or leg amputations .",`section`:"What are the diabetes ABCs?",`section_context`:"What are the diabetes ABCs?",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"01f827b0de971ade8f585a775bb564659421bec24865c5c233248cb7413c3c9f"}) SET c += {`id`:"01f827b0de971ade8f585a775bb564659421bec24865c5c233248cb7413c3c9f",`source_id`:"foot",`text`:"Wear socks in bed if your feet get cold. In the winter, wear lined, waterproof boots to keep your feet warm and dry.",`section`:"Protect your feet from hot and cold",`section_context`:"What can I do to keep my feet healthy? / Protect your feet from hot and cold",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"02606ea4ba0f3a32fc11f96e3bac32cec37baeca3b44ab4e0cc8ca65c4f1cdd2"}) SET c += {`id`:"02606ea4ba0f3a32fc11f96e3bac32cec37baeca3b44ab4e0cc8ca65c4f1cdd2",`source_id`:"prediabetes",`text`:"The National Institutes of Health (NIH)-funded research study, Diabetes Prevention Program (DPP) , showed that for people at high risk of developing diabetes, losing 5% to 7% of their starting weight helped reduce their chance of developing the disease. 4,5",`section`:"Managing your weight",`section_context`:"How can I prevent or reverse insulin resistance and prediabetes? / Managing your weight",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prevention"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`title`:"Preventing Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba"} MERGE (c:DiabetesEvidence {id:"03657c287fe056af1f509a55365f9cfc7eb58a77cb1e22d53abd600c838fb4f7"}) SET c += {`id`:"03657c287fe056af1f509a55365f9cfc7eb58a77cb1e22d53abd600c838fb4f7",`source_id`:"prevention",`text`:"About 1 in 3 Americans has prediabetes, according to recent diabetes statistics from the Centers for Disease Control and Prevention. You won’t know if you have prediabetes unless you are tested.",`section`:"What should I do if my health care professional told me I have prediabetes?",`section_context`:"What should I do if my health care professional told me I have prediabetes?",`title`:"Preventing Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:49.393819+00:00",`last_reviewed`:"Last Reviewed November 2016",`source_sha256`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba",`topics`:["diabetes","prevention"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prevention"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"0373a23bab03d4fb8a71896dd3818e9fc95f3a29acff5788de48010c9f37ba00"}) SET c += {`id`:"0373a23bab03d4fb8a71896dd3818e9fc95f3a29acff5788de48010c9f37ba00",`source_id`:"type1",`text`:"The first symptoms of type 1 diabetes can be symptoms of DKA , especially in children. Symptoms of DKA include",`section`:"What are the symptoms of type 1 diabetes?",`section_context`:"What are the symptoms of type 1 diabetes?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"03bd30abf363c6817fc2e61c1a5ddf3e0718f190cda4a0bb34dbbedff35e591b"}) SET c += {`id`:"03bd30abf363c6817fc2e61c1a5ddf3e0718f190cda4a0bb34dbbedff35e591b",`source_id`:"management",`text`:"Symptoms of diabetic ketoacidosis include feeling very tired having trouble breathing having fruity-smelling breath fainting",`section`:"Checking urine for ketones",`section_context`:"How can I check my blood glucose level at home? / Checking urine for ketones",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"042436c3cb9b76ea4548fe645cf02e14207ae5fdbad0014559482e22a66fc72c"}) SET c += {`id`:"042436c3cb9b76ea4548fe645cf02e14207ae5fdbad0014559482e22a66fc72c",`source_id`:"symptoms",`text`:"Common symptoms of diabetes include increased urination feeling very thirsty feeling very hungry, even after you have eaten blurred vision fatigue sores that do not heal frequent infections, such as urinary tract infections , skin infections , or yeast infections",`section`:"What are the symptoms of diabetes?",`section_context`:"What are the symptoms of diabetes?",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"risk"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`title`:"Risk Factors for Type 2 Diabetes",`publisher`:"NIDDK",`version`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114"} MERGE (c:DiabetesEvidence {id:"04a05d8e2a2314f0f1ddee03e975cc17efb5cafc62283d75eb61b29cedffe701"}) SET c += {`id`:"04a05d8e2a2314f0f1ddee03e975cc17efb5cafc62283d75eb61b29cedffe701",`source_id`:"risk",`text`:"Children and teens are also at higher risk of developing type 2 diabetes if, in addition to the previous risk factors, they were born with a low birth weight or if their parent had gestational diabetes while pregnant with the child. 1",`section`:"What are the risk factors for type 2 diabetes?",`section_context`:"What are the risk factors for type 2 diabetes?",`title`:"Risk Factors for Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:48.116337+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114",`topics`:["diabetes","risk"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","risk"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"0561be1181ed19ef7b9f652bc09470be92f139c95ad40c0530cc622ccb7d0940"}) SET c += {`id`:"0561be1181ed19ef7b9f652bc09470be92f139c95ad40c0530cc622ccb7d0940",`source_id`:"foot",`text`:"Call your health care provider right away if you have",`section`:"When should I see my health care provider about foot problems?",`section_context`:"When should I see my health care provider about foot problems?",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"05f8f51d0cf35f103ef0b4fb76c454c64f0e8dd5cf7dbf0c9c5e817c24d2515c"}) SET c += {`id`:"05f8f51d0cf35f103ef0b4fb76c454c64f0e8dd5cf7dbf0c9c5e817c24d2515c",`source_id`:"living",`text`:"You may be able to reach and maintain a healthy weight by following a healthy meal plan consuming fewer calories being physically active getting 7 to 8 hours of sleep each night 3",`section`:"What can I do to reach or maintain a healthy weight?",`section_context`:"What can I do to reach or maintain a healthy weight?",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"06b05e4db7c7b3abd468579a98a823e08c99f1d450cdbee6271c8f33f1f1d1e8"}) SET c += {`id`:"06b05e4db7c7b3abd468579a98a823e08c99f1d450cdbee6271c8f33f1f1d1e8",`source_id`:"symptoms",`text`:"Researchers don’t fully know what causes problems with insulin production and insulin resistance in type 2 diabetes. However, people are more likely to develop type 2 diabetes if they have overweight, obesity , or a large waist size. are age 35 or older. Children and teens can also develop type 2 diabetes, but the risk increases as a person gets older. have a family history of type 2 diabetes. are African American, American Indian, Asian American, Hispanic, Latino, or Pacific Islander.",`section`:"What causes type 2 diabetes?",`section_context`:"What causes type 2 diabetes?",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"06e6effa6a1f8fd00d38aa8ba0c37f63b3c6de8ff4136d7bc9ada6d8b44a02d6"}) SET c += {`id`:"06e6effa6a1f8fd00d38aa8ba0c37f63b3c6de8ff4136d7bc9ada6d8b44a02d6",`source_id`:"living",`text`:"People with diabetes may have problems with their feet because high blood glucose levels can damage blood vessels and nerves. To help prevent foot problems, wear comfortable and supportive shoes and take care of your feet before, during, and after physical activity.",`section`:"Stay safe during physical activity",`section_context`:"How can physical activity help manage my diabetes? / Stay safe during physical activity",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"0776c1eb9e9cea0087f982e5ae12894d569db4747be07a1c143f61ba2605bd80"}) SET c += {`id`:"0776c1eb9e9cea0087f982e5ae12894d569db4747be07a1c143f61ba2605bd80",`source_id`:"prediabetes",`text`:"having a history of gestational diabetes , a type of diabetes that develops during pregnancy, or having given birth to a baby weighing 9 pounds or more. having other diseases or conditions such as polycystic ovary syndrome (PCOS) , Cushing’s syndrome , acromegaly , sleep apnea , or viral diseases like COVID-19. taking certain medicines over time, such as glucocorticoids , some antipsychotics , and some medicines for HIV.",`section`:"Who is more likely to develop insulin resistance or prediabetes?",`section_context`:"Who is more likely to develop insulin resistance or prediabetes?",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"085539fdccc3cacca957c5f7d550f84c0e9764851a7ec3124668400b939b0acb"}) SET c += {`id`:"085539fdccc3cacca957c5f7d550f84c0e9764851a7ec3124668400b939b0acb",`source_id`:"eye",`text`:"Most people with diabetes should see an eye care professional once a year for a complete eye exam. Your own health care team may suggest a different plan, based on your type of diabetes and the time since you were first diagnosed.",`section`:"How do doctors diagnose eye problems from diabetes?",`section_context`:"How do doctors diagnose eye problems from diabetes?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"08c1b3cb557e5c464881728a049372ef16dc31ba5e3f9922613f6f197dcb351d"}) SET c += {`id`:"08c1b3cb557e5c464881728a049372ef16dc31ba5e3f9922613f6f197dcb351d",`source_id`:"prediabetes",`text`:"In 2021, about 97.6 million people in the United States ages 18 and older had prediabetes. 1 The number of adults in the United States with prediabetes, in different age groups, hasn’t changed in the last 15 years. 1",`section`:"How common is prediabetes?",`section_context`:"How common is prediabetes?",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"093230f2937aacf6fa37416c8f7b5f5a779e61b2f3954ee09dad74ae3c049074"}) SET c += {`id`:"093230f2937aacf6fa37416c8f7b5f5a779e61b2f3954ee09dad74ae3c049074",`source_id`:"prediabetes",`text`:"Insulin resistance means that cells in your muscles, fat, and liver don’t respond well to insulin. If your cells don’t respond well to insulin, over time your pancreas may not make enough insulin to help extra glucose enter your cells. When extra glucose can’t enter your cells, you may have higher levels of glucose in your blood. When your blood glucose levels get higher than normal but not high enough to be diagnosed as diabetes, you have prediabetes.",`section`:"What causes insulin resistance and prediabetes?",`section_context`:"What causes insulin resistance and prediabetes?",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"09d7d53fc9526a5fb40c033fa1e852cabc44a52a20137dca34f68dbe07aba5f5"}) SET c += {`id`:"09d7d53fc9526a5fb40c033fa1e852cabc44a52a20137dca34f68dbe07aba5f5",`source_id`:"management",`text`:"If you take insulin or other diabetes medicines, checking your blood glucose level at home may help you avoid high or low blood glucose levels. Even if you do not use insulin, checking your blood glucose level at home can help you manage your diabetes. The test results may help you and your health care team make changes to your meal plan, physical activity level, or diabetes medicines. It may help you understand how certain types of food affect your blood glucose level.",`section`:"How can I check my blood glucose level at home?",`section_context`:"How can I check my blood glucose level at home?",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"09f55374e5df15fafed5aa78c31fd2fb5dcf17eda80c34e0331da336088848b1"}) SET c += {`id`:"09f55374e5df15fafed5aa78c31fd2fb5dcf17eda80c34e0331da336088848b1",`source_id`:"type1",`text`:"For safety, it’s important to act quickly if a CGM alarm sounds.",`section`:"Diabetes devices and technology",`section_context`:"How can I manage type 1 diabetes? / Diabetes devices and technology",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"0a22a3d3d0f13d29883bd8631c168dda2790d5ae22e6c56e63c1fd7076515492"}) SET c += {`id`:"0a22a3d3d0f13d29883bd8631c168dda2790d5ae22e6c56e63c1fd7076515492",`source_id`:"symptoms",`text`:"Some endocrine diseases make the body produce too much of certain hormones. High levels of these hormones may cause insulin resistance or diabetes.",`section`:"Endocrine diseases",`section_context`:"What else can cause diabetes? / Endocrine diseases",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"0ad96d0f73ac6e4a9caf75ae702c1e4f6e7615a6b3e619f89cb2847d2448ea48"}) SET c += {`id`:"0ad96d0f73ac6e4a9caf75ae702c1e4f6e7615a6b3e619f89cb2847d2448ea48",`source_id`:"tests",`text`:"Children can also develop type 2 diabetes. Experts recommend testing children and teens between the ages of 10 and 18 who are overweight or have obesity and have at least one more risk factor, such as a low birth weight, a parent who had diabetes while pregnant, or another factor. 1",`section`:"Type 2 diabetes",`section_context`:"Who should be tested for diabetes? / Type 2 diabetes",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"0b5eb0618ee1825f2f79c6d675a8dc9cb6445454b7e29f0031a1150a1e0a3e98"}) SET c += {`id`:"0b5eb0618ee1825f2f79c6d675a8dc9cb6445454b7e29f0031a1150a1e0a3e98",`source_id`:"foot",`text`:"Get a thorough foot exam at each health care visit if you have changes in the shape of your feet loss of feeling in your feet peripheral artery disease had foot ulcers or an amputation in the past 1",`section`:"Get a foot check at every health care visit",`section_context`:"What can I do to keep my feet healthy? / Get a foot check at every health care visit",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"0b8019281f1897fe77369b2f5138742490708f4498e04678184cbe4894d99d69"}) SET c += {`id`:"0b8019281f1897fe77369b2f5138742490708f4498e04678184cbe4894d99d69",`source_id`:"living",`text`:"Carbohydrate counting , or carb counting, means planning and keeping track of the amount of carbs you eat and drink in each meal or snack. Not all people with diabetes need to count carbs. However, if you take insulin, counting carbs can help you know how much insulin to take.",`section`:"Plan how much to eat or drink",`section_context`:"How can I plan what to eat or drink when I have diabetes? / Plan how much to eat or drink",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"risk"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`title`:"Risk Factors for Type 2 Diabetes",`publisher`:"NIDDK",`version`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114"} MERGE (c:DiabetesEvidence {id:"0be5eb790dfb716a12c9a19339084fa484b9d6d2c0681922c4b82db5f3f22d20"}) SET c += {`id`:"0be5eb790dfb716a12c9a19339084fa484b9d6d2c0681922c4b82db5f3f22d20",`source_id`:"risk",`text`:"You are encouraged to talk with a doctor about any of the health conditions listed above that may require medical treatment. Managing health problems may help reduce your chances of developing type 2 diabetes. 2 Also, ask your doctor about any medicines you or your child take that might increase your risk. You can also take the Diabetes Risk Test to learn more about your risk for type 2 diabetes.",`section`:"What are the risk factors for type 2 diabetes?",`section_context`:"What are the risk factors for type 2 diabetes?",`title`:"Risk Factors for Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:48.116337+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114",`topics`:["diabetes","risk"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","risk"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"0dac43c9f5740df9bc37a06de363a8c39a695eca07db717b8ecb32f7ca7b84ff"}) SET c += {`id`:"0dac43c9f5740df9bc37a06de363a8c39a695eca07db717b8ecb32f7ca7b84ff",`source_id`:"tests",`text`:"Experts recommend routine testing for type 2 diabetes if you have certain risk factors . You may have a higher risk of developing type 2 diabetes if you are",`section`:"Type 2 diabetes",`section_context`:"Who should be tested for diabetes? / Type 2 diabetes",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prevention"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`title`:"Preventing Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba"} MERGE (c:DiabetesEvidence {id:"0dce34d578bb6e6b76dfa0862b744725c1106a45e458322d27f5617ecc2a9637"}) SET c += {`id`:"0dce34d578bb6e6b76dfa0862b744725c1106a45e458322d27f5617ecc2a9637",`source_id`:"prevention",`text`:"Ask your doctor if you should take the diabetes drug metformin to help prevent or delay type 2 diabetes. 1",`section`:"Preventing Type 2 Diabetes",`section_context`:"Preventing Type 2 Diabetes",`title`:"Preventing Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:49.393819+00:00",`last_reviewed`:"Last Reviewed November 2016",`source_sha256`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba",`topics`:["diabetes","prevention"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prevention"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"0ded8f3a6c35d63fefcdbd7b755e23e6481333da762e1ed04fb62d9d8fd53184"}) SET c += {`id`:"0ded8f3a6c35d63fefcdbd7b755e23e6481333da762e1ed04fb62d9d8fd53184",`source_id`:"management",`text`:"Glucagon—a hormone that raises blood glucose levels—is the best way to treat severely low blood glucose . Ask your health care team if you need a prescription for glucagon. If you have a glucagon prescription, you should teach your family, friends, and coworkers when and how to give you glucagon in case you are not able to do it yourself.",`section`:"Recommended targets for blood glucose levels",`section_context`:"How can I check my blood glucose level at home? / Recommended targets for blood glucose levels",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"1030c4fc50a2f6e1c274dd357c42ea60d1be98a65ea73ab33c7187079d6efd5b"}) SET c += {`id`:"1030c4fc50a2f6e1c274dd357c42ea60d1be98a65ea73ab33c7187079d6efd5b",`source_id`:"foot",`text`:"Get a thorough foot exam at each health care visit if you have",`section`:"Get a foot check at every health care visit",`section_context`:"What can I do to keep my feet healthy? / Get a foot check at every health care visit",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"11b2c6578d7ee3e9101fcf9a15ac92934944849b697b766c532cfab09ea4f34b"}) SET c += {`id`:"11b2c6578d7ee3e9101fcf9a15ac92934944849b697b766c532cfab09ea4f34b",`source_id`:"management",`text`:"Diabetes can affect almost every part of your body, including your heart, eyes, kidneys, and nerves. Diabetes is also linked to some types of cancer. You may be able to prevent or delay diabetes health problems by leading a healthy lifestyle, taking your medicines, and managing your blood glucose level, also called blood sugar level. Work with your health care team to create a diabetes care plan that works for you.",`section`:"Managing Diabetes",`section_context`:"Managing Diabetes",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"1270b96225eefb6adeeb86eb3138900af243e8667162b0beaf181134b3a0759c"}) SET c += {`id`:"1270b96225eefb6adeeb86eb3138900af243e8667162b0beaf181134b3a0759c",`source_id`:"eye",`text`:"Anyone with diabetes can develop diabetic eye disease. Your risk is greater with",`section`:"Who is more likely to develop diabetic eye disease?",`section_context`:"Who is more likely to develop diabetic eye disease?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"130f8e14063b5e6611c87504de51f152d1d112d925c12cb4868fcd2cf7117d72"}) SET c += {`id`:"130f8e14063b5e6611c87504de51f152d1d112d925c12cb4868fcd2cf7117d72",`source_id`:"eye",`text`:"Most serious diabetic eye diseases begin with blood vessel problems. The four eye diseases that can threaten your sight are",`section`:"How does diabetes affect my eyes?",`section_context`:"How does diabetes affect my eyes?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"13d99d2019e6ea092ffbf5043fd09118e4617b2640d88b2666b86bc4942913d2"}) SET c += {`id`:"13d99d2019e6ea092ffbf5043fd09118e4617b2640d88b2666b86bc4942913d2",`source_id`:"type1",`text`:"A continuous glucose monitor (CGM) is a device that automatically tracks your blood glucose level throughout the day and night. Researchers have found that using a CGM at home may help you manage your blood glucose level and reduce your risk of developing health problems from diabetes.",`section`:"Diabetes devices and technology",`section_context`:"How can I manage type 1 diabetes? / Diabetes devices and technology",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"14f5611d939bc325bec9bfc0072ea086156a410c90cccc6434dda37312e3be9e"}) SET c += {`id`:"14f5611d939bc325bec9bfc0072ea086156a410c90cccc6434dda37312e3be9e",`source_id`:"tests",`text`:"Adults and children with normal diabetes test results should be retested every 3 years. 1",`section`:"Type 2 diabetes",`section_context`:"Who should be tested for diabetes? / Type 2 diabetes",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"definition"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`title`:"What Is Diabetes?",`publisher`:"NIDDK",`version`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1"} MERGE (c:DiabetesEvidence {id:"14fcdd61e8d50fde23be19eccf47507722e017501955dfd2e3f4966f263ea6d9"}) SET c += {`id`:"14fcdd61e8d50fde23be19eccf47507722e017501955dfd2e3f4966f263ea6d9",`source_id`:"definition",`text`:"You can help delay or prevent type 2 diabetes by knowing the risk factors and taking steps toward a healthier lifestyle, such as losing weight or preventing weight gain.",`section`:"Type 2 diabetes",`section_context`:"What are the different types of diabetes? / Type 2 diabetes",`title`:"What Is Diabetes?",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.530017+00:00",`last_reviewed`:"Last Reviewed April 2023",`source_sha256`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1",`topics`:["diabetes","types"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","types"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"1549ec5b967dea238246a636e83aae3266f78e4a829813abd373f428861421ba"}) SET c += {`id`:"1549ec5b967dea238246a636e83aae3266f78e4a829813abd373f428861421ba",`source_id`:"foot",`text`:"After washing and drying your feet, put talcum powder or cornstarch between your toes. Skin between the toes tends to stay moist. Powder will keep the skin dry to help prevent an infection.",`section`:"Wash your feet every day",`section_context`:"What can I do to keep my feet healthy? / Wash your feet every day",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"definition"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`title`:"What Is Diabetes?",`publisher`:"NIDDK",`version`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1"} MERGE (c:DiabetesEvidence {id:"162dcbd1a8632fb3bf852b718b10dae5158449092773d1edfffb49e00880b91c"}) SET c += {`id`:"162dcbd1a8632fb3bf852b718b10dae5158449092773d1edfffb49e00880b91c",`source_id`:"definition",`text`:"Diabetes raises the risk for damage to the eyes, kidneys, nerves, and heart. Diabetes is also linked to some types of cancer. Taking steps to prevent or manage diabetes may lower your risk of developing diabetes health problems.",`section`:"What Is Diabetes?",`section_context`:"What Is Diabetes?",`title`:"What Is Diabetes?",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.530017+00:00",`last_reviewed`:"Last Reviewed April 2023",`source_sha256`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1",`topics`:["diabetes","types"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","types"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"16dd4f595296e2e8f56e92a798dd93306caad02057f0747c3fcd219b2ea46632"}) SET c += {`id`:"16dd4f595296e2e8f56e92a798dd93306caad02057f0747c3fcd219b2ea46632",`source_id`:"living",`text`:"Talk with your health care professional or health care team about when you should eat or drink. The best time to have meals and snacks may depend on",`section`:"Find the best times to eat or drink",`section_context`:"How can I plan what to eat or drink when I have diabetes? / Find the best times to eat or drink",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"definition"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`title`:"What Is Diabetes?",`publisher`:"NIDDK",`version`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1"} MERGE (c:DiabetesEvidence {id:"1866fe29fd314753711f3bcff48edaa85bb3b016c3e0bd9403d80a8ad0255186"}) SET c += {`id`:"1866fe29fd314753711f3bcff48edaa85bb3b016c3e0bd9403d80a8ad0255186",`source_id`:"definition",`text`:"Managing your blood glucose levels can help prevent future health problems, such as damage to your eyes.",`section`:"What other health problems can people with diabetes develop?",`section_context`:"What other health problems can people with diabetes develop?",`title`:"What Is Diabetes?",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.530017+00:00",`last_reviewed`:"Last Reviewed April 2023",`source_sha256`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1",`topics`:["diabetes","types"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","types"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"1887c3f2250a95f7804f6e7af742adbda38459cba37138f994b01360e10bfc91"}) SET c += {`id`:"1887c3f2250a95f7804f6e7af742adbda38459cba37138f994b01360e10bfc91",`source_id`:"management",`text`:"You are the most important member of your health care team, but working with your health care team may help you improve your self-care. Most people with diabetes get help from a primary care professional, such as an internal medicine doctor, family doctor, pediatrician, physician assistant, or certified nurse practitioner trained in diabetes care. Ask your primary care professional about adding other members to your team, including",`section`:"Who should be on my health care team?",`section_context`:"Who should be on my health care team?",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"1a34b6699d0337d0d0bdf40d1e109c604d7d24ba6bd230b8c6d817e6355038cd"}) SET c += {`id`:"1a34b6699d0337d0d0bdf40d1e109c604d7d24ba6bd230b8c6d817e6355038cd",`source_id`:"eye",`text`:"High blood cholesterol and smoking may also raise your risk for diabetic eye disease.",`section`:"Who is more likely to develop diabetic eye disease?",`section_context`:"Who is more likely to develop diabetic eye disease?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"1a743a89c7f61baa1eb20e3a31fdd3901e2ae72be9cf6f402434b09ca0391636"}) SET c += {`id`:"1a743a89c7f61baa1eb20e3a31fdd3901e2ae72be9cf6f402434b09ca0391636",`source_id`:"living",`text`:"Some activities that need balance may be unsafe for people with nerve damage or vision problems caused by diabetes. Ask your health care professional or health care team about activities that are safe for you.",`section`:"Do different types of physical activity",`section_context`:"How can physical activity help manage my diabetes? / Do different types of physical activity",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"1aee9dcaf87d4c1b0694ef954c51664752607ecada3ce64be5feab517d5e8b57"}) SET c += {`id`:"1aee9dcaf87d4c1b0694ef954c51664752607ecada3ce64be5feab517d5e8b57",`source_id`:"prediabetes",`text`:"Planning and tracking your progress can also help you make lifestyle changes. You may be able to take part in a lifestyle change program as part of the National Diabetes Prevention Program .",`section`:"Healthy living",`section_context`:"How can I prevent or reverse insulin resistance and prediabetes? / Healthy living",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"risk"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`title`:"Risk Factors for Type 2 Diabetes",`publisher`:"NIDDK",`version`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114"} MERGE (c:DiabetesEvidence {id:"1af81e05011fa5fedcd9e5bf871866288f7df3f7103f64490f69ac7fc220bee8"}) SET c += {`id`:"1af81e05011fa5fedcd9e5bf871866288f7df3f7103f64490f69ac7fc220bee8",`source_id`:"risk",`text`:"If you have overweight or obesity, you may be able to prevent or delay type 2 diabetes by losing weight and being more physically active. 1",`section`:"Does your weight put you at risk for type 2 diabetes?",`section_context`:"Does your weight put you at risk for type 2 diabetes?",`title`:"Risk Factors for Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:48.116337+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114",`topics`:["diabetes","risk"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","risk"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"1baa4ddecf54484ee88ee5b872a240a7322d87cc1abd6b617b8910bd353d75da"}) SET c += {`id`:"1baa4ddecf54484ee88ee5b872a240a7322d87cc1abd6b617b8910bd353d75da",`source_id`:"foot",`text`:"If you have nerve damage from diabetes, you may burn your feet and not know you did. Take the following steps to protect your feet from heat: Wear shoes at the beach and on hot pavement. Put sunscreen on the tops of your feet to prevent sunburn. Keep your feet away from heaters and open fires. Do not put a hot water bottle or heating pad on your feet.",`section`:"Protect your feet from hot and cold",`section_context`:"What can I do to keep my feet healthy? / Protect your feet from hot and cold",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"1bf25f4e96b9f8e13f5521c4f7d181d9a287df048394b9858918bb8c26f073b3"}) SET c += {`id`:"1bf25f4e96b9f8e13f5521c4f7d181d9a287df048394b9858918bb8c26f073b3",`source_id`:"prediabetes",`text`:"Along with healthy living and managing weight, health care professionals may also prescribe medicines such as metformin to help you manage your blood glucose levels and to prevent type 2 diabetes.",`section`:"Medicines for insulin resistance and prediabetes",`section_context`:"How can I prevent or reverse insulin resistance and prediabetes? / Medicines for insulin resistance and prediabetes",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"1c369faf2d5c3e43615c5ce96c4bbed3eaab202c21f73e7bc47756343e60c050"}) SET c += {`id`:"1c369faf2d5c3e43615c5ce96c4bbed3eaab202c21f73e7bc47756343e60c050",`source_id`:"living",`text`:"Work with your health care team to create a meal plan that works for you. You may want to have a diabetes educator or a registered dietitian on your team. A registered dietitian can provide medical nutrition therapy , which includes counseling to help you create and follow a meal plan. Your health care team may be able to recommend other resources, such as a healthy lifestyle coach, to help you with making changes.",`section`:"Plan how much to eat or drink",`section_context`:"How can I plan what to eat or drink when I have diabetes? / Plan how much to eat or drink",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"1cbc4877f45e4408b2ac3f8aa32a59d52d8bdaa0c4ed182b068c93fb24071b9d"}) SET c += {`id`:"1cbc4877f45e4408b2ac3f8aa32a59d52d8bdaa0c4ed182b068c93fb24071b9d",`source_id`:"foot",`text`:"Diabetes also can lower the amount of blood flow in your feet. Not having enough blood flowing to your legs and feet can make it hard for a sore or an infection to heal. Sometimes, a bad infection never heals. The infection might lead to gangrene .",`section`:"How can diabetes affect my feet?",`section_context`:"How can diabetes affect my feet?",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"1d0e7c6d3ac2843e97b8409ed04dfc4507db0e58800da386bac1116f0d02326e"}) SET c += {`id`:"1d0e7c6d3ac2843e97b8409ed04dfc4507db0e58800da386bac1116f0d02326e",`source_id`:"eye",`text`:"Often, there are no warning signs of diabetic eye disease or vision loss when damage first develops. A full, dilated eye exam helps your doctor find and treat eye problems early—often before much vision loss can occur.",`section`:"What is diabetic eye disease?",`section_context`:"What is diabetic eye disease?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"1d1c3c80bcc179dddfa46c233cf72236bbd1cc4870612389f4e1039bc2ea5b0a"}) SET c += {`id`:"1d1c3c80bcc179dddfa46c233cf72236bbd1cc4870612389f4e1039bc2ea5b0a",`source_id`:"living",`text`:"Staying safe during physical activity is important. Here are some tips to keep in mind.",`section`:"Stay safe during physical activity",`section_context`:"How can physical activity help manage my diabetes? / Stay safe during physical activity",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"1e2b8f4fe833d999f8c2743504bc50ecac5b8c4528289a92df4432389fe47e43"}) SET c += {`id`:"1e2b8f4fe833d999f8c2743504bc50ecac5b8c4528289a92df4432389fe47e43",`source_id`:"eye",`text`:"Your chances of developing diabetic eye disease increase the longer you have diabetes.",`section`:"Who is more likely to develop diabetic eye disease?",`section_context`:"Who is more likely to develop diabetic eye disease?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"1eec601746b0358da2d1b9dc74265a9ef01f95e05ff17f12211fd1565ec862ad"}) SET c += {`id`:"1eec601746b0358da2d1b9dc74265a9ef01f95e05ff17f12211fd1565ec862ad",`source_id`:"eye",`text`:"The lenses within our eyes are clear structures that help provide sharp vision—but they tend to become cloudy as we age. People with diabetes are more likely to develop cloudy lenses, called cataracts . People with diabetes can develop cataracts at an earlier age than people without diabetes. Researchers think that high glucose levels cause deposits to build up in the lenses of your eyes.",`section`:"Cataracts",`section_context`:"How does diabetes affect my eyes? / Cataracts",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"1f0a3d57c1586e232789594ec864830915683257c10f51e123961cfc1b9ec376"}) SET c += {`id`:"1f0a3d57c1586e232789594ec864830915683257c10f51e123961cfc1b9ec376",`source_id`:"management",`text`:"People who take insulin to manage their diabetes may benefit from using a continuous glucose monitor (CGM). A CGM uses a sensor in the tissue under your skin and shows changes in glucose levels throughout the day and night. Many CGM systems have alarms and warnings that let you know if your glucose level is too low or too high.",`section`:"Devices to help manage diabetes",`section_context`:"How can I check my blood glucose level at home? / Devices to help manage diabetes",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"1f5958f8531932959c9b32e2eae7fdcee40592f2e47673e07333c5db9d6d4ff6"}) SET c += {`id`:"1f5958f8531932959c9b32e2eae7fdcee40592f2e47673e07333c5db9d6d4ff6",`source_id`:"foot",`text`:"Trim your toenails, when needed, after you wash and dry your feet. Using toenail clippers, trim your toenails straight across. Do not cut into the corners of your toenail. Gently smooth each nail with an emery board or nonsharp nail file. Trimming this way helps prevent cutting your skin and keeps the nails from growing into your skin.",`section`:"Trim your toenails straight across",`section_context`:"What can I do to keep my feet healthy? / Trim your toenails straight across",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"definition"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`title`:"What Is Diabetes?",`publisher`:"NIDDK",`version`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1"} MERGE (c:DiabetesEvidence {id:"204899671784b6a266b32c7c65d61e91c5ee93503b67239b32549e4e6b481d3b"}) SET c += {`id`:"204899671784b6a266b32c7c65d61e91c5ee93503b67239b32549e4e6b481d3b",`source_id`:"definition",`text`:"Insulin is a hormone made by the pancreas that helps glucose get into your cells to be used for energy. If you have diabetes, your body doesn’t make enough—or any—insulin, or doesn’t use insulin properly. Glucose then stays in your blood and doesn’t reach your cells.",`section`:"What Is Diabetes?",`section_context`:"What Is Diabetes?",`title`:"What Is Diabetes?",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.530017+00:00",`last_reviewed`:"Last Reviewed April 2023",`source_sha256`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1",`topics`:["diabetes","types"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","types"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"2121f33a74395c38b08ee2a0df08b2cdc9daeec84c9ecdf93f99ee455d2b282f"}) SET c += {`id`:"2121f33a74395c38b08ee2a0df08b2cdc9daeec84c9ecdf93f99ee455d2b282f",`source_id`:"living",`text`:"People with diabetes can be active, even if they take insulin or use technology such as insulin pumps .",`section`:"Do different types of physical activity",`section_context`:"How can physical activity help manage my diabetes? / Do different types of physical activity",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"22460e33478a1d0073c34912010062b234480c99341d9dd94a23aba16eb695dd"}) SET c += {`id`:"22460e33478a1d0073c34912010062b234480c99341d9dd94a23aba16eb695dd",`source_id`:"tests",`text`:"All pregnant women who do not have a previous diagnosis of diabetes should be tested for gestational diabetes between 24 and 28 weeks of pregnancy. 1",`section`:"Gestational diabetes",`section_context`:"Who should be tested for diabetes? / Gestational diabetes",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"239e2e694f45858a99ab3779bea21f8b68c34594b33a42c8730bbb3491d5f712"}) SET c += {`id`:"239e2e694f45858a99ab3779bea21f8b68c34594b33a42c8730bbb3491d5f712",`source_id`:"living",`text`:"Protein foods—such as lean meats, fish, dairy, or tofu or other soy products—should make up one quarter of your plate.",`section`:"Plan how much to eat or drink",`section_context`:"How can I plan what to eat or drink when I have diabetes? / Plan how much to eat or drink",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"241b765c44da28f65fea7c49c512bbadeda09e8eff6a4e1472014b10367b80bd"}) SET c += {`id`:"241b765c44da28f65fea7c49c512bbadeda09e8eff6a4e1472014b10367b80bd",`source_id`:"type1",`text`:"The first symptoms of type 1 diabetes can be symptoms of DKA , especially in children. Symptoms of DKA include feeling very tired having trouble breathing having fruity-smelling breath fainting from dehydration having pain in your abdomen , nausea , or vomiting",`section`:"What are the symptoms of type 1 diabetes?",`section_context`:"What are the symptoms of type 1 diabetes?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"2508850ccd30364abac96745aa2bbb94f679d2582a5f15e5536b0065312d0273"}) SET c += {`id`:"2508850ccd30364abac96745aa2bbb94f679d2582a5f15e5536b0065312d0273",`source_id`:"eye",`text`:"Diabetes affects your eyes when your blood glucose, also called blood sugar, is too high.",`section`:"How does diabetes affect my eyes?",`section_context`:"How does diabetes affect my eyes?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"2592b0554ceb7d4406a85041cc5b8911426d432b7a7e62751d0af58fb9859619"}) SET c += {`id`:"2592b0554ceb7d4406a85041cc5b8911426d432b7a7e62751d0af58fb9859619",`source_id`:"prediabetes",`text`:"The levels of fat in your blood may also go up when you have insulin resistance or prediabetes. Health care professionals may recommend tests for cholesterol and triglyceride levels.",`section`:"Blood tests",`section_context`:"How do health care professionals diagnose insulin resistance and prediabetes? / Blood tests",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type2"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`title`:"Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9"} MERGE (c:DiabetesEvidence {id:"26413f7f0e1ec81b9d1bafeb590dc27dcf266d55210e6646617a9c672d8d3fa2"}) SET c += {`id`:"26413f7f0e1ec81b9d1bafeb590dc27dcf266d55210e6646617a9c672d8d3fa2",`source_id`:"type2",`text`:"Get at least 30 minutes of physical activity, such as walking, at least 5 days a week. If you have not been active, talk with your health care professional about which activities are best. Start slowly and build up to your goal. Eat healthy foods. Eat smaller portions to reduce the amount of calories you eat each day and help you lose weight. Choosing foods with less fat is another way to reduce calories. Drink water instead of sweetened beverages.",`section`:"How can I lower my chances of developing type 2 diabetes?",`section_context`:"How can I lower my chances of developing type 2 diabetes?",`title`:"Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:56.897529+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9",`topics`:["diabetes","type2","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type2","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"29381d4867d797c751e1a83381a83c35c6dd935a9c20fafc2ab5fbf210438137"}) SET c += {`id`:"29381d4867d797c751e1a83381a83c35c6dd935a9c20fafc2ab5fbf210438137",`source_id`:"prediabetes",`text`:"The FPG test shows your blood glucose level at the time of the test. The A1C test shows your average blood glucose level over the past 3 months. In people with certain health conditions, the A1C test may miss prediabetes.",`section`:"Blood tests",`section_context`:"How do health care professionals diagnose insulin resistance and prediabetes? / Blood tests",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"2b28771620860468d713da17403d42e10150ca6d89b2038618e298c99f57786e"}) SET c += {`id`:"2b28771620860468d713da17403d42e10150ca6d89b2038618e298c99f57786e",`source_id`:"type1",`text`:"If you’re pregnant and have diabetes , changes to your hormones may affect how your body uses insulin. Ask your health care professional if you should adjust your medicines during pregnancy to prevent health problems for you and your baby.",`section`:"Other health problems",`section_context`:"What health problems can people with type 1 diabetes develop? / Other health problems",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"2ba655a96d8d202b3475b90b404cb67b4f4582fe18b94cc6777cc7441848b834"}) SET c += {`id`:"2ba655a96d8d202b3475b90b404cb67b4f4582fe18b94cc6777cc7441848b834",`source_id`:"type1",`text`:"Symptoms of type 1 diabetes usually develop quickly, over a few days or weeks. Children with type 1 diabetes typically develop symptoms over a short period of time. Common symptoms in children include",`section`:"What are the symptoms of type 1 diabetes?",`section_context`:"What are the symptoms of type 1 diabetes?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type2"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`title`:"Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9"} MERGE (c:DiabetesEvidence {id:"2bbf3d1a0f1aa3861c8e2989ee6bb7149d5defaee17d22280e2504a30d94bc7f"}) SET c += {`id`:"2bbf3d1a0f1aa3861c8e2989ee6bb7149d5defaee17d22280e2504a30d94bc7f",`source_id`:"type2",`text`:"You can take steps to lower your chances of developing these diabetes-related health problems .",`section`:"What health problems can people with diabetes develop?",`section_context`:"What health problems can people with diabetes develop?",`title`:"Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:56.897529+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9",`topics`:["diabetes","type2","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type2","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"2c2b47f5a25699579b45e801e4fd197ffbf48233bdef68b23c9d5c94d874171a"}) SET c += {`id`:"2c2b47f5a25699579b45e801e4fd197ffbf48233bdef68b23c9d5c94d874171a",`source_id`:"living",`text`:"Online tools such as the Body Weight Planner may help you create eating and physical activity plans. You may want to talk with your health care professional about other options for managing your weight, including joining a weight-loss program that can provide helpful information, support, and behavioral or lifestyle counseling. These options may have a cost, so make sure to check the details of the programs.",`section`:"What can I do to reach or maintain a healthy weight?",`section_context`:"What can I do to reach or maintain a healthy weight?",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"2c545fc9b16dc772ea6e338e87277dcd972d59aef9ae7c329efb4c3bb5b3a431"}) SET c += {`id`:"2c545fc9b16dc772ea6e338e87277dcd972d59aef9ae7c329efb4c3bb5b3a431",`source_id`:"management",`text`:"High blood pressure can damage your heart, kidneys, brain, and eyes. Some people with diabetes have a blood pressure goal below 130/80 mm Hg. 2,3 If you have heart disease or are at high risk for diabetes health problems, your goal may be lower. Ask your health care team what your goal should be.",`section`:"B is for blood pressure",`section_context`:"What are the diabetes ABCs? / B is for blood pressure",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"2c60199a9e1bf75e12c5fdd831103a0adbfc3200a516db238ebbf194aa3de3c1"}) SET c += {`id`:"2c60199a9e1bf75e12c5fdd831103a0adbfc3200a516db238ebbf194aa3de3c1",`source_id`:"type1",`text`:"CGMs use sensors placed under your skin that estimate your blood glucose level. You can see information about your blood glucose level at any time in a software program stored on a smartphone, on an insulin pump, or on a separate device called a receiver. These results may help you and your health care team make changes to your meal plan, physical activity level, or diabetes medicines. Many CGM systems have alarms and warnings that let you know if your blood glucose level is too low or too high.",`section`:"Diabetes devices and technology",`section_context`:"How can I manage type 1 diabetes? / Diabetes devices and technology",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"2ca333c7aa27d605e6356fd85fa494468fe0ddee585b055efed86730b59040c9"}) SET c += {`id`:"2ca333c7aa27d605e6356fd85fa494468fe0ddee585b055efed86730b59040c9",`source_id`:"prediabetes",`text`:"Making these changes can be hard. You may want to start with small changes. You can also ask for help from family, friends, and health care professionals.",`section`:"Healthy living",`section_context`:"How can I prevent or reverse insulin resistance and prediabetes? / Healthy living",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"2e45f4d5f76d4692af3dbb6939d211659ee3f12f18a204dbb2ca39ba1808d915"}) SET c += {`id`:"2e45f4d5f76d4692af3dbb6939d211659ee3f12f18a204dbb2ca39ba1808d915",`source_id`:"eye",`text`:"Diabetes that occurs only during pregnancy, called gestational diabetes , does not usually cause eye problems. Researchers aren't sure why this is the case.",`section`:"Who is more likely to develop diabetic eye disease?",`section_context`:"Who is more likely to develop diabetic eye disease?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"2e550fd1ddc5d7ad9f22dac3e99bed1cfc67ef2b7ce3fe63e4d1a2584046be87"}) SET c += {`id`:"2e550fd1ddc5d7ad9f22dac3e99bed1cfc67ef2b7ce3fe63e4d1a2584046be87",`source_id`:"eye",`text`:"In a surgery center or hospital visit, your doctor can remove the cloudy lens in your eye, where the cataract has grown, and replace it with an artificial lens. People who have cataract surgery generally have better vision afterward. After your eye heals, you may need a new prescription for your glasses. Your vision following cataract surgery may also depend on treating any damage from diabetic retinopathy or macular edema.",`section`:"Cataract Lens Surgery",`section_context`:"How do doctors treat diabetic eye disease? / Cataract Lens Surgery",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"gestational"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/gestational",`title`:"Gestational Diabetes",`publisher`:"NIDDK",`version`:"1841d78cf7d6313e8d45385c1bbec6ee62a83095a5dfc71de54228f8f11e02de"} MERGE (c:DiabetesEvidence {id:"308d2c48a52a13b123032f1e37efb122d06417d19809b672c1f7ee244e25046c"}) SET c += {`id`:"308d2c48a52a13b123032f1e37efb122d06417d19809b672c1f7ee244e25046c",`source_id`:"gestational",`text`:"If you had gestational diabetes, you are more likely to develop type 2 diabetes. Your child is more likely to have obesity or develop type 2 diabetes. You may be able to lower your and your child’s chances of developing these problems by reaching a healthy weight, making healthy food choices, and being physically active.",`section`:"After Your Baby is Born",`section_context`:"After Your Baby is Born",`title`:"Gestational Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/gestational",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:58.409138+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"1841d78cf7d6313e8d45385c1bbec6ee62a83095a5dfc71de54228f8f11e02de",`topics`:["diabetes","gestational"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","gestational"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"gestational"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/gestational",`title`:"Gestational Diabetes",`publisher`:"NIDDK",`version`:"1841d78cf7d6313e8d45385c1bbec6ee62a83095a5dfc71de54228f8f11e02de"} MERGE (c:DiabetesEvidence {id:"31287894e2e89fc1bee775a9c41b26e0461c7c4db5894ace90308adf6f489696"}) SET c += {`id`:"31287894e2e89fc1bee775a9c41b26e0461c7c4db5894ace90308adf6f489696",`source_id`:"gestational",`text`:"Your doctor will test you for gestational diabetes between 24 and 28 weeks of pregnancy. Tests include the glucose challenge test and the oral glucose tolerance test (OGTT). If the results of the glucose challenge test show high blood glucose, you will return for an OGTT test to confirm the diagnosis of gestational diabetes.",`section`:"Tests & Diagnosis",`section_context`:"Tests & Diagnosis",`title`:"Gestational Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/gestational",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:58.409138+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"1841d78cf7d6313e8d45385c1bbec6ee62a83095a5dfc71de54228f8f11e02de",`topics`:["diabetes","gestational"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","gestational"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"312915a7c400bb79d1e07323ff3e8d94513f254dca41dc1895cb5cb915049259"}) SET c += {`id`:"312915a7c400bb79d1e07323ff3e8d94513f254dca41dc1895cb5cb915049259",`source_id`:"living",`text`:"The physical activities you do may need to be different if you are age 65 or older , are pregnant , or have a disability or health condition . Physical activities may also need to be different for children and teens . Ask your health care professional or health care team about activities that are safe for you.",`section`:"Do different types of physical activity",`section_context`:"How can physical activity help manage my diabetes? / Do different types of physical activity",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"314472cd60ef145172b473d5915ece9620bff7228f97fec469d638978ae9fa21"}) SET c += {`id`:"314472cd60ef145172b473d5915ece9620bff7228f97fec469d638978ae9fa21",`source_id`:"foot",`text`:"Look for problems such as cuts, sores, or red spots swelling or fluid-filled blisters ingrown toenails, in which the edge of your nail grows into your skin corns or calluses, which are spots of rough skin caused by too much rubbing or pressure on the same spot plantar warts, which are flesh-colored growths on the bottom of the feet athlete’s foot warm spots",`section`:"Check your feet every day",`section_context`:"What can I do to keep my feet healthy? / Check your feet every day",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"31a285996bd56c6c99279c5d340ee4ade354a6c3001e91d2eca939221420c757"}) SET c += {`id`:"31a285996bd56c6c99279c5d340ee4ade354a6c3001e91d2eca939221420c757",`source_id`:"management",`text`:"If you are overweight or have obesity, ask your health care team how you can manage your weight . To lose weight, you may need to consume fewer calories or get more physical activity. Your health care team may also recommend medicines or surgery to help manage your weight.",`section`:"Reach and maintain a healthy weight",`section_context`:"How can a healthy lifestyle help manage my diabetes? / Reach and maintain a healthy weight",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"risk"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`title`:"Risk Factors for Type 2 Diabetes",`publisher`:"NIDDK",`version`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114"} MERGE (c:DiabetesEvidence {id:"3212773ef59ba66f4da0ee463c78d5c08a4d5dd7615f6664624e5c2cb7ae7256"}) SET c += {`id`:"3212773ef59ba66f4da0ee463c78d5c08a4d5dd7615f6664624e5c2cb7ae7256",`source_id`:"risk",`text`:"If you are age 20 or older, use the BMI calculator for adults to learn your body mass index.",`section`:"Body mass index",`section_context`:"Does your weight put you at risk for type 2 diabetes? / Body mass index",`title`:"Risk Factors for Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:48.116337+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114",`topics`:["diabetes","risk"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","risk"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"322f9b07a4ddf0eee06b2dcd1c27f24dbd4e91c7b1175dc15be7e749a950d6d9"}) SET c += {`id`:"322f9b07a4ddf0eee06b2dcd1c27f24dbd4e91c7b1175dc15be7e749a950d6d9",`source_id`:"type1",`text`:"If you take insulin, you need to check your blood glucose level regularly. You should match your insulin dose with your food, physical activity, and current blood glucose level. If you don’t, your blood glucose level may drop too low, which is called hypoglycemia. Hypoglycemia is a medical emergency that needs to be treated right away.",`section`:"Insulin and other diabetes medicines",`section_context`:"How can I manage type 1 diabetes? / Insulin and other diabetes medicines",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"definition"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`title`:"What Is Diabetes?",`publisher`:"NIDDK",`version`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1"} MERGE (c:DiabetesEvidence {id:"328276eadaa6b8c4f8d8d28706d2fe93e492beae46239a9569b02b76699d5e01"}) SET c += {`id`:"328276eadaa6b8c4f8d8d28706d2fe93e492beae46239a9569b02b76699d5e01",`source_id`:"definition",`text`:"If you have type 1 diabetes , your body makes little or no insulin. Your immune system attacks and destroys the cells in your pancreas that make insulin. Type 1 diabetes is usually diagnosed in children and young adults, although it can appear at any age. People with type 1 diabetes need to take insulin every day to stay alive.",`section`:"Type 1 diabetes",`section_context`:"What are the different types of diabetes? / Type 1 diabetes",`title`:"What Is Diabetes?",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.530017+00:00",`last_reviewed`:"Last Reviewed April 2023",`source_sha256`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1",`topics`:["diabetes","types"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","types"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"32eaf60dec37c75beb52ab58fd7cd62c6a1ac7a1c3332b31220dae9ce10db5de"}) SET c += {`id`:"32eaf60dec37c75beb52ab58fd7cd62c6a1ac7a1c3332b31220dae9ce10db5de",`source_id`:"foot",`text`:"Ask your health care team to show you how to care for your feet.",`section`:"Get a foot check at every health care visit",`section_context`:"What can I do to keep my feet healthy? / Get a foot check at every health care visit",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"32f6af195cca172116462b0cdaa613985c858cee3f35fb9175fecdf2e8424750"}) SET c += {`id`:"32f6af195cca172116462b0cdaa613985c858cee3f35fb9175fecdf2e8424750",`source_id`:"prediabetes",`text`:"The DPP study showed that metformin could also delay type 2 diabetes. Metformin worked best for women with a history of gestational diabetes, younger adults, and people with obesity. Ask your health care professional if metformin might be right for you.",`section`:"Medicines for insulin resistance and prediabetes",`section_context`:"How can I prevent or reverse insulin resistance and prediabetes? / Medicines for insulin resistance and prediabetes",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"331539435428a83b8bc6c764eed97f5488db6e509aff71d736f5f5d69d8b7da5"}) SET c += {`id`:"331539435428a83b8bc6c764eed97f5488db6e509aff71d736f5f5d69d8b7da5",`source_id`:"living",`text`:"Aerobic activities make you breathe harder and make your heart beat faster. You can try walking, dancing, wheelchair rolling, or swimming. Most adults should try to get at least 150 minutes of moderate-intensity physical activity each week. Aim to do 30 minutes a day on most days of the week. You don’t have to do all 30 minutes at one time. You can break up physical activity into small amounts during your day and still get the benefit. 1",`section`:"Do different types of physical activity",`section_context`:"How can physical activity help manage my diabetes? / Do different types of physical activity",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"33bae601b8d780b817ba42872128cdbab264bb04e3d00711eb508da2c66792a2"}) SET c += {`id`:"33bae601b8d780b817ba42872128cdbab264bb04e3d00711eb508da2c66792a2",`source_id`:"tests",`text`:"Type 1 diabetes can run in families. A study called TrialNet offers free testing to relatives of people with type 1 diabetes, even if the relatives don’t have symptoms.",`section`:"Type 1 diabetes",`section_context`:"Who should be tested for diabetes? / Type 1 diabetes",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"3513848e2d8bc8d7a2536cf0321ccba3254dbffa07ab93eabb914d5cdc974816"}) SET c += {`id`:"3513848e2d8bc8d7a2536cf0321ccba3254dbffa07ab93eabb914d5cdc974816",`source_id`:"eye",`text`:"Your doctor will also test your vision measure the pressure in your eyes",`section`:"How do doctors diagnose eye problems from diabetes?",`section_context`:"How do doctors diagnose eye problems from diabetes?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type2"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`title`:"Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9"} MERGE (c:DiabetesEvidence {id:"35412d4a2f04c8124ea2348d0e41ccc805246aa21127e4311356f93cbbfa17c0"}) SET c += {`id`:"35412d4a2f04c8124ea2348d0e41ccc805246aa21127e4311356f93cbbfa17c0",`source_id`:"type2",`text`:"Symptoms of diabetes include increased thirst and urination increased hunger feeling tired blurred vision numbness or tingling in the feet or hands sores that do not heal unexplained weight loss",`section`:"What are the symptoms of diabetes?",`section_context`:"What are the symptoms of diabetes?",`title`:"Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:56.897529+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9",`topics`:["diabetes","type2","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type2","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type2"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`title`:"Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9"} MERGE (c:DiabetesEvidence {id:"35ca04d4991e8329b181ce4271164f1344c9c9b0a089125068d917b01835345a"}) SET c += {`id`:"35ca04d4991e8329b181ce4271164f1344c9c9b0a089125068d917b01835345a",`source_id`:"type2",`text`:"Along with following your diabetes care plan, you may need diabetes medicines, which may include pills or medicines you inject under your skin, such as insulin. Over time, you may need more than one diabetes medicine to manage your blood glucose. Even if you don’t take insulin, you may need it at special times, such as during pregnancy or if you are in the hospital. You also may need medicines for high blood pressure, high cholesterol, or other conditions.",`section`:"What medicines do I need to treat my type 2 diabetes?",`section_context`:"What medicines do I need to treat my type 2 diabetes?",`title`:"Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:56.897529+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9",`topics`:["diabetes","type2","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type2","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"36247e227c366d4eb9b4d63cabc32640a65f07d0e2d67e46cf5d9c5b4aa61569"}) SET c += {`id`:"36247e227c366d4eb9b4d63cabc32640a65f07d0e2d67e46cf5d9c5b4aa61569",`source_id`:"type1",`text`:"Most people with type 1 diabetes need to take insulin every day to manage their blood glucose level and stay alive. You may be able to prevent or delay health problems that can result from type 1 diabetes by learning to manage your blood glucose level, consuming healthy foods and drinks, and getting regular physical activity.",`section`:"What is type 1 diabetes?",`section_context`:"What is type 1 diabetes?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"36a6875602d9e19949975ed5b99187db578c2986caf3f25f61af3df1aeeb026a"}) SET c += {`id`:"36a6875602d9e19949975ed5b99187db578c2986caf3f25f61af3df1aeeb026a",`source_id`:"living",`text`:"Talk with your health care professional before starting a new physical activity or changing how much physical activity you do. They may suggest types of activities based on your ability, schedule, meal plan, interests, and diabetes medicines. Your health care professional may also tell you the best times of day to be active or what to do if your blood glucose level goes out of the range recommended for you.",`section`:"How can physical activity help manage my diabetes?",`section_context`:"How can physical activity help manage my diabetes?",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"36f9e8e9b153812bfbc6c1bb881135e5f7bb38731c123732fa3c3d8b914cb5a7"}) SET c += {`id`:"36f9e8e9b153812bfbc6c1bb881135e5f7bb38731c123732fa3c3d8b914cb5a7",`source_id`:"tests",`text`:"Your doctor can diagnose diabetes , prediabetes , and gestational diabetes using blood tests. The blood tests show if your blood glucose level , also called blood sugar, is higher than the range that is healthy for you. Blood tests can also help identify the type of diabetes you have.",`section`:"Diabetes Tests & Diagnosis",`section_context`:"Diabetes Tests & Diagnosis",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"3732c98a3fae92e624280230a13948a4c054374c401bfdc4b3ec7b27bd3391bc"}) SET c += {`id`:"3732c98a3fae92e624280230a13948a4c054374c401bfdc4b3ec7b27bd3391bc",`source_id`:"type1",`text`:"A problem with the body’s immune system causes type 1 diabetes. Your immune system normally fights infections. Type 1 diabetes develops when the body’s immune system destroys the cells in the pancreas that make insulin. When the immune system attacks healthy cells in your body, it’s called autoimmunity. Type 1 diabetes is an autoimmune disease.",`section`:"What is type 1 diabetes?",`section_context`:"What is type 1 diabetes?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"374f3d7cbfd8e974d1f3eb9862d4c4512659ed25cf219afd0c37d1583faf8d7f"}) SET c += {`id`:"374f3d7cbfd8e974d1f3eb9862d4c4512659ed25cf219afd0c37d1583faf8d7f",`source_id`:"living",`text`:"Try to plan meals and snacks that have fewer foods high in saturated fat foods high in sodium, a mineral found in salt sugary foods , such as cookies and cakes, and sweet drinks, such as soda, juice, flavored coffee, and sports drinks",`section`:"Choose healthy foods and drinks",`section_context`:"How can I plan what to eat or drink when I have diabetes? / Choose healthy foods and drinks",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"risk"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`title`:"Risk Factors for Type 2 Diabetes",`publisher`:"NIDDK",`version`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114"} MERGE (c:DiabetesEvidence {id:"379b308e81021c9d4ef9e3252ed6bcef5579864fd613c444863d703c40beb213"}) SET c += {`id`:"379b308e81021c9d4ef9e3252ed6bcef5579864fd613c444863d703c40beb213",`source_id`:"risk",`text`:"have prediabetes . have a history of gestational diabetes , a type of diabetes that develops during pregnancy, or gave birth to a baby weighing 9 pounds or more.",`section`:"What are the risk factors for type 2 diabetes?",`section_context`:"What are the risk factors for type 2 diabetes?",`title`:"Risk Factors for Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:48.116337+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114",`topics`:["diabetes","risk"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","risk"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"37cd5001dab2f774bb48f91f3eb3eca3e6ec94cef6adc4c03514f9a0b34d52bd"}) SET c += {`id`:"37cd5001dab2f774bb48f91f3eb3eca3e6ec94cef6adc4c03514f9a0b34d52bd",`source_id`:"eye",`text`:"Diabetic eye disease is a group of eye problems that can affect people with diabetes. These conditions include diabetic retinopathy, diabetic macular edema, cataracts, and glaucoma.",`section`:"What is diabetic eye disease?",`section_context`:"What is diabetic eye disease?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"37e730baebb375c789a7736c57c7c75f75441e0be75d55f2bc3e541f1f779e3e"}) SET c += {`id`:"37e730baebb375c789a7736c57c7c75f75441e0be75d55f2bc3e541f1f779e3e",`source_id`:"foot",`text`:"Check the inside of your shoes before putting them on, to make sure the lining is smooth and free of pebbles or other objects.",`section`:"Wear shoes and socks at all times",`section_context`:"What can I do to keep my feet healthy? / Wear shoes and socks at all times",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"38fce5879ed34e722c5db16a2297e31ebfaa2c292f516ce455f2e0d3a831f540"}) SET c += {`id`:"38fce5879ed34e722c5db16a2297e31ebfaa2c292f516ce455f2e0d3a831f540",`source_id`:"type1",`text`:"Feeling thirsty is a common symptom of type 1 diabetes in children.",`section`:"What are the symptoms of type 1 diabetes?",`section_context`:"What are the symptoms of type 1 diabetes?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"3b345f958282e48f3a83e98bc799e4846af17218d64b700f9db93f8ea5af681c"}) SET c += {`id`:"3b345f958282e48f3a83e98bc799e4846af17218d64b700f9db93f8ea5af681c",`source_id`:"prediabetes",`text`:"You can’t change some of these risk factors, such as your age, your family history, or your race. However, you may be able to change some risk factors by reaching and maintaining a healthy weight, being physically active, and stopping smoking.",`section`:"Who is more likely to develop insulin resistance or prediabetes?",`section_context`:"Who is more likely to develop insulin resistance or prediabetes?",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"3b359e8683773e9b4eb287de497945047202e1beb60ba80e89d8f6b763d66e08"}) SET c += {`id`:"3b359e8683773e9b4eb287de497945047202e1beb60ba80e89d8f6b763d66e08",`source_id`:"management",`text`:"Your blood glucose goals may be different if you are an adult over age 65 and have had diabetes for a long time. Your blood glucose goals may also be different if you have other health problems, like heart disease, or if your blood glucose often gets too low.",`section`:"Recommended targets for blood glucose levels",`section_context`:"How can I check my blood glucose level at home? / Recommended targets for blood glucose levels",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"3c3ab05a615d5d557093f941f7906f8d15903fcd2c708d06edb6480448f69180"}) SET c += {`id`:"3c3ab05a615d5d557093f941f7906f8d15903fcd2c708d06edb6480448f69180",`source_id`:"tests",`text`:"The table below helps you understand what your test results mean if you are not pregnant. 1 If you are pregnant, some tests use different cutoffs. Ask your doctor what your test results mean.",`section`:"What test results tell me if I have diabetes or prediabetes?",`section_context`:"What test results tell me if I have diabetes or prediabetes?",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"3d5e06a419c5c9852b184cc382ca3cf54cb7ad2ce8f78fd11770de0fed4b18d3"}) SET c += {`id`:"3d5e06a419c5c9852b184cc382ca3cf54cb7ad2ce8f78fd11770de0fed4b18d3",`source_id`:"symptoms",`text`:"Cystic fibrosis is a genetic disease that leads to swelling and scarring in the pancreas. This scarring can prevent the pancreas from making enough insulin.",`section`:"Diseases caused by changes in your genes",`section_context`:"What else can cause diabetes? / Diseases caused by changes in your genes",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"3d8431e69d1b2d58677dad4f2509e17a6791b3e9261a7531db9e88c0edff58a4"}) SET c += {`id`:"3d8431e69d1b2d58677dad4f2509e17a6791b3e9261a7531db9e88c0edff58a4",`source_id`:"prediabetes",`text`:"Certain factors can increase your chances of developing insulin resistance or prediabetes, including 2",`section`:"Who is more likely to develop insulin resistance or prediabetes?",`section_context`:"Who is more likely to develop insulin resistance or prediabetes?",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"gestational"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/gestational",`title`:"Gestational Diabetes",`publisher`:"NIDDK",`version`:"1841d78cf7d6313e8d45385c1bbec6ee62a83095a5dfc71de54228f8f11e02de"} MERGE (c:DiabetesEvidence {id:"3e1eafece44a4b5a67183a75a82139c121852d6494da4b254fdd9e2266f379e8"}) SET c += {`id`:"3e1eafece44a4b5a67183a75a82139c121852d6494da4b254fdd9e2266f379e8",`source_id`:"gestational",`text`:"Managing gestational diabetes includes following a healthy eating plan and being physically active. If your eating plan and physical activity aren’t enough to keep your blood glucose in your target range, you may need insulin.",`section`:"Management & Treatment",`section_context`:"Management & Treatment",`title`:"Gestational Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/gestational",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:58.409138+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"1841d78cf7d6313e8d45385c1bbec6ee62a83095a5dfc71de54228f8f11e02de",`topics`:["diabetes","gestational"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","gestational"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"3e780703e44e54485a25bd3e70c6ed453eaa372eeafa098255fe2d99d49cbaf3"}) SET c += {`id`:"3e780703e44e54485a25bd3e70c6ed453eaa372eeafa098255fe2d99d49cbaf3",`source_id`:"symptoms",`text`:"Hemochromatosis is a genetic condition that causes your body and organs to build up harmful levels of iron . If the disease is not treated, high levels of iron may damage your pancreas and other organs.",`section`:"Diseases caused by changes in your genes",`section_context`:"What else can cause diabetes? / Diseases caused by changes in your genes",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"3e91903eef763e842757778bb400faeacf2baade129a6f8f5740a50de3ce5f78"}) SET c += {`id`:"3e91903eef763e842757778bb400faeacf2baade129a6f8f5740a50de3ce5f78",`source_id`:"symptoms",`text`:"Symptoms of type 2 diabetes can develop slowly, over several years. Many people with type 2 diabetes have no symptoms, or symptoms can be so mild that people might not even notice them. In addition to the common symptoms of diabetes listed above, people may find out they have type 2 diabetes when they develop symptoms of other health problems from diabetes . These include",`section`:"Type 2 diabetes symptoms",`section_context`:"What are the symptoms of diabetes? / Type 2 diabetes symptoms",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"3f152027cc92eec4522cbb3bd40235753706951360b4985cbfdb56bc56177472"}) SET c += {`id`:"3f152027cc92eec4522cbb3bd40235753706951360b4985cbfdb56bc56177472",`source_id`:"type1",`text`:"Researchers have found that artificial pancreas systems may control blood glucose levels better than other methods in adults and children as young as age 2 years. This is especially true at night, when managing blood glucose levels can be hard for many people with type 1 diabetes.",`section`:"Diabetes devices and technology",`section_context`:"How can I manage type 1 diabetes? / Diabetes devices and technology",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"3f81b69329d59ea6160e17eaf8b54e37e854cdefd9decad47a3a26d6535661ac"}) SET c += {`id`:"3f81b69329d59ea6160e17eaf8b54e37e854cdefd9decad47a3a26d6535661ac",`source_id`:"symptoms",`text`:"You may be able to prevent type 2 diabetes by maintaining a healthy weight and being physically active.",`section`:"What causes type 2 diabetes?",`section_context`:"What causes type 2 diabetes?",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"3fc0d3ad3a5912ce60d0d713d368d2fd19e7046ea63f565ced9073e07b286185"}) SET c += {`id`:"3fc0d3ad3a5912ce60d0d713d368d2fd19e7046ea63f565ced9073e07b286185",`source_id`:"type1",`text`:"Through studies such as those conducted by TrialNet, researchers are working to identify more risk factors for type 1 diabetes and find new ways to delay and prevent the disease.",`section`:"Can I delay or prevent type 1 diabetes in me or in my family members who may be at risk?",`section_context`:"Can I delay or prevent type 1 diabetes in me or in my family members who may be at risk?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"3fe6f5e39ec40b18aaf87754e04e5d05de0c50e7a5ac423949703d756b1c08c4"}) SET c += {`id`:"3fe6f5e39ec40b18aaf87754e04e5d05de0c50e7a5ac423949703d756b1c08c4",`source_id`:"eye",`text`:"There are two types of laser treatment : Focal/grid laser treatment works on a small area of the retina to treat diabetic macular edema. Scatter laser treatment, also called panretinal photocoagulation (PRP), covers a larger area of the retina. This method treats the growth of abnormal blood vessels, called proliferative diabetic retinopathy.",`section`:"Laser Treatment",`section_context`:"How do doctors treat diabetic eye disease? / Laser Treatment",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"413ac2be9655035621681b6f5662f71c81502a610e90664fed4cd3799aab6a95"}) SET c += {`id`:"413ac2be9655035621681b6f5662f71c81502a610e90664fed4cd3799aab6a95",`source_id`:"type1",`text`:"If you have type 1 diabetes, managing your diabetes and having a healthy lifestyle may lower your chances of developing health problems.",`section`:"What health problems can people with type 1 diabetes develop?",`section_context`:"What health problems can people with type 1 diabetes develop?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"4189884edf56923a1d4bed7f074c08187378c47d65206e47612b2a0ace5e293d"}) SET c += {`id`:"4189884edf56923a1d4bed7f074c08187378c47d65206e47612b2a0ace5e293d",`source_id`:"type1",`text`:"People still need to take medicines called immunosuppressants to prevent the immune system from attacking and destroying the new islets or pancreas.",`section`:"Who is more likely to have type 1 diabetes?",`section_context`:"Who is more likely to have type 1 diabetes?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"41d9d79fe6d879bd5f99c42ccb5cc9080b40cf2357484764c46931a663096051"}) SET c += {`id`:"41d9d79fe6d879bd5f99c42ccb5cc9080b40cf2357484764c46931a663096051",`source_id`:"type1",`text`:"People with type 1 diabetes can develop the same diabetes health problems as people with other types of diabetes. High blood glucose levels from diabetes can damage many parts of your body, including your heart kidneys nerves eyes feet teeth",`section`:"What health problems can people with type 1 diabetes develop?",`section_context`:"What health problems can people with type 1 diabetes develop?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"420bbed9bbd18d65b214b8315b0f49b7f1e485fb3977d6e6f1c2b375520c0620"}) SET c += {`id`:"420bbed9bbd18d65b214b8315b0f49b7f1e485fb3977d6e6f1c2b375520c0620",`source_id`:"type1",`text`:"On this page: What is type 1 diabetes? How common is type 1 diabetes? Who is more likely to have type 1 diabetes? What health problems can people with type 1 diabetes develop? What are the symptoms of type 1 diabetes? What causes type 1 diabetes? How do health care professionals diagnose type 1 diabetes? How can I manage type 1 diabetes? Can I delay or prevent type 1 diabetes in me or in my family members who may be at risk? Clinical Trials for Type 1 Diabetes",`section`:"Type 1 Diabetes",`section_context`:"Type 1 Diabetes",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"425f9dc7ab71a18b80b2efd0a47a9de0e7b0b594dbb4ff6e477774f0b8f4d896"}) SET c += {`id`:"425f9dc7ab71a18b80b2efd0a47a9de0e7b0b594dbb4ff6e477774f0b8f4d896",`source_id`:"symptoms",`text`:"In this section: What are the symptoms of diabetes? What causes type 1 diabetes? What causes type 2 diabetes? What causes gestational diabetes? What else can cause diabetes? Clinical Trials for Symptoms and Causes of Diabetes",`section`:"Symptoms & Causes of Diabetes",`section_context`:"Symptoms & Causes of Diabetes",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"43942aeba0e10bd026aa23fbbbf6c248a560e4cbab019579dd24ff9761a2fce0"}) SET c += {`id`:"43942aeba0e10bd026aa23fbbbf6c248a560e4cbab019579dd24ff9761a2fce0",`source_id`:"foot",`text`:"Gangrene and foot ulcers that do not get better with treatment can lead to an amputation of your toe, foot, or part of your leg. A surgeon may perform an amputation to prevent a bad infection from spreading to the rest of your body, and to save your life. Good foot care is very important to prevent serious infections and gangrene.",`section`:"How can diabetes affect my feet?",`section_context`:"How can diabetes affect my feet?",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"4517177a58dea6f81a8a6ec07e8e0d2437b07a5c88e12835bde5028b39d0b771"}) SET c += {`id`:"4517177a58dea6f81a8a6ec07e8e0d2437b07a5c88e12835bde5028b39d0b771",`source_id`:"living",`text`:"You may worry that having diabetes means giving up foods and drinks you enjoy. The good news is you can still have your favorite foods and drinks, but you might need to have them in smaller portions or enjoy them less often.",`section`:"Plan how much to eat or drink",`section_context`:"How can I plan what to eat or drink when I have diabetes? / Plan how much to eat or drink",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"451b038f0c2ab991c75ae6735e8882cca66ecfcd7b699d6561d117b90d00cd43"}) SET c += {`id`:"451b038f0c2ab991c75ae6735e8882cca66ecfcd7b699d6561d117b90d00cd43",`source_id`:"foot",`text`:"Ask your health care team to check your feet at each visit. Take off your shoes and socks when you’re in the exam room so they will remember to check your feet. At least once a year, get a thorough foot exam, including a check of the feeling and pulses in your feet.",`section`:"Get a foot check at every health care visit",`section_context`:"What can I do to keep my feet healthy? / Get a foot check at every health care visit",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"454da00bb80080bad6949ba34279554f68b97ea81d2d2812f7280463062539bc"}) SET c += {`id`:"454da00bb80080bad6949ba34279554f68b97ea81d2d2812f7280463062539bc",`source_id`:"type1",`text`:"Ask your health care professional which diabetes devices will work for you.",`section`:"Diabetes devices and technology",`section_context`:"How can I manage type 1 diabetes? / Diabetes devices and technology",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type2"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`title`:"Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9"} MERGE (c:DiabetesEvidence {id:"45c0b146693f7203b16a7c89e7672fc701b00ebfa698ab53b272e7e94ea2495f"}) SET c += {`id`:"45c0b146693f7203b16a7c89e7672fc701b00ebfa698ab53b272e7e94ea2495f",`source_id`:"type2",`text`:"Following a good diabetes care plan can help protect against many diabetes-related health problems. However, if not managed, diabetes can lead to problems such as",`section`:"What health problems can people with diabetes develop?",`section_context`:"What health problems can people with diabetes develop?",`title`:"Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:56.897529+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9",`topics`:["diabetes","type2","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type2","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"45f53960d565d32a852577249fecb6704bba9500ffec336e91649d1be5b62843"}) SET c += {`id`:"45f53960d565d32a852577249fecb6704bba9500ffec336e91649d1be5b62843",`source_id`:"eye",`text`:"Anyone with diabetes can develop diabetic eye disease. Your risk is greater with high blood glucose that is not treated high blood pressure that is not treated",`section`:"Who is more likely to develop diabetic eye disease?",`section_context`:"Who is more likely to develop diabetic eye disease?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"4605d0a4b2c6b16f10e7add7e3489b668328199f434e132c5916fd4f02bfb14b"}) SET c += {`id`:"4605d0a4b2c6b16f10e7add7e3489b668328199f434e132c5916fd4f02bfb14b",`source_id`:"management",`text`:"If you have type 1 diabetes, your health care team may ask you to check your urine at home for substances called ketones . A large amount of ketones in your urine may mean that you need to manage your diabetes more carefully. Work with your primary health care professional—who may be a doctor, physician assistant, or nurse practitioner—to change your diabetes care plan. If high levels of ketones are left untreated, you may develop a dangerous condition called diabetic ketoacidosis .",`section`:"How can I check my blood glucose level at home?",`section_context`:"How can I check my blood glucose level at home?",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"460d08065a27593c6f7d2e2ec490d1e06767568c66580c85a70207b0a430c5ec"}) SET c += {`id`:"460d08065a27593c6f7d2e2ec490d1e06767568c66580c85a70207b0a430c5ec",`source_id`:"symptoms",`text`:"You can’t change some of these risk factors, such as your age, family history, or race. However, you may be able to change some risk factors and prevent or delay type 2 diabetes by maintaining a healthy weight, being physically active, and stopping smoking.",`section`:"What causes type 2 diabetes?",`section_context`:"What causes type 2 diabetes?",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prevention"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`title`:"Preventing Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba"} MERGE (c:DiabetesEvidence {id:"46caadacc2b3a29aa483c6147d7c1329ff40d0f27779599a05043b919800a6be"}) SET c += {`id`:"46caadacc2b3a29aa483c6147d7c1329ff40d0f27779599a05043b919800a6be",`source_id`:"prevention",`text`:"Prediabetes is when your blood glucose , also called blood sugar, levels are higher than normal, but not high enough to be called diabetes. Having prediabetes is serious because it raises your chance of developing type 2 diabetes. Many of the same factors that raise your chance of developing type 2 diabetes put you at risk for prediabetes.",`section`:"What should I do if my health care professional told me I have prediabetes?",`section_context`:"What should I do if my health care professional told me I have prediabetes?",`title`:"Preventing Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:49.393819+00:00",`last_reviewed`:"Last Reviewed November 2016",`source_sha256`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba",`topics`:["diabetes","prevention"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prevention"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prevention"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`title`:"Preventing Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba"} MERGE (c:DiabetesEvidence {id:"46ed9f41a4472040652db6fd8ea0a366b8b215dc8d813b86c7e0832612cade2e"}) SET c += {`id`:"46ed9f41a4472040652db6fd8ea0a366b8b215dc8d813b86c7e0832612cade2e",`source_id`:"prevention",`text`:"Ask your doctor if you should take the diabetes drug metformin to help prevent type 2 diabetes. 1",`section`:"If I had gestational diabetes when I was pregnant, how can I lower my chances of developing type 2 diabetes?",`section_context`:"If I had gestational diabetes when I was pregnant, how can I lower my chances of developing type 2 diabetes?",`title`:"Preventing Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:49.393819+00:00",`last_reviewed`:"Last Reviewed November 2016",`source_sha256`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba",`topics`:["diabetes","prevention"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prevention"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"47198d4bf10802b432bf8bd3c0cdae05f07ba8a4cd6f6f79d7caf2f0832197f6"}) SET c += {`id`:"47198d4bf10802b432bf8bd3c0cdae05f07ba8a4cd6f6f79d7caf2f0832197f6",`source_id`:"management",`text`:"Staying healthy when you have diabetes can be a challenge. But leading a healthy lifestyle may help keep your blood glucose, blood pressure, and cholesterol levels in the ranges recommended by your health care team.",`section`:"How can a healthy lifestyle help manage my diabetes?",`section_context`:"How can a healthy lifestyle help manage my diabetes?",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"47440278aab21bb7e96c94065f5d622f8cd810d77df657ec8574fd0e303cd543"}) SET c += {`id`:"47440278aab21bb7e96c94065f5d622f8cd810d77df657ec8574fd0e303cd543",`source_id`:"management",`text`:"If you have diabetes, it is important to take care of your health no matter what is going on in your life. Ask your health care team if you should adjust your meal plan, activity level, or medicines in special situations, such as when you are sick , fasting, at school , planning to travel , or experiencing an emergency or natural disaster .",`section`:"What special situations should I plan for?",`section_context`:"What special situations should I plan for?",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"4790d2b292f16c91da360adf5ce65abb4743426c90629f73571d68214d811144"}) SET c += {`id`:"4790d2b292f16c91da360adf5ce65abb4743426c90629f73571d68214d811144",`source_id`:"eye",`text`:"Doctors may treat advanced eye problems with medicine, laser treatments, surgery, or a combination of these options.",`section`:"How do doctors treat diabetic eye disease?",`section_context`:"How do doctors treat diabetic eye disease?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"neuropathy"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/nerve-damage-diabetic-neuropathies",`title`:"Diabetic Neuropathy",`publisher`:"NIDDK",`version`:"66214ea6f35f8b8a45f96550a4cc6c1101fa8e41650833491e65c7370e991455"} MERGE (c:DiabetesEvidence {id:"47d41d6c5c298e2b47762bbc77c5083664cda1f0ed6ba079ee0677e72592e39d"}) SET c += {`id`:"47d41d6c5c298e2b47762bbc77c5083664cda1f0ed6ba079ee0677e72592e39d",`source_id`:"neuropathy",`text`:"Diabetic neuropathy is nerve damage that is caused by diabetes. Over time, high blood glucose levels, also called blood sugar, and high levels of fats, such as triglycerides, in the blood from diabetes can damage your nerves. Symptoms depend on which type of diabetic neuropathy you have.",`section`:"What Is Diabetic Neuropathy?",`section_context`:"What Is Diabetic Neuropathy?",`title`:"Diabetic Neuropathy",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/nerve-damage-diabetic-neuropathies",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:59.657648+00:00",`last_reviewed`:"Last Reviewed February 2018",`source_sha256`:"66214ea6f35f8b8a45f96550a4cc6c1101fa8e41650833491e65c7370e991455",`topics`:["diabetes","complications","neuropathy"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","neuropathy"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"definition"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`title`:"What Is Diabetes?",`publisher`:"NIDDK",`version`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1"} MERGE (c:DiabetesEvidence {id:"48351392ddb69864eac309afbaf8c6e1beaae17228269274c3d9a245d7f9e05f"}) SET c += {`id`:"48351392ddb69864eac309afbaf8c6e1beaae17228269274c3d9a245d7f9e05f",`source_id`:"definition",`text`:"In 2019, 96 million adults—38% of U.S. adults—had prediabetes. 4",`section`:"How common are diabetes and prediabetes?",`section_context`:"How common are diabetes and prediabetes?",`title`:"What Is Diabetes?",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.530017+00:00",`last_reviewed`:"Last Reviewed April 2023",`source_sha256`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1",`topics`:["diabetes","types"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","types"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prevention"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`title`:"Preventing Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba"} MERGE (c:DiabetesEvidence {id:"48552718702702fe89150fcb24f75680e0a516495bd4ede02d621acf3ae7ea7a"}) SET c += {`id`:"48552718702702fe89150fcb24f75680e0a516495bd4ede02d621acf3ae7ea7a",`source_id`:"prevention",`text`:"Diabetes can cause serious health problems , such as heart disease, stroke, and eye and foot problems. Prediabetes also can cause health problems. The good news is that type 2 diabetes can be delayed or even prevented. The longer you have diabetes, the more likely you are to develop health problems, so delaying diabetes by even a few years will benefit your health. You can help prevent or delay type 2 diabetes by losing a modest amount of weight by following a reduced-calorie eating plan and being physically active most days of the week.",`section`:"Preventing Type 2 Diabetes",`section_context`:"Preventing Type 2 Diabetes",`title`:"Preventing Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:49.393819+00:00",`last_reviewed`:"Last Reviewed November 2016",`source_sha256`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba",`topics`:["diabetes","prevention"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prevention"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"48d467b8eb1003c0f3344de1e7d910a1640eaa6ac4748650be6739912a502801"}) SET c += {`id`:"48d467b8eb1003c0f3344de1e7d910a1640eaa6ac4748650be6739912a502801",`source_id`:"type1",`text`:"Managing your type 1 diabetes may help prevent or delay diabetes health problems.",`section`:"How can I manage type 1 diabetes?",`section_context`:"How can I manage type 1 diabetes?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"4a392791f75bbf607740bc778654eef3779ced0379793390a1907f87196dc75b"}) SET c += {`id`:"4a392791f75bbf607740bc778654eef3779ced0379793390a1907f87196dc75b",`source_id`:"tests",`text`:"Take the American Diabetes Association Diabetes Risk Test to see if you are at risk for type 2 diabetes.",`section`:"Type 2 diabetes",`section_context`:"Who should be tested for diabetes? / Type 2 diabetes",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type2"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`title`:"Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9"} MERGE (c:DiabetesEvidence {id:"4b45f7dfc62566d806bcf978fc5f2258cbda58a4cb51bcb68e563a70330ab3e4"}) SET c += {`id`:"4b45f7dfc62566d806bcf978fc5f2258cbda58a4cb51bcb68e563a70330ab3e4",`source_id`:"type2",`text`:"You can develop type 2 diabetes at any age, even during childhood. However, type 2 diabetes occurs most often in middle-aged and older people. You are more likely to develop type 2 diabetes if you are age 45 or older, have a family history of diabetes, or are overweight or have obesity . Diabetes is more common in people who are African American, Hispanic/Latino, American Indian, Asian American, or Pacific Islander.",`section`:"Who is more likely to develop type 2 diabetes?",`section_context`:"Who is more likely to develop type 2 diabetes?",`title`:"Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:56.897529+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9",`topics`:["diabetes","type2","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type2","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"4b75bf36038efb70a0e523567ce34c5e3347214a7fec5ebf5b58a1a776e10b98"}) SET c += {`id`:"4b75bf36038efb70a0e523567ce34c5e3347214a7fec5ebf5b58a1a776e10b98",`source_id`:"type1",`text`:"Diabetes devices and technology can help people with type 1 diabetes take insulin and check their blood glucose level.",`section`:"Diabetes devices and technology",`section_context`:"How can I manage type 1 diabetes? / Diabetes devices and technology",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"4c3eaec761e26da90ee2d27d78d91a442b09b3885ad86cf4ba9186d92751aa51"}) SET c += {`id`:"4c3eaec761e26da90ee2d27d78d91a442b09b3885ad86cf4ba9186d92751aa51",`source_id`:"type1",`text`:"In 2021, about 1.7 million U.S. adults ages 20 years or older—or 5.7% of adults with diagnosed diabetes—had type 1 diabetes and were taking insulin. 1 Overall, 5% to 10% of people with diabetes have type 1 diabetes. 2",`section`:"How common is type 1 diabetes?",`section_context`:"How common is type 1 diabetes?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"4c488ff6dfc4e224e1ea6b61062823f265025388324e5829b902f5e90d47a679"}) SET c += {`id`:"4c488ff6dfc4e224e1ea6b61062823f265025388324e5829b902f5e90d47a679",`source_id`:"living",`text`:"If you are not taking insulin, you may not need to count carbs when using the plate method.",`section`:"Plan how much to eat or drink",`section_context`:"How can I plan what to eat or drink when I have diabetes? / Plan how much to eat or drink",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"4d464aac677d5180797e1532efe7f0b3418a6f683a7da10346ad59427ed16e6d"}) SET c += {`id`:"4d464aac677d5180797e1532efe7f0b3418a6f683a7da10346ad59427ed16e6d",`source_id`:"type1",`text`:"Some people develop a serious condition called hypoglycemia unawareness. People with this condition don’t feel their blood glucose level dropping, so they aren’t aware they should treat low blood glucose, also called hypoglycemia .",`section`:"Hypoglycemia unawareness",`section_context`:"What health problems can people with type 1 diabetes develop? / Hypoglycemia unawareness",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"4dc9688131d9edbb5280d5bd5e0ba2057bf197eb9a496c5fdb2b650d2b4d1076"}) SET c += {`id`:"4dc9688131d9edbb5280d5bd5e0ba2057bf197eb9a496c5fdb2b650d2b4d1076",`source_id`:"symptoms",`text`:"Monogenic diabetes is a group of rare forms of diabetes caused by a variant, or change, in a single gene. Parents may pass these gene variants to their children. In some cases, a person may be the first one with the variant in the family. Most forms of monogenic diabetes reduce the amount of insulin your pancreas can make.",`section`:"Diseases caused by changes in your genes",`section_context`:"What else can cause diabetes? / Diseases caused by changes in your genes",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"definition"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`title`:"What Is Diabetes?",`publisher`:"NIDDK",`version`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1"} MERGE (c:DiabetesEvidence {id:"4dcbc407453e389b264cf6431c8712db8fd9b4a4bd18a1137f899692a413cebc"}) SET c += {`id`:"4dcbc407453e389b264cf6431c8712db8fd9b4a4bd18a1137f899692a413cebc",`source_id`:"definition",`text`:"Over time, high blood glucose can damage your heart , kidneys , feet , and eyes . If you have diabetes, you can take steps to lower your chances of developing diabetes health problems by taking steps to improve your health and learning how to manage the disease . Managing your blood glucose, blood pressure, and cholesterol levels can help prevent future health problems.",`section`:"What other health problems can people with diabetes develop?",`section_context`:"What other health problems can people with diabetes develop?",`title`:"What Is Diabetes?",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.530017+00:00",`last_reviewed`:"Last Reviewed April 2023",`source_sha256`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1",`topics`:["diabetes","types"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","types"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type2"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`title`:"Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9"} MERGE (c:DiabetesEvidence {id:"4dce54fd4a1058bea11b369859a58c5eef8763ae65595600a80b3c26f39b1b01"}) SET c += {`id`:"4dce54fd4a1058bea11b369859a58c5eef8763ae65595600a80b3c26f39b1b01",`source_id`:"type2",`text`:"Research such as the Diabetes Prevention Program , sponsored by the National Institutes of Health, has shown that you can take steps to reduce your chances of developing type 2 diabetes if you have risk factors for the disease. Here are some things you can do to lower your risk:",`section`:"How can I lower my chances of developing type 2 diabetes?",`section_context`:"How can I lower my chances of developing type 2 diabetes?",`title`:"Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:56.897529+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9",`topics`:["diabetes","type2","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type2","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"4dee443cd0c6b1b7221f9184bf8b41c5fa0cf10066a9de6ea42075ec8a2a1378"}) SET c += {`id`:"4dee443cd0c6b1b7221f9184bf8b41c5fa0cf10066a9de6ea42075ec8a2a1378",`source_id`:"prediabetes",`text`:"On this page: What are insulin resistance and prediabetes? How common is prediabetes? Who is more likely to develop insulin resistance and prediabetes? What health problems can people with insulin resistance and prediabetes develop? What are the symptoms of insulin resistance and prediabetes? What causes insulin resistance and prediabetes? How do health care professionals diagnose insulin resistance and prediabetes? How can I prevent or reverse insulin resistance and prediabetes? Clinical Trials for Insulin Resistance and Prediabetes",`section`:"Insulin Resistance & Prediabetes",`section_context`:"Insulin Resistance & Prediabetes",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type2"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`title`:"Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9"} MERGE (c:DiabetesEvidence {id:"4e392cbc9b34dded29701025b8f2f2639328919ca8c688297c84bd982be9443d"}) SET c += {`id`:"4e392cbc9b34dded29701025b8f2f2639328919ca8c688297c84bd982be9443d",`source_id`:"type2",`text`:"Managing your blood glucose, blood pressure , and cholesterol , and quitting smoking if you smoke, are important ways to manage your type 2 diabetes . Lifestyle changes that include planning healthy meals, limiting calories if you are overweight, and being physically active are also part of managing your diabetes. So is taking any prescribed medicines. Work with your health care team to create a diabetes care plan that works for you.",`section`:"How can I manage my type 2 diabetes?",`section_context`:"How can I manage my type 2 diabetes?",`title`:"Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:56.897529+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9",`topics`:["diabetes","type2","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type2","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"definition"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`title`:"What Is Diabetes?",`publisher`:"NIDDK",`version`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1"} MERGE (c:DiabetesEvidence {id:"4e6999a54a8db91706d33b38aa60c1140c127609c88f95074df14a3c3f0e6adc"}) SET c += {`id`:"4e6999a54a8db91706d33b38aa60c1140c127609c88f95074df14a3c3f0e6adc",`source_id`:"definition",`text`:"If you have type 2 diabetes , the cells in your body don’t use insulin properly. The pancreas may be making insulin but is not making enough insulin to keep your blood glucose level in the normal range. Type 2 diabetes is the most common type of diabetes. You are more likely to develop type 2 diabetes if you have risk factors , such as overweight or obesity , and a family history of the disease. You can develop type 2 diabetes at any age, even during childhood.",`section`:"Type 2 diabetes",`section_context`:"What are the different types of diabetes? / Type 2 diabetes",`title`:"What Is Diabetes?",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.530017+00:00",`last_reviewed`:"Last Reviewed April 2023",`source_sha256`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1",`topics`:["diabetes","types"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","types"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"4edc305506d91ceea3922f2db9e889fdcdf0fcbc9e93b99ae99c6a610ab84250"}) SET c += {`id`:"4edc305506d91ceea3922f2db9e889fdcdf0fcbc9e93b99ae99c6a610ab84250",`source_id`:"living",`text`:"If you have type 2 diabetes, your health care professional may recommend diabetes medicines that may help you lose weight.",`section`:"What can I do to reach or maintain a healthy weight?",`section_context`:"What can I do to reach or maintain a healthy weight?",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"4ee9ff7d8c75e6d961d4c3c6f69daa280d954c231ae91d91f2105df60235a189"}) SET c += {`id`:"4ee9ff7d8c75e6d961d4c3c6f69daa280d954c231ae91d91f2105df60235a189",`source_id`:"management",`text`:"Physical activity may help you lower blood glucose, blood pressure, and cholesterol levels. Being active may also help you get better sleep and improve your mood. Try to get at least 150 minutes of moderate-intensity physical activity, such as brisk walking, each week. If you can, try to do muscle-strengthening activities, such as wall push-ups or seated arm raises, two days a week. 4",`section`:"Get physical activity",`section_context`:"How can a healthy lifestyle help manage my diabetes? / Get physical activity",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"4f9cdece5f99c9585451d12fd23b8843f496bf82d8826976ed9e968586d53ab9"}) SET c += {`id`:"4f9cdece5f99c9585451d12fd23b8843f496bf82d8826976ed9e968586d53ab9",`source_id`:"tests",`text`:"All women who are planning to get pregnant should be tested for type 2 diabetes, especially if they have risk factors.",`section`:"Type 2 diabetes",`section_context`:"Who should be tested for diabetes? / Type 2 diabetes",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"502b05bc85a232c3c5f9532292c4c78e22b958d0c23208b0367791d950b7322f"}) SET c += {`id`:"502b05bc85a232c3c5f9532292c4c78e22b958d0c23208b0367791d950b7322f",`source_id`:"eye",`text`:"The part of your retina that you need for reading, driving, and seeing faces is called the macula . Diabetes can lead to swelling in the macula, which is called diabetic macular edema. Over time, this disease can destroy the sharp vision in this part of the eye, leading to partial vision loss or blindness. Macular edema usually develops in people who already have other signs of diabetic retinopathy.",`section`:"Diabetic macular edema",`section_context`:"How does diabetes affect my eyes? / Diabetic macular edema",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"definition"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`title`:"What Is Diabetes?",`publisher`:"NIDDK",`version`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1"} MERGE (c:DiabetesEvidence {id:"504c114c9fe924b9f816c08755abc34f3bb4f46a1ac6625250cd0a40fb3b8a95"}) SET c += {`id`:"504c114c9fe924b9f816c08755abc34f3bb4f46a1ac6625250cd0a40fb3b8a95",`source_id`:"definition",`text`:"People with prediabetes have blood glucose levels that are higher than normal but not high enough to be diagnosed with type 2 diabetes. If you have prediabetes, you have a higher risk of developing type 2 diabetes in the future. You also have a higher risk for heart disease than people with normal glucose levels.",`section`:"Prediabetes",`section_context`:"What are the different types of diabetes? / Prediabetes",`title`:"What Is Diabetes?",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.530017+00:00",`last_reviewed`:"Last Reviewed April 2023",`source_sha256`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1",`topics`:["diabetes","types"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","types"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"50c355f429ff049dbaf56ae7eb2392a001c9b227bca06d545366950280f5336c"}) SET c += {`id`:"50c355f429ff049dbaf56ae7eb2392a001c9b227bca06d545366950280f5336c",`source_id`:"symptoms",`text`:"When blood glucose levels are higher than normal but not high enough to be diagnosed as type 2 diabetes, you have a condition called prediabetes . You have type 2 diabetes when health care professionals diagnose your blood glucose level as being too high.",`section`:"What causes type 2 diabetes?",`section_context`:"What causes type 2 diabetes?",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"50d755d4ab1560aa5f92bc2b2a90c7138adf67fdc97ede3d176f20ecd64be06b"}) SET c += {`id`:"50d755d4ab1560aa5f92bc2b2a90c7138adf67fdc97ede3d176f20ecd64be06b",`source_id`:"symptoms",`text`:"If you have type 1 diabetes, your body doesn’t have enough insulin to use blood glucose—also called blood sugar—for energy. Your body will begin to use fat as a source of energy instead. This process produces substances called ketones . High levels of ketones can cause DKA, which is a medical emergency that needs to be treated right away.",`section`:"Type 1 diabetes symptoms",`section_context`:"What are the symptoms of diabetes? / Type 1 diabetes symptoms",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"5117e2733e8e66278607c8b15262c6e7e94ec3438f87837e4cb1ebe7eca07750"}) SET c += {`id`:"5117e2733e8e66278607c8b15262c6e7e94ec3438f87837e4cb1ebe7eca07750",`source_id`:"foot",`text`:"If you have nerve damage from diabetes, you may burn your feet and not know you did. Take the following steps to protect your feet from heat:",`section`:"Protect your feet from hot and cold",`section_context`:"What can I do to keep my feet healthy? / Protect your feet from hot and cold",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"524090d3fbcdb3235c4cc3fe3ec2de950cd6ba5202e5b6c86f46b14d3764a8ae"}) SET c += {`id`:"524090d3fbcdb3235c4cc3fe3ec2de950cd6ba5202e5b6c86f46b14d3764a8ae",`source_id`:"living",`text`:"Learn healthy ways to lower your stress , and ask for help from your health care team or a mental health professional. While it may be uncomfortable to talk about your feelings, finding a health care professional whom you trust and want to talk with may help you lower your feelings of stress, depression, or anxiety manage problems sleeping or remembering things see how diabetes affects your family, school, work, or financial situation",`section`:"How can I take care of my mental health?",`section_context`:"How can I take care of my mental health?",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"540b10de1443c8a8f26dec62f2ab0e010a4519d5586c58d69789dbd4aadba1fa"}) SET c += {`id`:"540b10de1443c8a8f26dec62f2ab0e010a4519d5586c58d69789dbd4aadba1fa",`source_id`:"tests",`text`:"Genetic testing can diagnose most forms of monogenic diabetes , which is caused by a change—or mutation—in a gene. Anyone can have monogenic diabetes, but it is more common in babies who develop diabetes before they are 6 months old, some teens, and some young adults.",`section`:"Genetic testing",`section_context`:"Which tests help my doctor know what kind of diabetes I have? / Genetic testing",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"541c59a7023ea6094236623fc667845ce95b24015110715549748d6b29397f0a"}) SET c += {`id`:"541c59a7023ea6094236623fc667845ce95b24015110715549748d6b29397f0a",`source_id`:"management",`text`:"Getting enough sleep may improve your mood, energy level, and blood glucose level. Most adults should aim for about 7 to 8 hours each night. 5 Children and adolescents may need more sleep.",`section`:"Get enough sleep",`section_context`:"How can a healthy lifestyle help manage my diabetes? / Get enough sleep",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"5590217a5dcd700500b36ed302a4e6568285ead043ec6e7338e3ecd81560e9d0"}) SET c += {`id`:"5590217a5dcd700500b36ed302a4e6568285ead043ec6e7338e3ecd81560e9d0",`source_id`:"symptoms",`text`:"Some endocrine diseases make the body produce too much of certain hormones. High levels of these hormones may cause insulin resistance or diabetes. Endocrine diseases that may cause insulin resistance or diabetes include",`section`:"Endocrine diseases",`section_context`:"What else can cause diabetes? / Endocrine diseases",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"5795b3b45b01937eb0591c9f4ba79b3957abee289205217fb655803268ef9b35"}) SET c += {`id`:"5795b3b45b01937eb0591c9f4ba79b3957abee289205217fb655803268ef9b35",`source_id`:"living",`text`:"The plate method helps you control portion sizes without counting and measuring. This method divides a 9-inch plate into the following three sections to help you choose the types and amounts of foods to eat for each meal.",`section`:"Plan how much to eat or drink",`section_context`:"How can I plan what to eat or drink when I have diabetes? / Plan how much to eat or drink",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"57a28705f43bfadd3c04160be07dc03b2e565857df5e64657aec652ad4f9d675"}) SET c += {`id`:"57a28705f43bfadd3c04160be07dc03b2e565857df5e64657aec652ad4f9d675",`source_id`:"living",`text`:"Having diabetes can be stressful. Talk with your health care professional or health care team if you need help.",`section`:"How can I take care of my mental health?",`section_context`:"How can I take care of my mental health?",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"57ba1cc61b9ccc975f0d641ca36639caede24612a67a66c0db5385913bfebb17"}) SET c += {`id`:"57ba1cc61b9ccc975f0d641ca36639caede24612a67a66c0db5385913bfebb17",`source_id`:"management",`text`:"Taking diabetes medicines is often part of managing diabetes. The medicines you take depend on your type of diabetes, how well medicines control your blood glucose level, and other health conditions you may have. You may also need medicines to help manage blood pressure or cholesterol levels. Other factors such as medicine costs, insurance coverage, who is providing your diabetes care, and your lifestyle can also affect what medicines you take.",`section`:"What types of medicines should I take?",`section_context`:"What types of medicines should I take?",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"risk"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`title`:"Risk Factors for Type 2 Diabetes",`publisher`:"NIDDK",`version`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114"} MERGE (c:DiabetesEvidence {id:"584b3859b4bd6d6e65b625a8b7287edff985aaffae619a502e53b7b31cac4456"}) SET c += {`id`:"584b3859b4bd6d6e65b625a8b7287edff985aaffae619a502e53b7b31cac4456",`source_id`:"risk",`text`:"Another way to estimate your risk of developing diabetes is to measure your waist circumference. Men have a higher risk of developing diabetes if their waist circumference is more than 40 inches, while women who are not pregnant have a higher risk if their waist circumference is more than 35 inches. 6,7",`section`:"Waist circumference",`section_context`:"Does your weight put you at risk for type 2 diabetes? / Waist circumference",`title`:"Risk Factors for Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:48.116337+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114",`topics`:["diabetes","risk"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","risk"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"5879444acedb59f7eb86891910a61dd099e74df36f0e2de3f856bc54a785f127"}) SET c += {`id`:"5879444acedb59f7eb86891910a61dd099e74df36f0e2de3f856bc54a785f127",`source_id`:"type1",`text`:"Type 1 diabetes occurs more commonly in children and young adults, but it can develop at any age. Having a parent or sibling with type 1 diabetes increases your chance of developing the disease. People diagnosed with type 1 diabetes have the disease for the rest of their lives. Some people with type 1 diabetes can get a pancreatic islet or pancreas transplant and make insulin again. However, these transplants don’t cure type 1 diabetes.",`section`:"Who is more likely to have type 1 diabetes?",`section_context`:"Who is more likely to have type 1 diabetes?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"587cbd3cfbc10eae9c1a1ff1fa3a4604ceac91ffeeb389a03759f8b721500995"}) SET c += {`id`:"587cbd3cfbc10eae9c1a1ff1fa3a4604ceac91ffeeb389a03759f8b721500995",`source_id`:"symptoms",`text`:"These symptoms are less common in adults with type 1 diabetes. For some adults, symptoms of type 1 diabetes may develop slowly and seem more like type 2 diabetes . Some adults who develop diabetes may need special tests to find out what type of diabetes they have. Talk with your health care professional about the type of diabetes you may have. They can help you understand its causes and treatments.",`section`:"Type 1 diabetes symptoms",`section_context`:"What are the symptoms of diabetes? / Type 1 diabetes symptoms",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"589920b79efc5325141bace61afea0c63ee0b03b8d713aac5d08ee3de568ca14"}) SET c += {`id`:"589920b79efc5325141bace61afea0c63ee0b03b8d713aac5d08ee3de568ca14",`source_id`:"symptoms",`text`:"Other causes of diabetes may include diseases caused by changes in your genes , also called gene variants endocrine diseases damage to or removal of the pancreas taking certain medicines",`section`:"What else can cause diabetes?",`section_context`:"What else can cause diabetes?",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"58b724aaa7ff40c9f67b993ad964a8ca727d5add697422c418666e0a8a1eb5e3"}) SET c += {`id`:"58b724aaa7ff40c9f67b993ad964a8ca727d5add697422c418666e0a8a1eb5e3",`source_id`:"symptoms",`text`:"Gestational diabetes occurs when your body can’t make the extra insulin that you need during pregnancy. Scientists believe that substances made in your body, called hormones, may play a role in causing this form of diabetes.",`section`:"What causes gestational diabetes?",`section_context`:"What causes gestational diabetes?",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"58e69a5736820af2ab72a1164e676492110269ea2ec9e1657c3aa78d5f5defa2"}) SET c += {`id`:"58e69a5736820af2ab72a1164e676492110269ea2ec9e1657c3aa78d5f5defa2",`source_id`:"symptoms",`text`:"Researchers don’t fully know what causes problems with insulin production and insulin resistance in type 2 diabetes. However, people are more likely to develop type 2 diabetes if they",`section`:"What causes type 2 diabetes?",`section_context`:"What causes type 2 diabetes?",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"59b3777c72796761b1d051a5c82396ee3ab14ea7cea16c62ec6b0b63cd92e616"}) SET c += {`id`:"59b3777c72796761b1d051a5c82396ee3ab14ea7cea16c62ec6b0b63cd92e616",`source_id`:"living",`text`:"Take care of your feet before, during, and after physical activity.",`section`:"Stay safe during physical activity",`section_context`:"How can physical activity help manage my diabetes? / Stay safe during physical activity",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"5af0db6231674bbd446ae03a63f91dc53772986c9fa3baec0a97e2ed932e02c2"}) SET c += {`id`:"5af0db6231674bbd446ae03a63f91dc53772986c9fa3baec0a97e2ed932e02c2",`source_id`:"eye",`text`:"Often there are no early symptoms of diabetic eye disease. You may have no pain and no change in your vision as damage begins to grow inside your eyes, particularly with diabetic retinopathy.",`section`:"What are the symptoms of diabetic eye disease?",`section_context`:"What are the symptoms of diabetic eye disease?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"5b51f5efcd7617fe37b323456adcca1436f529b6a9127d490c6e1c036b5fa385"}) SET c += {`id`:"5b51f5efcd7617fe37b323456adcca1436f529b6a9127d490c6e1c036b5fa385",`source_id`:"foot",`text`:"Foot problems are common in people with diabetes. You might be afraid you’ll lose a toe, foot, or leg to diabetes, or know someone who has, but you can lower your chances of having diabetes-related foot problems by taking care of your feet every day. Managing your blood glucose levels, also called blood sugar, can also help keep your feet healthy.",`section`:"Diabetes & Foot Problems",`section_context`:"Diabetes & Foot Problems",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"5dd1ae541557fe61c65a6a51dfc9880651251b45525e73ced34c94d00ac71697"}) SET c += {`id`:"5dd1ae541557fe61c65a6a51dfc9880651251b45525e73ced34c94d00ac71697",`source_id`:"type1",`text`:"If you have a parent or sibling with type 1 diabetes, your health care professional may suggest a test for autoantibodies, even if you don’t have any symptoms. The test may show if you have a higher risk of developing symptoms of type 1 diabetes and if you should be treated to delay the disease. Talk with your health care professional about the symptoms of diabetes and ask if they want you to get more testing in the future.",`section`:"Autoantibodies test",`section_context`:"How do health care professionals diagnose type 1 diabetes? / Autoantibodies test",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"5e7419a9016fd20d63128f7a3758d9649ffd02a8ed02a2720aa29cb3a6e57397"}) SET c += {`id`:"5e7419a9016fd20d63128f7a3758d9649ffd02a8ed02a2720aa29cb3a6e57397",`source_id`:"type1",`text`:"If you have type 1 diabetes, you need to take insulin to stay alive. Different types of insulin are available. Some types start to work quickly while others start to work more slowly. The effects of each type of insulin last for varying lengths of time. You may need to take more than one type of insulin. You can take insulin in a few ways, including",`section`:"Insulin and other diabetes medicines",`section_context`:"How can I manage type 1 diabetes? / Insulin and other diabetes medicines",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"5f5a68d227aa2f4a12a2bb5f6af31db4eb7526fbbf546abea75b9f63d6f1492e"}) SET c += {`id`:"5f5a68d227aa2f4a12a2bb5f6af31db4eb7526fbbf546abea75b9f63d6f1492e",`source_id`:"living",`text`:"Your body turns carbohydrates , or carbs, from food into glucose, which can raise your blood glucose level. Some fruits, beans, and starchy vegetables—such as potatoes and corn—have more carbs than other foods. Keep carbs in mind when planning your meals.",`section`:"Choose healthy foods and drinks",`section_context`:"How can I plan what to eat or drink when I have diabetes? / Choose healthy foods and drinks",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"611360a5b0060c2cd77dbfa4e747a75259cb2d2a70edeb5882e4dc6d7fdbf95d"}) SET c += {`id`:"611360a5b0060c2cd77dbfa4e747a75259cb2d2a70edeb5882e4dc6d7fdbf95d",`source_id`:"prediabetes",`text`:"People with prediabetes have a high chance of developing type 2 diabetes within 5 to 10 years. 3 You can take steps to prevent or reverse your prediabetes and prevent type 2 diabetes.",`section`:"How do health care professionals diagnose insulin resistance and prediabetes?",`section_context`:"How do health care professionals diagnose insulin resistance and prediabetes?",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"6159836db3fabe1c6b2894a500d6781ae4489a6b987b0a543f3e2c97ed85c507"}) SET c += {`id`:"6159836db3fabe1c6b2894a500d6781ae4489a6b987b0a543f3e2c97ed85c507",`source_id`:"type1",`text`:"An artificial pancreas is a system that mimics how a healthy pancreas controls blood glucose levels in the body. The system is made up of three parts. A CGM automatically estimates your blood glucose level and sends the information, without using wires, to a software program on your smartphone or on an insulin pump. The software program calculates how much insulin your body needs, and the insulin pump automatically delivers that amount of insulin to your body.",`section`:"Diabetes devices and technology",`section_context`:"How can I manage type 1 diabetes? / Diabetes devices and technology",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"615cc9182632004c6f2ed3ebdb7c8091567dbe8a295ef1d0d0196ae91e38c066"}) SET c += {`id`:"615cc9182632004c6f2ed3ebdb7c8091567dbe8a295ef1d0d0196ae91e38c066",`source_id`:"management",`text`:"Some people use a CGM as part of an artificial pancreas . An artificial pancreas is a system that mimics how a healthy pancreas controls blood glucose in the body. A CGM, an insulin pump, and a software program that shares information between the CGM and insulin pump make up the artificial pancreas.",`section`:"Devices to help manage diabetes",`section_context`:"How can I check my blood glucose level at home? / Devices to help manage diabetes",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"65c40d0386eea585f27cc630987c5968b123ed208aa3ae8edecca2d4861f527e"}) SET c += {`id`:"65c40d0386eea585f27cc630987c5968b123ed208aa3ae8edecca2d4861f527e",`source_id`:"eye",`text`:"The doctor will inject an anti-VEGF medicine into your eyes during office visits. You'll have several treatments during the first few months, then fewer treatments after you finish the first round of therapy. Your doctor will use medicine to numb your eyes so you don’t feel pain. The needle is about the thickness of a human hair.",`section`:"Medicine",`section_context`:"How do doctors treat diabetic eye disease? / Medicine",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"6716c2dd884a17323f21de17216fc0a3805958a80e523ddf388cfa670d5b66e4"}) SET c += {`id`:"6716c2dd884a17323f21de17216fc0a3805958a80e523ddf388cfa670d5b66e4",`source_id`:"management",`text`:"Feeling stressed, sad, or angry can be common for people with diabetes. Many people with chronic, or long-term, illnesses such as diabetes develop anxiety or other mental health conditions . Learn healthy ways to lower your stress , and ask for help from your health care team or a mental health professional.",`section`:"Take care of your mental health",`section_context`:"How can a healthy lifestyle help manage my diabetes? / Take care of your mental health",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"679b6a6ac5d07c54fe37d3337b234ae34a49b87b2e892b4755660511dd87eeb0"}) SET c += {`id`:"679b6a6ac5d07c54fe37d3337b234ae34a49b87b2e892b4755660511dd87eeb0",`source_id`:"type1",`text`:"A pancreatic islet transplant is used to treat type 1 diabetes in people who struggle to manage their blood glucose levels. Pancreatic islets are clusters of cells in the pancreas that make insulin. In type 1 diabetes, the body’s immune system attacks these cells. A pancreatic islet transplant replaces destroyed islets with new islets from a deceased donor. The new islets make and release insulin. After a pancreatic islet transplant, you’ll take immunosuppressants to prevent the immune system from attacking and destroying the new islets.",`section`:"Pancreatic islet and pancreas transplant",`section_context`:"How can I manage type 1 diabetes? / Pancreatic islet and pancreas transplant",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"681dd9774a1745f8afae51b9c40070311b9865db0ceb7586210cdf1a773db198"}) SET c += {`id`:"681dd9774a1745f8afae51b9c40070311b9865db0ceb7586210cdf1a773db198",`source_id`:"management",`text`:"Ask your health care team about the best way to check your blood glucose level and how often you should check it. Make sure to keep a record of your blood glucose self-checks, including the date and time you checked it, the results, and other information, such as what you ate or what physical activity you did that day. You can use a chart or a smartphone app to help you keep track. Take this information with you when you visit your health care team.",`section`:"Devices to help manage diabetes",`section_context`:"How can I check my blood glucose level at home? / Devices to help manage diabetes",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"684bbda4cb8f4f861720735fb55599e47e29d247288bec413733104d7e5e63d4"}) SET c += {`id`:"684bbda4cb8f4f861720735fb55599e47e29d247288bec413733104d7e5e63d4",`source_id`:"foot",`text`:"Cover a blister, cut, or sore with a bandage. Smooth corns and calluses as explained below.",`section`:"Check your feet every day",`section_context`:"What can I do to keep my feet healthy? / Check your feet every day",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"684d345c4330748e95f7ceab51ca1f2c2492cf1ad4d0b9a3e6b24ccf8321ecc2"}) SET c += {`id`:"684d345c4330748e95f7ceab51ca1f2c2492cf1ad4d0b9a3e6b24ccf8321ecc2",`source_id`:"foot",`text`:"Ask your provider to refer you to a foot doctor, or podiatrist, if needed.",`section`:"When should I see my health care provider about foot problems?",`section_context`:"When should I see my health care provider about foot problems?",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"686cda63ae4c6fcaefa3fbc978f23b5c7bb0a295e074cae7634f6df5ed7ca91f"}) SET c += {`id`:"686cda63ae4c6fcaefa3fbc978f23b5c7bb0a295e074cae7634f6df5ed7ca91f",`source_id`:"type1",`text`:"People with type 1 diabetes may also have a higher risk of other health problems, including eating disorders, such as anorexia , bulimia , and binge eating disorder other autoimmune diseases hip fractures in older adults due to osteoporosis",`section`:"Other health problems",`section_context`:"What health problems can people with type 1 diabetes develop? / Other health problems",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"definition"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`title`:"What Is Diabetes?",`publisher`:"NIDDK",`version`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1"} MERGE (c:DiabetesEvidence {id:"6899dc2785a1746b603b6d74e5fdc28885634c75f6ac8cb99c1ec52818185715"}) SET c += {`id`:"6899dc2785a1746b603b6d74e5fdc28885634c75f6ac8cb99c1ec52818185715",`source_id`:"definition",`text`:"As of 2019, 37.3 million people—or 11.3% of the U.S. population—had diabetes. 1 More than 1 in 4 people over the age of 65 had diabetes. Nearly 1 in 4 adults with diabetes didn’t know they had the disease. 2",`section`:"How common are diabetes and prediabetes?",`section_context`:"How common are diabetes and prediabetes?",`title`:"What Is Diabetes?",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.530017+00:00",`last_reviewed`:"Last Reviewed April 2023",`source_sha256`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1",`topics`:["diabetes","types"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","types"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"68df9f894dc189749ff319985f3bdbda8bf41dda7b2571f54c16e556f89f6e55"}) SET c += {`id`:"68df9f894dc189749ff319985f3bdbda8bf41dda7b2571f54c16e556f89f6e55",`source_id`:"living",`text`:"Try to do different kinds of activities . While being more active may have more health benefits, any physical activity is better than none. Start slowly with activities you enjoy. You may be able to change your level of effort and try other activities over time. Having a friend or family member join you may help you stick to your routine.",`section`:"Do different types of physical activity",`section_context`:"How can physical activity help manage my diabetes? / Do different types of physical activity",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"691c505777c19d1024a3dff06b6d18a471bf666c7147876b15e8a755bb2d4dc0"}) SET c += {`id`:"691c505777c19d1024a3dff06b6d18a471bf666c7147876b15e8a755bb2d4dc0",`source_id`:"management",`text`:"You do not get the same level of detail from blood tests—such as the A1C test—that you take at a health care professional’s office.",`section`:"How can I check my blood glucose level at home?",`section_context`:"How can I check my blood glucose level at home?",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type2"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`title`:"Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9"} MERGE (c:DiabetesEvidence {id:"696b1ec5b568f10991dabf626c378ae7d7a39ebc74edab8db1c6db2c1e255de7"}) SET c += {`id`:"696b1ec5b568f10991dabf626c378ae7d7a39ebc74edab8db1c6db2c1e255de7",`source_id`:"type2",`text`:"Most often, your best chance for preventing type 2 diabetes is to make lifestyle changes that work for you long term. Get started with Your Game Plan to Prevent Type 2 Diabetes .",`section`:"How can I lower my chances of developing type 2 diabetes?",`section_context`:"How can I lower my chances of developing type 2 diabetes?",`title`:"Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:56.897529+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9",`topics`:["diabetes","type2","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type2","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"69790b66a7160d3472112127d8071385552085cde482c7a4cd7cb39f4296a3cd"}) SET c += {`id`:"69790b66a7160d3472112127d8071385552085cde482c7a4cd7cb39f4296a3cd",`source_id`:"prediabetes",`text`:"People with insulin resistance and prediabetes usually have no symptoms. Some people with prediabetes may have symptoms that are similar to symptoms of diabetes .",`section`:"What are the symptoms of insulin resistance and prediabetes?",`section_context`:"What are the symptoms of insulin resistance and prediabetes?",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"6b6eb60ee5bf7a1539a81241e9746d9244af78b7ebbdd1949e5cb7f90013de94"}) SET c += {`id`:"6b6eb60ee5bf7a1539a81241e9746d9244af78b7ebbdd1949e5cb7f90013de94",`source_id`:"living",`text`:"Taking less insulin before physical activity may help prevent low blood glucose, but it may also make you more likely to have high blood glucose. If your body does not have enough insulin, it can’t use glucose as a source of energy and will use fat instead. When your body uses fat for energy, your body makes chemicals called ketones .",`section`:"Stay safe during physical activity",`section_context`:"How can physical activity help manage my diabetes? / Stay safe during physical activity",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"6c1628509f01a918ef2391f1f3aec9dcc13e251a5e947fd896655339a663045e"}) SET c += {`id`:"6c1628509f01a918ef2391f1f3aec9dcc13e251a5e947fd896655339a663045e",`source_id`:"foot",`text`:"Although rare, nerve damage from diabetes can lead to changes in the shape of your feet, such as Charcot’s foot . Charcot’s foot may start with redness, warmth, and swelling. Later, bones in your feet and toes can shift or break, which can cause your feet to have an odd shape, such as a “rocker bottom.”",`section`:"How can diabetes affect my feet?",`section_context`:"How can diabetes affect my feet?",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"6c508ba57f86fd0e4b9794a51e8927874c30b93a7f0c7c3b6b13b599edc7f65b"}) SET c += {`id`:"6c508ba57f86fd0e4b9794a51e8927874c30b93a7f0c7c3b6b13b599edc7f65b",`source_id`:"symptoms",`text`:"You’re more likely to develop gestational diabetes if you have certain risk factors, such as",`section`:"What causes gestational diabetes?",`section_context`:"What causes gestational diabetes?",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"6cefc63b851c8e2cda87e94bf2e0ad304e75850b1385e4534efc94f7cb3beb7f"}) SET c += {`id`:"6cefc63b851c8e2cda87e94bf2e0ad304e75850b1385e4534efc94f7cb3beb7f",`source_id`:"prediabetes",`text`:"Health care professionals can diagnose prediabetes using blood tests that measure your blood glucose level to see if it is higher than normal. Health care professionals may use 2",`section`:"Blood tests",`section_context`:"How do health care professionals diagnose insulin resistance and prediabetes? / Blood tests",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"6d5bd2d5c3fd47e3ada9339c2c94fb87d7925328c69929441e41d39af0c3ee23"}) SET c += {`id`:"6d5bd2d5c3fd47e3ada9339c2c94fb87d7925328c69929441e41d39af0c3ee23",`source_id`:"tests",`text`:"If you are pregnant, your blood will be drawn every hour for 2 to 3 hours. If your blood glucose levels are high two or more times during the OGTT, you may have gestational diabetes.",`section`:"Oral glucose tolerance test",`section_context`:"What tests are used to diagnose diabetes? / Oral glucose tolerance test",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"6d7b7b1a0c439d0fd23a0ed1c199fa3ca5a05c964ddbd0757a1169bceab0ec09"}) SET c += {`id`:"6d7b7b1a0c439d0fd23a0ed1c199fa3ca5a05c964ddbd0757a1169bceab0ec09",`source_id`:"foot",`text`:"Thick patches of skin called corns or calluses can grow on the feet. If you have corns or calluses, talk with your foot doctor about the best way to care for these foot problems. If you have nerve damage, these patches can become ulcers.",`section`:"Smooth corns and calluses gently",`section_context`:"What can I do to keep my feet healthy? / Smooth corns and calluses gently",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"6e0474ddc20c495c8d57396ac950f5967450cb51ca69b3a62046e19339851419"}) SET c += {`id`:"6e0474ddc20c495c8d57396ac950f5967450cb51ca69b3a62046e19339851419",`source_id`:"prediabetes",`text`:"People with insulin resistance and prediabetes can also develop other health problems, including high blood pressure metabolic syndrome , a group of conditions—including high blood pressure and a large waist size—that increase your risk for heart disease, diabetes, and stroke nonalcoholic fatty liver disease , or NAFLD (also referred to as metabolic dysfunction-associated steatotic liver disease, or MASLD) obesity or a large waist size type 2 diabetes unhealthy levels of cholesterol and triglycerides",`section`:"What health problems can people with insulin resistance and prediabetes develop?",`section_context`:"What health problems can people with insulin resistance and prediabetes develop?",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"6e13bb6647477e0c943d7080123944eb39fe6dc3c3dc97a7a5ab988136a928eb"}) SET c += {`id`:"6e13bb6647477e0c943d7080123944eb39fe6dc3c3dc97a7a5ab988136a928eb",`source_id`:"type1",`text`:"Type 1 diabetes is a disease that occurs when your body makes little or no insulin . Insulin is a hormone that helps blood glucose , also called blood sugar, get into the body’s cells to be used as energy. When your body doesn’t have enough insulin, glucose in your blood can’t get into the cells. As a result, your cells lack energy, your blood glucose level goes up, and you develop diabetes .",`section`:"What is type 1 diabetes?",`section_context`:"What is type 1 diabetes?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"6f55db8225e7a6d423e5d5f2af6b23071c54d61ec0a49930d45a134be2877ce8"}) SET c += {`id`:"6f55db8225e7a6d423e5d5f2af6b23071c54d61ec0a49930d45a134be2877ce8",`source_id`:"living",`text`:"Ask your health care team for mental health resources for people with diabetes.",`section`:"How can I take care of my mental health?",`section_context`:"How can I take care of my mental health?",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"70569baa40f119d8a8336f372c34544e602a08597eb4dbb9770fac7ddafdc734"}) SET c += {`id`:"70569baa40f119d8a8336f372c34544e602a08597eb4dbb9770fac7ddafdc734",`source_id`:"foot",`text`:"In this section: How can diabetes affect my feet? What can I do to keep my feet healthy? When should I see my health care provider about foot problems? Clinical Trials",`section`:"Diabetes & Foot Problems",`section_context`:"Diabetes & Foot Problems",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"risk"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`title`:"Risk Factors for Type 2 Diabetes",`publisher`:"NIDDK",`version`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114"} MERGE (c:DiabetesEvidence {id:"7119aad860fde3e94e52e122e805fc4391cc19981f1322cc1cc561b17c17a9a8"}) SET c += {`id`:"7119aad860fde3e94e52e122e805fc4391cc19981f1322cc1cc561b17c17a9a8",`source_id`:"risk",`text`:"To see if your weight may put you at risk for type 2 diabetes, learn your body mass index (BMI) and waist circumference .",`section`:"Does your weight put you at risk for type 2 diabetes?",`section_context`:"Does your weight put you at risk for type 2 diabetes?",`title`:"Risk Factors for Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:48.116337+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114",`topics`:["diabetes","risk"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","risk"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"risk"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`title`:"Risk Factors for Type 2 Diabetes",`publisher`:"NIDDK",`version`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114"} MERGE (c:DiabetesEvidence {id:"717f3f10811b87aea50a61fe6fbceb302482f221cc1c6b981334c24da7bb504c"}) SET c += {`id`:"717f3f10811b87aea50a61fe6fbceb302482f221cc1c6b981334c24da7bb504c",`source_id`:"risk",`text`:"Read about risk factors for type 2 diabetes below, and see which ones apply to you. Acting on the factors you can change may help delay or prevent type 2 diabetes .",`section`:"Risk Factors for Type 2 Diabetes",`section_context`:"Risk Factors for Type 2 Diabetes",`title`:"Risk Factors for Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:48.116337+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114",`topics`:["diabetes","risk"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","risk"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"71a5833a0297d26d96a2f5e1e1bd5eb054972547d0977612542d3d0b5288f8f2"}) SET c += {`id`:"71a5833a0297d26d96a2f5e1e1bd5eb054972547d0977612542d3d0b5288f8f2",`source_id`:"symptoms",`text`:"Changes to hormones during pregnancy can make it harder for blood glucose to enter the cells in your body. This causes insulin resistance. In most pregnancies, the pancreas can make enough insulin to overcome these changes. If the pancreas can’t make enough insulin, you’ll develop gestational diabetes.",`section`:"What causes gestational diabetes?",`section_context`:"What causes gestational diabetes?",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"risk"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`title`:"Risk Factors for Type 2 Diabetes",`publisher`:"NIDDK",`version`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114"} MERGE (c:DiabetesEvidence {id:"71a5a3262e3858fe2eaba0e8645782d006ecf50728459f72c18e4df1e823e13b"}) SET c += {`id`:"71a5a3262e3858fe2eaba0e8645782d006ecf50728459f72c18e4df1e823e13b",`source_id`:"risk",`text`:"You can develop type 2 diabetes at any age, even during childhood. You are more likely to develop type 2 diabetes if you 1",`section`:"What are the risk factors for type 2 diabetes?",`section_context`:"What are the risk factors for type 2 diabetes?",`title`:"Risk Factors for Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:48.116337+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114",`topics`:["diabetes","risk"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","risk"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"72c56bf0fef841bb3dae221b017518606b31ad3ee8e4e82a777534218a92a4ca"}) SET c += {`id`:"72c56bf0fef841bb3dae221b017518606b31ad3ee8e4e82a777534218a92a4ca",`source_id`:"eye",`text`:"If the disease gets worse, some blood vessels close off, which causes new blood vessels to grow, or proliferate, on the surface of the retina. This stage is called proliferative diabetic retinopathy. These abnormal new blood vessels can lead to serious vision problems.",`section`:"Diabetic retinopathy",`section_context`:"How does diabetes affect my eyes? / Diabetic retinopathy",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prevention"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`title`:"Preventing Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba"} MERGE (c:DiabetesEvidence {id:"72ea0584f1972aa9ca4206605c61d53f4fc5b715d6c61730521d8f66c009a694"}) SET c += {`id`:"72ea0584f1972aa9ca4206605c61d53f4fc5b715d6c61730521d8f66c009a694",`source_id`:"prevention",`text`:"If you have prediabetes, you can lower your chance of developing type 2 diabetes. Lose weight if you need to, become more physically active, and follow a reduced-calorie eating plan.",`section`:"What should I do if my health care professional told me I have prediabetes?",`section_context`:"What should I do if my health care professional told me I have prediabetes?",`title`:"Preventing Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:49.393819+00:00",`last_reviewed`:"Last Reviewed November 2016",`source_sha256`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba",`topics`:["diabetes","prevention"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prevention"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"732ca23078284748b680883c770dbfe443088b57c7f33e5bc33ebb48851bfa58"}) SET c += {`id`:"732ca23078284748b680883c770dbfe443088b57c7f33e5bc33ebb48851bfa58",`source_id`:"type1",`text`:"Some people have trouble managing their blood glucose level with just insulin. Your health care professional may recommend other medicines to take with insulin to help manage your blood glucose level.",`section`:"Insulin and other diabetes medicines",`section_context`:"How can I manage type 1 diabetes? / Insulin and other diabetes medicines",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"neuropathy"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/nerve-damage-diabetic-neuropathies",`title`:"Diabetic Neuropathy",`publisher`:"NIDDK",`version`:"66214ea6f35f8b8a45f96550a4cc6c1101fa8e41650833491e65c7370e991455"} MERGE (c:DiabetesEvidence {id:"74181c0a5578f48f5c1b0157a8a6431b72e62da4d728908369a20c5c97a53566"}) SET c += {`id`:"74181c0a5578f48f5c1b0157a8a6431b72e62da4d728908369a20c5c97a53566",`source_id`:"neuropathy",`text`:"Diabetic neuropathy is nerve damage that can occur in people with diabetes. Different types of nerve damage cause different symptoms. Symptoms can range from pain and numbness in your feet to problems with the functions of your internal organs, such as your heart and bladder.",`section`:"Diabetic Neuropathy",`section_context`:"Diabetic Neuropathy",`title`:"Diabetic Neuropathy",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/nerve-damage-diabetic-neuropathies",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:59.657648+00:00",`last_reviewed`:"Last Reviewed February 2018",`source_sha256`:"66214ea6f35f8b8a45f96550a4cc6c1101fa8e41650833491e65c7370e991455",`topics`:["diabetes","complications","neuropathy"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","neuropathy"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"neuropathy"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/nerve-damage-diabetic-neuropathies",`title`:"Diabetic Neuropathy",`publisher`:"NIDDK",`version`:"66214ea6f35f8b8a45f96550a4cc6c1101fa8e41650833491e65c7370e991455"} MERGE (c:DiabetesEvidence {id:"75593cef6ec132b77960328e4460946dcfe606e50078fabee841fd991e098465"}) SET c += {`id`:"75593cef6ec132b77960328e4460946dcfe606e50078fabee841fd991e098465",`source_id`:"neuropathy",`text`:"Proximal neuropathy is a rare and disabling type of nerve damage in your hip, buttock, or thigh. The damage typically affects one side of your body and may rarely spread to the other side. Symptoms gradually improve over a period of months or years.",`section`:"Proximal Neuropathy",`section_context`:"Proximal Neuropathy",`title`:"Diabetic Neuropathy",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/nerve-damage-diabetic-neuropathies",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:59.657648+00:00",`last_reviewed`:"Last Reviewed February 2018",`source_sha256`:"66214ea6f35f8b8a45f96550a4cc6c1101fa8e41650833491e65c7370e991455",`topics`:["diabetes","complications","neuropathy"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","neuropathy"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"75fc0cbc3044fa783c6a9bbccade8ad280bc390c786a5afceb09500af5c4d744"}) SET c += {`id`:"75fc0cbc3044fa783c6a9bbccade8ad280bc390c786a5afceb09500af5c4d744",`source_id`:"type1",`text`:"Your health care professional can diagnose diabetes by reviewing your symptoms , asking about your medical history, and using diabetes tests. Your health care professional may also have you take diabetes tests to find out if your diabetes is type 1, type 2, or another type of diabetes. Your treatment will depend on the type of diabetes you have.",`section`:"How do health care professionals diagnose type 1 diabetes?",`section_context`:"How do health care professionals diagnose type 1 diabetes?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"763748cb26e5dc69ed43c6f14b4d6df498e3f13102fae316f45ba3a15aaece6c"}) SET c += {`id`:"763748cb26e5dc69ed43c6f14b4d6df498e3f13102fae316f45ba3a15aaece6c",`source_id`:"prediabetes",`text`:"If you have risk factors for type 2 diabetes but tests show you don’t have prediabetes, you may be retested at least every 3 years. If tests show you have prediabetes, you should be tested for type 2 diabetes every year. 2",`section`:"How do health care professionals diagnose insulin resistance and prediabetes?",`section_context`:"How do health care professionals diagnose insulin resistance and prediabetes?",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"76cada068eb3f95c65af22796d1adaa026cbecefbdeefa7f15619e76da486efb"}) SET c += {`id`:"76cada068eb3f95c65af22796d1adaa026cbecefbdeefa7f15619e76da486efb",`source_id`:"prediabetes",`text`:"If you have insulin resistance or prediabetes, managing your weight can have several health benefits. Ask your health care professional or health care team if you’re at a healthy weight .",`section`:"Managing your weight",`section_context`:"How can I prevent or reverse insulin resistance and prediabetes? / Managing your weight",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type2"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`title`:"Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9"} MERGE (c:DiabetesEvidence {id:"7707b77146fa72513b2e4ef9352c36552679e95a945e2eebe58bf7b1e7fe3fea"}) SET c += {`id`:"7707b77146fa72513b2e4ef9352c36552679e95a945e2eebe58bf7b1e7fe3fea",`source_id`:"type2",`text`:"The good news is that you can take steps to prevent or delay the development of type 2 diabetes.",`section`:"What is type 2 diabetes?",`section_context`:"What is type 2 diabetes?",`title`:"Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:56.897529+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9",`topics`:["diabetes","type2","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type2","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"776b77f1e43ff3c35868d7a1696720efb67e4dffcf8d1fc352418e38b0437b77"}) SET c += {`id`:"776b77f1e43ff3c35868d7a1696720efb67e4dffcf8d1fc352418e38b0437b77",`source_id`:"prediabetes",`text`:"If your blood glucose levels keep going up, you could develop type 2 diabetes . Type 2 diabetes can affect almost every part of your body, including your heart , eyes , kidneys , and nerves .",`section`:"What are insulin resistance and prediabetes?",`section_context`:"What are insulin resistance and prediabetes?",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"78314534898a0612a4a0101a921f967bebc4553f78e2da7f3a04422ba34afd95"}) SET c += {`id`:"78314534898a0612a4a0101a921f967bebc4553f78e2da7f3a04422ba34afd95",`source_id`:"tests",`text`:"Experts recommend routine testing for type 2 diabetes if you have certain risk factors . You may have a higher risk of developing type 2 diabetes if you are age 35 or older American Indian, Black or African American, Asian American, Hispanic/Latino, or Pacific Islander overweight or have obesity and have at least one other risk factor a woman who had gestational diabetes",`section`:"Type 2 diabetes",`section_context`:"Who should be tested for diabetes? / Type 2 diabetes",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prevention"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`title`:"Preventing Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba"} MERGE (c:DiabetesEvidence {id:"7865a6468a78311ed6983bcfca68093e10991a0eb99f6b3084383656cbe35ad8"}) SET c += {`id`:"7865a6468a78311ed6983bcfca68093e10991a0eb99f6b3084383656cbe35ad8",`source_id`:"prevention",`text`:"Here are steps you should take for yourself and your child if you had gestational diabetes:",`section`:"If I had gestational diabetes when I was pregnant, how can I lower my chances of developing type 2 diabetes?",`section_context`:"If I had gestational diabetes when I was pregnant, how can I lower my chances of developing type 2 diabetes?",`title`:"Preventing Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:49.393819+00:00",`last_reviewed`:"Last Reviewed November 2016",`source_sha256`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba",`topics`:["diabetes","prevention"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prevention"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"7866437c039220384e44bf5e3aaa0b032a97a567b7dbd2b56aefe75d2ba63198"}) SET c += {`id`:"7866437c039220384e44bf5e3aaa0b032a97a567b7dbd2b56aefe75d2ba63198",`source_id`:"management",`text`:"Talk with your health care team about the blood glucose range that is healthy for you. Be sure to tell your health care team if your glucose levels frequently go above or below your target range.",`section`:"Recommended targets for blood glucose levels",`section_context`:"How can I check my blood glucose level at home? / Recommended targets for blood glucose levels",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type2"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`title`:"Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9"} MERGE (c:DiabetesEvidence {id:"79137f52b92fba30e89b5a58cacbc36544659323d98287e26e71e0e862eed935"}) SET c += {`id`:"79137f52b92fba30e89b5a58cacbc36544659323d98287e26e71e0e862eed935",`source_id`:"type2",`text`:"Type 2 diabetes is caused by several factors, including overweight and obesity not being physically active insulin resistance genes",`section`:"What causes type 2 diabetes?",`section_context`:"What causes type 2 diabetes?",`title`:"Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:56.897529+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9",`topics`:["diabetes","type2","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type2","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"79948cd79950ac876e3afa2befc94331e0b2c4dce8f41c94567ae9a0a580cf35"}) SET c += {`id`:"79948cd79950ac876e3afa2befc94331e0b2c4dce8f41c94567ae9a0a580cf35",`source_id`:"eye",`text`:"Anti-VEGF treatments can stop further vision loss and may improve vision in some people.",`section`:"Medicine",`section_context`:"How do doctors treat diabetic eye disease? / Medicine",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"79e4e9b66f551c905d6a3557245746537808c14677e0ab68421204120b8ab295"}) SET c += {`id`:"79e4e9b66f551c905d6a3557245746537808c14677e0ab68421204120b8ab295",`source_id`:"living",`text`:"There is no right or wrong way to choose healthy foods and drinks that may help manage your diabetes. Healthy meal plans for people who have diabetes may include",`section`:"Choose healthy foods and drinks",`section_context`:"How can I plan what to eat or drink when I have diabetes? / Choose healthy foods and drinks",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"79ee7b1ebfc9073b16c70b0128893bd26bdc0d568fa392494a1d7909bc6ba9e2"}) SET c += {`id`:"79ee7b1ebfc9073b16c70b0128893bd26bdc0d568fa392494a1d7909bc6ba9e2",`source_id`:"management",`text`:"Many people with diabetes aim to keep their blood glucose at these levels 1",`section`:"Recommended targets for blood glucose levels",`section_context`:"How can I check my blood glucose level at home? / Recommended targets for blood glucose levels",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"7a67864de4c55092a926d716bcadfd5b06d18e422804a5dfcc15cac3d2ba3cff"}) SET c += {`id`:"7a67864de4c55092a926d716bcadfd5b06d18e422804a5dfcc15cac3d2ba3cff",`source_id`:"living",`text`:"Check your blood glucose level before, during, and right after physical activity. Physical activity often lowers the level of glucose in your blood. Low blood glucose levels may last for hours or days after physical activity. You are most likely to have low blood glucose if you take insulin or some other diabetes medicines, such as sulfonylureas.",`section`:"Stay safe during physical activity",`section_context`:"How can physical activity help manage my diabetes? / Stay safe during physical activity",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"7af2ae78da6a7dc75a1a0388fa546072b68713b461cd96ea7eac229ebd78f7e0"}) SET c += {`id`:"7af2ae78da6a7dc75a1a0388fa546072b68713b461cd96ea7eac229ebd78f7e0",`source_id`:"type1",`text`:"If it’s not clear what type of diabetes you have, your health care professional may ask you to do",`section`:"Other tests",`section_context`:"How do health care professionals diagnose type 1 diabetes? / Other tests",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"7c83cfbab77d417b921284beab7f24371fb161429e16fdd9097f3eb413818624"}) SET c += {`id`:"7c83cfbab77d417b921284beab7f24371fb161429e16fdd9097f3eb413818624",`source_id`:"tests",`text`:"Sometimes doctors use the random plasma glucose test to diagnose diabetes when you have symptoms of diabetes and they do not want to wait until you have fasted for 8 hours. You may have this blood test at any time.",`section`:"Random plasma glucose test",`section_context`:"What tests are used to diagnose diabetes? / Random plasma glucose test",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"7c8534101b78ca67263f473901c108043321d84715c81f4d779d05ae673e29af"}) SET c += {`id`:"7c8534101b78ca67263f473901c108043321d84715c81f4d779d05ae673e29af",`source_id`:"symptoms",`text`:"Insulin is a hormone that helps blood glucose get into the body’s cells to be used as energy. When your body doesn’t have enough insulin, glucose in your blood can’t get into the cells. As a result, your cells lack energy, your blood glucose level rises, and you develop diabetes.",`section`:"What causes type 1 diabetes?",`section_context`:"What causes type 1 diabetes?",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"7f03e69820113d2c4452abd8d1c152d808b05aee58f43391942b7eb8a85c6f49"}) SET c += {`id`:"7f03e69820113d2c4452abd8d1c152d808b05aee58f43391942b7eb8a85c6f49",`source_id`:"living",`text`:"Making lifestyle changes can be hard, but starting with small changes and building from there may benefit your health. You may want to get help from family, loved ones, friends, and other trusted people in your community. You can also get information from your health care professionals.",`section`:"Healthy Living with Diabetes",`section_context`:"Healthy Living with Diabetes",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"7f4231761add389e9c80c0ad6bdc17bee2aa682fd65e38d8c155e40ae7ca3a9d"}) SET c += {`id`:"7f4231761add389e9c80c0ad6bdc17bee2aa682fd65e38d8c155e40ae7ca3a9d",`source_id`:"type1",`text`:"Health care professionals can diagnose diabetes using blood tests that measure your blood glucose level to see if it’s higher than normal. Health care professionals may use",`section`:"Blood glucose tests",`section_context`:"How do health care professionals diagnose type 1 diabetes? / Blood glucose tests",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"7faa889ed5afdc20c78a39c2f9ca3a9d75c3ac15e8c8c81a8c420102b22bc65c"}) SET c += {`id`:"7faa889ed5afdc20c78a39c2f9ca3a9d75c3ac15e8c8c81a8c420102b22bc65c",`source_id`:"type1",`text`:"An insulin pump is a small, portable machine that gives you frequent, small doses of insulin using a plastic tube under the skin. The pump is refilled with insulin every 2 to 3 days. Insulin pumps can be programmed to deliver insulin directly into your body 24 hours a day or at certain times.",`section`:"Diabetes devices and technology",`section_context`:"How can I manage type 1 diabetes? / Diabetes devices and technology",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"7fc8e7215e74c5113ba77d717d1a7fd19de33f2832329d6d32c1929dd462a81a"}) SET c += {`id`:"7fc8e7215e74c5113ba77d717d1a7fd19de33f2832329d6d32c1929dd462a81a",`source_id`:"foot",`text`:"If you have a bunion , or hammertoes, which are toes that curl under your feet, you may need extra-wide or deep shoes. 1 Do not wear shoes with pointed toes or high heels, because they put too much pressure on your toes. If your feet have changed shape, such as from Charcot’s foot, you may need special shoes or shoe inserts, called orthotics. You also may need inserts if you have bunions, hammertoes, or other foot problems.",`section`:"Wear shoes and socks at all times",`section_context`:"What can I do to keep my feet healthy? / Wear shoes and socks at all times",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"80176fa4fb8b73062169dd58a805a239cf5e99a735e43e93d2f774584dddde06"}) SET c += {`id`:"80176fa4fb8b73062169dd58a805a239cf5e99a735e43e93d2f774584dddde06",`source_id`:"living",`text`:"Ask your health care professional if you should take less insulin or eat carbs before, during, or after physical activity. Low blood glucose can be a serious medical emergency that must be treated right away. Take steps to protect yourself. You can learn how to treat low blood glucose , let other people know what to do if you need help, and use a medical alert bracelet.",`section`:"Stay safe during physical activity",`section_context`:"How can physical activity help manage my diabetes? / Stay safe during physical activity",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"80ad057923a6eaacdffb8de76bbc319fb7ae2c6433c8cb471b85a392bbd7d663"}) SET c += {`id`:"80ad057923a6eaacdffb8de76bbc319fb7ae2c6433c8cb471b85a392bbd7d663",`source_id`:"prediabetes",`text`:"Your health care professional may order tests for prediabetes if you’re age 35 or older, or if you have overweight or obesity and other risk factors for prediabetes and type 2 diabetes.",`section`:"How do health care professionals diagnose insulin resistance and prediabetes?",`section_context`:"How do health care professionals diagnose insulin resistance and prediabetes?",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type2"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`title`:"Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9"} MERGE (c:DiabetesEvidence {id:"82045449b31924733fcb9128ed2f7534eb30821def45795f0241aa3ffb9650b3"}) SET c += {`id`:"82045449b31924733fcb9128ed2f7534eb30821def45795f0241aa3ffb9650b3",`source_id`:"type2",`text`:"Physical inactivity and certain health problems such as high blood pressure affect your chances of developing type 2 diabetes. You are also more likely to develop type 2 diabetes if you have prediabetes or had gestational diabetes when you were pregnant. Learn more about risk factors for type 2 diabetes .",`section`:"Who is more likely to develop type 2 diabetes?",`section_context`:"Who is more likely to develop type 2 diabetes?",`title`:"Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:56.897529+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9",`topics`:["diabetes","type2","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type2","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"823d29a21eb18ee3222cbba84d300cc0cc23226a17127899f47c476205c13856"}) SET c += {`id`:"823d29a21eb18ee3222cbba84d300cc0cc23226a17127899f47c476205c13856",`source_id`:"type1",`text`:"The number of young people with type 1 diabetes has been increasing over the last two decades. In 2021, about 304,000 children and teens younger than age 20 had type 1 diabetes. 1",`section`:"How common is type 1 diabetes?",`section_context`:"How common is type 1 diabetes?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"8256f87d14aaff7f4ca3b9f88fefaca81acbbf330f66d8a02acbe1c5931cc59e"}) SET c += {`id`:"8256f87d14aaff7f4ca3b9f88fefaca81acbbf330f66d8a02acbe1c5931cc59e",`source_id`:"type1",`text`:"If it’s not clear what type of diabetes you have, your health care professional may ask you to do a C-peptide test to see how much insulin your pancreas makes genetic testing to rule out less common types of diabetes, such as monogenic diabetes",`section`:"Other tests",`section_context`:"How do health care professionals diagnose type 1 diabetes? / Other tests",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"risk"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`title`:"Risk Factors for Type 2 Diabetes",`publisher`:"NIDDK",`version`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114"} MERGE (c:DiabetesEvidence {id:"82a4d3aa4ef872a8ccebe30b7716b4d1a74f4bcc87d43f275d75d8153d446f5d"}) SET c += {`id`:"82a4d3aa4ef872a8ccebe30b7716b4d1a74f4bcc87d43f275d75d8153d446f5d",`source_id`:"risk",`text`:"Waist circumference is an indirect measurement of the amount of fat in your abdomen. Having a large waist circumference is a risk factor for diabetes and heart disease, even if you have a normal BMI.",`section`:"Waist circumference",`section_context`:"Does your weight put you at risk for type 2 diabetes? / Waist circumference",`title`:"Risk Factors for Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:48.116337+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114",`topics`:["diabetes","risk"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","risk"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"82d964743da27650e2094c7b76bb4d1eefb1118e4e01d5a1a951e7ec8a0ef8c8"}) SET c += {`id`:"82d964743da27650e2094c7b76bb4d1eefb1118e4e01d5a1a951e7ec8a0ef8c8",`source_id`:"type1",`text`:"People with type 1 diabetes may also have a higher risk of other health problems, including",`section`:"Other health problems",`section_context`:"What health problems can people with type 1 diabetes develop? / Other health problems",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"83e17f6fd3b0d7d9610f772aa33bad1a5b125a99608d188fd4d55c2bbd5d3d6b"}) SET c += {`id`:"83e17f6fd3b0d7d9610f772aa33bad1a5b125a99608d188fd4d55c2bbd5d3d6b",`source_id`:"living",`text`:"What you choose to eat, how much you eat, and when you eat are parts of a meal plan. Having healthy foods and drinks can help keep your blood glucose, blood pressure, and cholesterol levels in the ranges your health care professional recommends. If you have overweight or obesity, a healthy meal plan—along with regular physical activity, getting enough sleep, and other healthy behaviors—may help you reach and maintain a healthy weight.",`section`:"How can I plan what to eat or drink when I have diabetes?",`section_context`:"How can I plan what to eat or drink when I have diabetes?",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"85479ac73b94742b08a0f91708c1033d2edcaeb7b9a5232fdc90ccb120ab0443"}) SET c += {`id`:"85479ac73b94742b08a0f91708c1033d2edcaeb7b9a5232fdc90ccb120ab0443",`source_id`:"living",`text`:"Physical activity may help you manage your diabetes and stay healthy.",`section`:"How can physical activity help manage my diabetes?",`section_context`:"How can physical activity help manage my diabetes?",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"85746a7bd2a6af3816ab6b508dbc4b1218a76c8542dea5f203809e8d03aec22c"}) SET c += {`id`:"85746a7bd2a6af3816ab6b508dbc4b1218a76c8542dea5f203809e8d03aec22c",`source_id`:"eye",`text`:"In early diabetic retinopathy, blood vessels can weaken, bulge, or leak into the retina. This stage is called nonproliferative diabetic retinopathy.",`section`:"Diabetic retinopathy",`section_context`:"How does diabetes affect my eyes? / Diabetic retinopathy",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"861eaed021d505b43b9f9391e06a9fbd09e24314bb2f5b60f59488d656dda9fd"}) SET c += {`id`:"861eaed021d505b43b9f9391e06a9fbd09e24314bb2f5b60f59488d656dda9fd",`source_id`:"type1",`text`:"Teplizumab is a medicine that can delay type 1 diabetes symptoms from developing and delay the need for insulin injections. If you or a family member has two or more autoantibodies for type 1 diabetes and increasing blood glucose levels, your health care professional may recommend this medicine.",`section`:"Can I delay or prevent type 1 diabetes in me or in my family members who may be at risk?",`section_context`:"Can I delay or prevent type 1 diabetes in me or in my family members who may be at risk?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type2"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`title`:"Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9"} MERGE (c:DiabetesEvidence {id:"867bf049821fe8c6204f0f23e4c528d4eaab0aaf9867d08c6a480a903d7408e2"}) SET c += {`id`:"867bf049821fe8c6204f0f23e4c528d4eaab0aaf9867d08c6a480a903d7408e2",`source_id`:"type2",`text`:"Following a good diabetes care plan can help protect against many diabetes-related health problems. However, if not managed, diabetes can lead to problems such as heart disease and stroke nerve damage kidney disease foot problems eye disease gum disease and other dental problems sexual and bladder problems",`section`:"What health problems can people with diabetes develop?",`section_context`:"What health problems can people with diabetes develop?",`title`:"Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:56.897529+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9",`topics`:["diabetes","type2","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type2","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"86e50f44c78a45654384218e1d28b0f2fd90ab7bdf0767be2bd1bf0d89313a98"}) SET c += {`id`:"86e50f44c78a45654384218e1d28b0f2fd90ab7bdf0767be2bd1bf0d89313a98",`source_id`:"living",`text`:"There is no clear proof that specific foods, herbs, spices, or dietary supplements —such as vitamins or minerals—can help manage diabetes. Your health care professional may ask you to take vitamins or minerals if you can’t get enough from foods. Talk with your health care professional before you take any supplements, because some may cause side effects or affect how well your diabetes medicines work.",`section`:"Talk with your health care professional before taking dietary supplements",`section_context`:"How can I plan what to eat or drink when I have diabetes? / Talk with your health care professional before taking dietary supplements",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"876896c192463f99a27a787a6dc549873d96f4829dec9afa4a5406df174e9c17"}) SET c += {`id`:"876896c192463f99a27a787a6dc549873d96f4829dec9afa4a5406df174e9c17",`source_id`:"type1",`text`:"These symptoms are less common in adults with type 1 diabetes. For some adults, symptoms of type 1 diabetes may develop slowly and seem more like type 2 diabetes . Some adults who develop diabetes may need special tests to find out what type of diabetes they have.",`section`:"What are the symptoms of type 1 diabetes?",`section_context`:"What are the symptoms of type 1 diabetes?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"87979b3a849c2462c5cc4641c30138c0d9130599de3714f3d9e3130b4819f687"}) SET c += {`id`:"87979b3a849c2462c5cc4641c30138c0d9130599de3714f3d9e3130b4819f687",`source_id`:"type1",`text`:"If you have type 1 diabetes, you’ll need to take insulin to manage your blood glucose level. Using devices to check your blood glucose level and inject insulin may help keep your blood glucose level in a healthy range. Your health care professional may also prescribe other diabetes medicines.",`section`:"How can I manage type 1 diabetes?",`section_context`:"How can I manage type 1 diabetes?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"8894cb0dc40f0b0a33f9a882e54e29269b2c339152dab852194e542515a49adf"}) SET c += {`id`:"8894cb0dc40f0b0a33f9a882e54e29269b2c339152dab852194e542515a49adf",`source_id`:"type1",`text`:"People with diabetes may also have high blood pressure or cholesterol problems. Diabetes is also linked to some types of cancer .",`section`:"What health problems can people with type 1 diabetes develop?",`section_context`:"What health problems can people with type 1 diabetes develop?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"890915e97df5a20aec8f0660f62af53888ce9a4403362c8464a22346135f188f"}) SET c += {`id`:"890915e97df5a20aec8f0660f62af53888ce9a4403362c8464a22346135f188f",`source_id`:"foot",`text`:"Cutting and over-the counter corn removal products can damage your skin and cause an infection.",`section`:"Smooth corns and calluses gently",`section_context`:"What can I do to keep my feet healthy? / Smooth corns and calluses gently",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"891a3526c78624d7ec138050d8cbb29f2adf2bcd35c12681b2cb12aaf3205ac6"}) SET c += {`id`:"891a3526c78624d7ec138050d8cbb29f2adf2bcd35c12681b2cb12aaf3205ac6",`source_id`:"foot",`text`:"To keep your skin smooth and soft, rub a thin coat of lotion, cream, or petroleum jelly on the tops and bottoms of your feet. Do not put lotion or cream between your toes because moistness might cause an infection.",`section`:"Smooth corns and calluses gently",`section_context`:"What can I do to keep my feet healthy? / Smooth corns and calluses gently",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"risk"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`title`:"Risk Factors for Type 2 Diabetes",`publisher`:"NIDDK",`version`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114"} MERGE (c:DiabetesEvidence {id:"897d30e21c83ae8c8f2b93a7ed5885f1ce8b15aa52a9f297b40d4e13e426215b"}) SET c += {`id`:"897d30e21c83ae8c8f2b93a7ed5885f1ce8b15aa52a9f297b40d4e13e426215b",`source_id`:"risk",`text`:"You can use a different BMI calculator for children or teens ages 2–19 years. This calculator uses BMI, sex, and age to estimate if a child or teen has overweight or obesity.",`section`:"Body mass index",`section_context`:"Does your weight put you at risk for type 2 diabetes? / Body mass index",`title`:"Risk Factors for Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:48.116337+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114",`topics`:["diabetes","risk"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","risk"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"8a2d9487d856d221006c864804e651f3cabf9661561c0556f44e0ac2a411e524"}) SET c += {`id`:"8a2d9487d856d221006c864804e651f3cabf9661561c0556f44e0ac2a411e524",`source_id`:"tests",`text`:"Doctors use a variety of tests to diagnose diabetes and prediabetes. Your doctor may recommend different tests depending on whether you have symptoms or not, or whether you are pregnant.",`section`:"What tests are used to diagnose diabetes?",`section_context`:"What tests are used to diagnose diabetes?",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"8ac005e001d03a6745338c3955cc6f629cdd4ac74420d75ba32b7039949f8725"}) SET c += {`id`:"8ac005e001d03a6745338c3955cc6f629cdd4ac74420d75ba32b7039949f8725",`source_id`:"eye",`text`:"Call a doctor right away if you notice sudden changes to your vision, including flashes of light or many more spots (floaters) than usual. You also should see a doctor right away if it looks like a curtain is pulled over your eyes. These changes in your sight can be symptoms of a detached retina , which is a medical emergency.",`section`:"When should I see a doctor right away?",`section_context`:"When should I see a doctor right away?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"8c302d42beb544f82c8209a22eb33c4cf31061f8ccd437d48a389495994c3411"}) SET c += {`id`:"8c302d42beb544f82c8209a22eb33c4cf31061f8ccd437d48a389495994c3411",`source_id`:"living",`text`:"Ask your health care team if you should eat before, during, or after physical activity. Some diabetes medicines, such as sulfonylureas or insulin, may make your blood glucose level drop too low during exercise or if you skip or delay a meal.",`section`:"Find the best times to eat or drink",`section_context`:"How can I plan what to eat or drink when I have diabetes? / Find the best times to eat or drink",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"8cda1d5f8a5620c1cb4e0293a7c637f05be6770c92515a67b1312c81c58e05da"}) SET c += {`id`:"8cda1d5f8a5620c1cb4e0293a7c637f05be6770c92515a67b1312c81c58e05da",`source_id`:"symptoms",`text`:"Gene variants are changes to certain genes. Some gene variants can cause diseases that can affect the pancreas and lead to diabetes.",`section`:"Diseases caused by changes in your genes",`section_context`:"What else can cause diabetes? / Diseases caused by changes in your genes",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"8d9455732404738eb60782c17aa998040cbf06238c4e4c89c6a27bc9133dcbcb"}) SET c += {`id`:"8d9455732404738eb60782c17aa998040cbf06238c4e4c89c6a27bc9133dcbcb",`source_id`:"symptoms",`text`:"Endocrine diseases that may cause insulin resistance or diabetes include Cushing’s syndrome , which can cause the body to produce too much cortisol —often called the “stress hormone” acromegaly , which can cause the body to produce too much growth hormone hyperthyroidism , which can cause the body to produce too much thyroid hormone hypothyroidism , which can cause the body to produce too little thyroid hormone",`section`:"Endocrine diseases",`section_context`:"What else can cause diabetes? / Endocrine diseases",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"8d9adb51cee101cda50995386f08690f264c3228905fed0752f530b8ad650f86"}) SET c += {`id`:"8d9adb51cee101cda50995386f08690f264c3228905fed0752f530b8ad650f86",`source_id`:"tests",`text`:"The A1C test is a blood test that provides your average levels of blood glucose over the last 3 months. Other names for the A1C test are hemoglobin A1C, HbA1C, glycated hemoglobin, and glycosylated hemoglobin test. You can eat and drink before this test. Before using the A1C test to diagnose diabetes, your doctor will consider factors, such as whether you are in your second or third trimester of pregnancy or whether you have certain types of anemia or another problem with your blood. 1 The A1C test might not be accurate in those cases.",`section`:"A1C test",`section_context`:"What tests are used to diagnose diabetes? / A1C test",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"8ebddb9bc85487827a63128812c92b471d508438520d145f1fa5485d6c9f4b35"}) SET c += {`id`:"8ebddb9bc85487827a63128812c92b471d508438520d145f1fa5485d6c9f4b35",`source_id`:"eye",`text`:"On this page: What is diabetic eye disease? How does diabetes affect my eyes? How common is diabetic eye disease? Who is more likely to develop diabetic eye disease? What are the symptoms of diabetic eye disease? When should I see a doctor right away? How do doctors diagnose eye problems from diabetes? How do doctors treat diabetic eye disease? What can I do to protect my eyes? What if I already have some vision loss from diabetes?",`section`:"Diabetic Eye Disease",`section_context`:"Diabetic Eye Disease",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"8f9cdfe0706de24bfb182ab6859ec4722d4cb895e3291060239b33537dc27453"}) SET c += {`id`:"8f9cdfe0706de24bfb182ab6859ec4722d4cb895e3291060239b33537dc27453",`source_id`:"living",`text`:"Learn healthy ways to lower your stress , and ask for help from your health care team or a mental health professional. While it may be uncomfortable to talk about your feelings, finding a health care professional whom you trust and want to talk with may help you",`section`:"How can I take care of my mental health?",`section_context`:"How can I take care of my mental health?",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"8ff64dbb419d7254f8a4cfbea2b0f544dd181910b96736e06684c2ea4ccc9d0e"}) SET c += {`id`:"8ff64dbb419d7254f8a4cfbea2b0f544dd181910b96736e06684c2ea4ccc9d0e",`source_id`:"living",`text`:"Feeling stressed, sad, or angry can be common for people with diabetes. Managing diabetes or learning to cope with new information about your health can be hard. People with chronic illnesses such as diabetes may develop anxiety or other mental health conditions .",`section`:"How can I take care of my mental health?",`section_context`:"How can I take care of my mental health?",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"90499c76e827a6ffcc0ceb06c7e8d3fa4f635cda7a4365ca3f0471426df9e629"}) SET c += {`id`:"90499c76e827a6ffcc0ceb06c7e8d3fa4f635cda7a4365ca3f0471426df9e629",`source_id`:"prediabetes",`text`:"To diagnose prediabetes, your primary health care professional may ask about your medical history and suggest blood tests . Your primary health care professional may be a doctor, physician assistant, or nurse practitioner.",`section`:"How do health care professionals diagnose insulin resistance and prediabetes?",`section_context`:"How do health care professionals diagnose insulin resistance and prediabetes?",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"909bb21691e1641dfa692992840a37ee14abaaf859a0e319fccf6209acf02ad3"}) SET c += {`id`:"909bb21691e1641dfa692992840a37ee14abaaf859a0e319fccf6209acf02ad3",`source_id`:"prediabetes",`text`:"If you have overweight or obesity, work with your health care team to create a plan to reach and maintain a healthy weight. Use the calculator below to find out how much 5% to 7% of your weight is and whether weight loss may help lower your diabetes risk.",`section`:"Managing your weight",`section_context`:"How can I prevent or reverse insulin resistance and prediabetes? / Managing your weight",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"90c51314cf3b01c854d59b16228e8fb6c10a1c91126945049a8338308a154d9d"}) SET c += {`id`:"90c51314cf3b01c854d59b16228e8fb6c10a1c91126945049a8338308a154d9d",`source_id`:"type1",`text`:"Having a healthy lifestyle can help manage your type 1 diabetes and prevent other health problems. With the help of your health care team, you can create a diabetes care plan that works for you.",`section`:"How can I manage type 1 diabetes?",`section_context`:"How can I manage type 1 diabetes?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"neuropathy"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/nerve-damage-diabetic-neuropathies",`title`:"Diabetic Neuropathy",`publisher`:"NIDDK",`version`:"66214ea6f35f8b8a45f96550a4cc6c1101fa8e41650833491e65c7370e991455"} MERGE (c:DiabetesEvidence {id:"9124f6870e5e1650ecd37e56e5a359a8537230023c49e32488f0a4a42cdd7e17"}) SET c += {`id`:"9124f6870e5e1650ecd37e56e5a359a8537230023c49e32488f0a4a42cdd7e17",`source_id`:"neuropathy",`text`:"Autonomic neuropathy is damage to nerves that control your internal organs, leading to problems with your heart rate and blood pressure, digestive system, bladder, sex organs, sweat glands, and eyes. The damage can also lead to hypoglycemia unawareness.",`section`:"Autonomic Neuropathy",`section_context`:"Autonomic Neuropathy",`title`:"Diabetic Neuropathy",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/nerve-damage-diabetic-neuropathies",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:59.657648+00:00",`last_reviewed`:"Last Reviewed February 2018",`source_sha256`:"66214ea6f35f8b8a45f96550a4cc6c1101fa8e41650833491e65c7370e991455",`topics`:["diabetes","complications","neuropathy"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","neuropathy"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"9157e23725056cb79c5aeaa62030539d492496664263d89846bda2ca54526f91"}) SET c += {`id`:"9157e23725056cb79c5aeaa62030539d492496664263d89846bda2ca54526f91",`source_id`:"foot",`text`:"Medicare Part B insurance and other health insurance programs may help pay for these special shoes or inserts. Ask your insurance plan if it covers your special shoes or inserts.",`section`:"Wear shoes and socks at all times",`section_context`:"What can I do to keep my feet healthy? / Wear shoes and socks at all times",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"916bd496878af53c1ac6b1168e3e8865c5abc86c6f1029a7313fbe6e33efc78a"}) SET c += {`id`:"916bd496878af53c1ac6b1168e3e8865c5abc86c6f1029a7313fbe6e33efc78a",`source_id`:"foot",`text`:"Smoking can lower the amount of blood flow to your feet. If you smoke, ask for help to stop. You can get help by calling the national quitline at 1-800-QUITNOW or 1-800-784-8669. For tips on quitting, go to SmokeFree.gov .",`section`:"Keep the blood flowing to your feet",`section_context`:"What can I do to keep my feet healthy? / Keep the blood flowing to your feet",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"91d66225998a648ae6c00bc503895691ccf894827de2e261413e2569df35d983"}) SET c += {`id`:"91d66225998a648ae6c00bc503895691ccf894827de2e261413e2569df35d983",`source_id`:"tests",`text`:"If your blood glucose levels are higher than the target range, but not high enough to be diagnosed with diabetes, doctors will diagnose you with prediabetes . Having prediabetes is serious because it raises the chance of developing type 2 diabetes. But developing type 2 diabetes can be prevented . Adults and children diagnosed with prediabetes should be tested for type 2 diabetes every year.",`section`:"Type 2 diabetes",`section_context`:"Who should be tested for diabetes? / Type 2 diabetes",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"92223db1a1b444afe2495d6fa692091212b41991e12a9761535c940263635a8d"}) SET c += {`id`:"92223db1a1b444afe2495d6fa692091212b41991e12a9761535c940263635a8d",`source_id`:"foot",`text`:"If you have certain foot problems that make it more likely you will develop a sore on your foot, your doctor may recommend taking the temperature of the skin on different parts of your feet. A “hot spot” can be the first sign that a blister or an ulcer is starting.",`section`:"Check your feet every day",`section_context`:"What can I do to keep my feet healthy? / Check your feet every day",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"937727721748da95ec1d96c44d9ffe98358cbffe5d28d1178906d8830dd29929"}) SET c += {`id`:"937727721748da95ec1d96c44d9ffe98358cbffe5d28d1178906d8830dd29929",`source_id`:"type1",`text`:"Studies such as The Environmental Determinants of Diabetes in the Young (TEDDY) are trying to learn more about the causes of type 1 diabetes. Type 1 Diabetes TrialNet and other groups are working to find treatments that may prevent or slow the development of type 1 diabetes in people who are at risk for getting the disease.",`section`:"What causes type 1 diabetes?",`section_context`:"What causes type 1 diabetes?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"939c7aac8549a78d53a012ae3711a09172cc0ab499661a7af018226fd595a157"}) SET c += {`id`:"939c7aac8549a78d53a012ae3711a09172cc0ab499661a7af018226fd595a157",`source_id`:"living",`text`:"Research shows that regular physical activity helps people manage their diabetes and stay healthy. Benefits of physical activity may include lower blood glucose, blood pressure, and cholesterol levels better heart health healthier weight better mood and sleep better balance and memory",`section`:"How can physical activity help manage my diabetes?",`section_context`:"How can physical activity help manage my diabetes?",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"93a3b47c079c8c0c063bed4c815c440182f6e1f4d5cff7c7fa7cf560e44ae4f3"}) SET c += {`id`:"93a3b47c079c8c0c063bed4c815c440182f6e1f4d5cff7c7fa7cf560e44ae4f3",`source_id`:"living",`text`:"There is no right or wrong way to choose healthy foods and drinks that may help manage your diabetes. Healthy meal plans for people who have diabetes may include dairy or plant-based dairy products fruits nonstarchy vegetables protein foods whole grains",`section`:"Choose healthy foods and drinks",`section_context`:"How can I plan what to eat or drink when I have diabetes? / Choose healthy foods and drinks",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"942b96d5f1e99c78b0120e57c589da071d313c5d0fbc8307c5cd12b1933dceb1"}) SET c += {`id`:"942b96d5f1e99c78b0120e57c589da071d313c5d0fbc8307c5cd12b1933dceb1",`source_id`:"type1",`text`:"People with diabetes can check their blood glucose level with a blood glucose meter. After drawing a small amount of blood from your finger, you can use the meter to measure how much glucose is in your blood at that moment.",`section`:"Diabetes devices and technology",`section_context`:"How can I manage type 1 diabetes? / Diabetes devices and technology",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"definition"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`title`:"What Is Diabetes?",`publisher`:"NIDDK",`version`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1"} MERGE (c:DiabetesEvidence {id:"947befad3eac3baedee8053845dfc989f8495e566dac91faebf2aa6071069dd6"}) SET c += {`id`:"947befad3eac3baedee8053845dfc989f8495e566dac91faebf2aa6071069dd6",`source_id`:"definition",`text`:"Diabetes is a disease that occurs when your blood glucose, also called blood sugar, is too high. Glucose is your body’s main source of energy. Your body can make glucose, but glucose also comes from the food you eat.",`section`:"What Is Diabetes?",`section_context`:"What Is Diabetes?",`title`:"What Is Diabetes?",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.530017+00:00",`last_reviewed`:"Last Reviewed April 2023",`source_sha256`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1",`topics`:["diabetes","types"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","types"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"94c090afeb59ce2be0e719600bef31b651c1e2979d6338998bada46a911604bf"}) SET c += {`id`:"94c090afeb59ce2be0e719600bef31b651c1e2979d6338998bada46a911604bf",`source_id`:"living",`text`:"Ask your health care team or your insurance company if your benefits include medical nutrition therapy or other diabetes care resources.",`section`:"Plan how much to eat or drink",`section_context`:"How can I plan what to eat or drink when I have diabetes? / Plan how much to eat or drink",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prevention"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`title`:"Preventing Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba"} MERGE (c:DiabetesEvidence {id:"9506ca48e5cb664ee7e926fee954d99c72ebedd7efb20496e8d5ae4c9f236957"}) SET c += {`id`:"9506ca48e5cb664ee7e926fee954d99c72ebedd7efb20496e8d5ae4c9f236957",`source_id`:"prevention",`text`:"Research such as the Diabetes Prevention Program shows that you can do a lot to reduce your chances of developing type 2 diabetes. Here are some things you can change to lower your risk:",`section`:"How can I lower my chances of developing type 2 diabetes?",`section_context`:"How can I lower my chances of developing type 2 diabetes?",`title`:"Preventing Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:49.393819+00:00",`last_reviewed`:"Last Reviewed November 2016",`source_sha256`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba",`topics`:["diabetes","prevention"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prevention"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type2"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`title`:"Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9"} MERGE (c:DiabetesEvidence {id:"950aa9dd35cd38610c1649a52546e9d2afb1fb6e70acfd9dbdc72fd34926af11"}) SET c += {`id`:"950aa9dd35cd38610c1649a52546e9d2afb1fb6e70acfd9dbdc72fd34926af11",`source_id`:"type2",`text`:"Many people with type 2 diabetes also have nonalcoholic fatty liver disease (NAFLD) . Losing weight if you are overweight or have obesity can improve NAFLD. Diabetes is also linked to other health problems such as sleep apnea , depression, some types of cancer, and dementia .",`section`:"What health problems can people with diabetes develop?",`section_context`:"What health problems can people with diabetes develop?",`title`:"Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:56.897529+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9",`topics`:["diabetes","type2","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type2","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"95679b1189b43652ab158b88b52fa21c0363472cf1f033749ee190b48ef7ff3a"}) SET c += {`id`:"95679b1189b43652ab158b88b52fa21c0363472cf1f033749ee190b48ef7ff3a",`source_id`:"management",`text`:"Take your medicines as they were prescribed, even if you feel good or have reached your blood glucose, blood pressure, or cholesterol goals. Avoid rationing your medicines or skipping taking your medicines if you have trouble paying for them. Talk with your health care team if you can’t afford your medicines or if you experience any side effects.",`section`:"What types of medicines should I take?",`section_context`:"What types of medicines should I take?",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"956c143d7d971e0231a4cd0b67ec577064f5f08103538add84db935b051658ee"}) SET c += {`id`:"956c143d7d971e0231a4cd0b67ec577064f5f08103538add84db935b051658ee",`source_id`:"prediabetes",`text`:"To prevent or reverse insulin resistance and prediabetes , aim to live a healthy lifestyle and manage your weight. Your health care professional may also prescribe medicines to help you manage your blood glucose levels, lose weight, and prevent type 2 diabetes.",`section`:"How can I prevent or reverse insulin resistance and prediabetes?",`section_context`:"How can I prevent or reverse insulin resistance and prediabetes?",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"956dadee3f3537c5ba864d81696a4a9c8e1097cbd4b3ba25dc6a186d53d8a20d"}) SET c += {`id`:"956dadee3f3537c5ba864d81696a4a9c8e1097cbd4b3ba25dc6a186d53d8a20d",`source_id`:"management",`text`:"Not smoking is important for your health, especially if you have diabetes. Both smoking and diabetes can make your blood vessels narrow. E-cigarettes aren’t a safe option either. If you smoke, vape, or use other tobacco products, stop. Ask for help so you don’t have to do it alone.",`section`:"S is for stop smoking",`section_context`:"What are the diabetes ABCs? / S is for stop smoking",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"95a411037402149c781658f8c07d972dcf1910e6ea6193104725d8f8dae7c516"}) SET c += {`id`:"95a411037402149c781658f8c07d972dcf1910e6ea6193104725d8f8dae7c516",`source_id`:"eye",`text`:"Your doctor may treat your eyes with anti-VEGF medicine, such as aflibercept, bevacizumab, or ranibizumab. These medicines block the growth of abnormal blood vessels in the eye. Anti-VEGF medicines can also stop fluid leaks, which can help treat diabetic macular edema .",`section`:"Medicine",`section_context`:"How do doctors treat diabetic eye disease? / Medicine",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"96278678cd6e776deaeb9fc64d2b3f43b27ed0dedea495c2e2e7d97162bd4978"}) SET c += {`id`:"96278678cd6e776deaeb9fc64d2b3f43b27ed0dedea495c2e2e7d97162bd4978",`source_id`:"symptoms",`text`:"Certain medicines may harm the pancreas or affect the way insulin works in the body. Some of these medicines may include antipsychotics that are used to treat certain mental health problems antiseizure medicines that are used to treat epilepsy beta-blockers and diuretics that are used to treat high blood pressure glucocorticoids that are used to treat certain inflammatory diseases immunosuppressants that are used after an organ transplant niacin , a type of vitamin B that is sometimes used to treat high blood cholesterol",`section`:"Taking certain medicines",`section_context`:"What else can cause diabetes? / Taking certain medicines",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"973949efbb5444940db822aa70741008ebda0074850f73e0edc43e5c9fe8420b"}) SET c += {`id`:"973949efbb5444940db822aa70741008ebda0074850f73e0edc43e5c9fe8420b",`source_id`:"eye",`text`:"If you have diabetes and become pregnant, you can develop eye problems very quickly during your pregnancy. If you already have some diabetic retinopathy, it can get worse during pregnancy. Changes that help your body support a growing baby may put stress on the blood vessels in your eyes. Your health care team will suggest regular eye exams during pregnancy to catch and treat problems early and protect your vision.",`section`:"Who is more likely to develop diabetic eye disease?",`section_context`:"Who is more likely to develop diabetic eye disease?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"98e83c5ce8459e831b667364586cd5cf085896de83abbe00d0ad84023fd94789"}) SET c += {`id`:"98e83c5ce8459e831b667364586cd5cf085896de83abbe00d0ad84023fd94789",`source_id`:"tests",`text`:"If you are already pregnant, you should be tested for type 2 diabetes at the first prenatal appointment, or in the first 15 weeks of pregnancy. If you have diabetes, you should receive special care during your pregnancy to avoid problems for you and the baby.",`section`:"Type 2 diabetes",`section_context`:"Who should be tested for diabetes? / Type 2 diabetes",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"9919b6ae8ba502d59b11a7ab47fcf17c26540fb82150598c71fb2ef3283cf012"}) SET c += {`id`:"9919b6ae8ba502d59b11a7ab47fcf17c26540fb82150598c71fb2ef3283cf012",`source_id`:"foot",`text`:"When breaking in new shoes, only wear them for a few hours at first and then check your feet for areas of soreness.",`section`:"Wear shoes and socks at all times",`section_context`:"What can I do to keep my feet healthy? / Wear shoes and socks at all times",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"9a06b2f3ef2e1fe2805e24b2245333b6a8ab17257e1d7a48dd3d153ac5a02970"}) SET c += {`id`:"9a06b2f3ef2e1fe2805e24b2245333b6a8ab17257e1d7a48dd3d153ac5a02970",`source_id`:"living",`text`:"Sleeping too much or too little may raise your blood glucose levels. Your sleep habits may also affect your mental health and vice versa. People with diabetes and overweight or obesity can also have other health conditions that affect sleep, such as sleep apnea , which can raise your blood pressure and risk of heart disease.",`section`:"How can I take care of my mental health?",`section_context`:"How can I take care of my mental health?",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"9a66a2f8d6e60ca926a0c95bcbddb57c7c7b74ad8b898fc9fb2769faea544efa"}) SET c += {`id`:"9a66a2f8d6e60ca926a0c95bcbddb57c7c7b74ad8b898fc9fb2769faea544efa",`source_id`:"symptoms",`text`:"The pancreas can be damaged by injury or diseases such as inflammation of the pancreas, also called pancreatitis . Diabetes may be the first sign of pancreatic cancer in older people without diabetes risk factors who develop diabetes. A damaged pancreas may make less insulin and lead to diabetes. In some cases, your pancreas may need to be removed. Without a pancreas, your body can’t produce insulin. You’ll develop diabetes and will have to take insulin.",`section`:"Damage to or removal of the pancreas",`section_context`:"What else can cause diabetes? / Damage to or removal of the pancreas",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"9a722ea120795d2a3a3973e7fca8ef8b0e54e3f20426d5a0981626dc082f9d89"}) SET c += {`id`:"9a722ea120795d2a3a3973e7fca8ef8b0e54e3f20426d5a0981626dc082f9d89",`source_id`:"type1",`text`:"If you have type 1 diabetes, you’ll need to carefully manage the amount of insulin you take every day to keep your blood glucose level in a healthy range. If you take too much insulin, you may develop low blood glucose.",`section`:"Hypoglycemia unawareness",`section_context`:"What health problems can people with type 1 diabetes develop? / Hypoglycemia unawareness",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"9c3ef375e204e407fb9d457eabb665fd4f97b91391d1b3c87baa1eb78edc4525"}) SET c += {`id`:"9c3ef375e204e407fb9d457eabb665fd4f97b91391d1b3c87baa1eb78edc4525",`source_id`:"eye",`text`:"Some groups are affected more than others. African Americans, American Indians and Alaska Natives, Hispanics/Latinos, Pacific Islanders, and older adults are at greater risk of losing vision or going blind from diabetes.",`section`:"Who is more likely to develop diabetic eye disease?",`section_context`:"Who is more likely to develop diabetic eye disease?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"9cc6ba85d05c27193ab53d2ca867e63386b5a23986b9de8ef0c960bb72df68e9"}) SET c += {`id`:"9cc6ba85d05c27193ab53d2ca867e63386b5a23986b9de8ef0c960bb72df68e9",`source_id`:"living",`text`:"Drinking liquids helps prevent dehydration , or the loss of too much water in your body. Drinking water is a way to stay hydrated. Sports drinks often have a lot of sugar and calories , and you don’t need them for most moderate physical activities.",`section`:"Stay safe during physical activity",`section_context`:"How can physical activity help manage my diabetes? / Stay safe during physical activity",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"9dbd3dfd9ecf74ed70ee4d69cce4c70f121a4456f8f029007dc879e3c0bad322"}) SET c += {`id`:"9dbd3dfd9ecf74ed70ee4d69cce4c70f121a4456f8f029007dc879e3c0bad322",`source_id`:"symptoms",`text`:"DKA usually affects people with type 1 diabetes. People with type 2 diabetes may also develop DKA if their body doesn’t produce enough insulin.",`section`:"Type 1 diabetes symptoms",`section_context`:"What are the symptoms of diabetes? / Type 1 diabetes symptoms",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type2"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`title`:"Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9"} MERGE (c:DiabetesEvidence {id:"9e0c3635bfc9a33ef5ff4c9213edd96bbd0c74568ba757fe954abe827bbc9e52"}) SET c += {`id`:"9e0c3635bfc9a33ef5ff4c9213edd96bbd0c74568ba757fe954abe827bbc9e52",`source_id`:"type2",`text`:"Learn more about medicines, insulin, and other diabetes treatments .",`section`:"What medicines do I need to treat my type 2 diabetes?",`section_context`:"What medicines do I need to treat my type 2 diabetes?",`title`:"Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:56.897529+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9",`topics`:["diabetes","type2","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type2","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"9e31f25539cc69abd5ff8ac2c76e57a36b174e0547b2a0245f56a7b5eadeeb63"}) SET c += {`id`:"9e31f25539cc69abd5ff8ac2c76e57a36b174e0547b2a0245f56a7b5eadeeb63",`source_id`:"management",`text`:"Your health care team may want you to check your urine for ketones if you have symptoms of diabetic ketoacidosis . Diabetic ketoacidosis is a medical emergency that needs to be treated right away.",`section`:"Checking urine for ketones",`section_context`:"How can I check my blood glucose level at home? / Checking urine for ketones",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"9e83ff33049ddd77e2ddf194eb2223e0b934c090c24a9790c6039109a6105f38"}) SET c += {`id`:"9e83ff33049ddd77e2ddf194eb2223e0b934c090c24a9790c6039109a6105f38",`source_id`:"living",`text`:"Try to choose foods that include nutrients such as vitamins, calcium , fiber , and healthy fats . Also try to choose drinks with little or no added sugar , such as tap or bottled water, low-fat or non-fat milk, and unsweetened tea, coffee, or sparkling water.",`section`:"Choose healthy foods and drinks",`section_context`:"How can I plan what to eat or drink when I have diabetes? / Choose healthy foods and drinks",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"9f4808b9420c38345ec7d561c44775d27b70c7ce24ee12851ddb4cb90d29606a"}) SET c += {`id`:"9f4808b9420c38345ec7d561c44775d27b70c7ce24ee12851ddb4cb90d29606a",`source_id`:"type1",`text`:"To find out if your diabetes is type 1, your health care professional may test your blood for certain autoantibodies.",`section`:"Autoantibodies test",`section_context`:"How do health care professionals diagnose type 1 diabetes? / Autoantibodies test",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"9fc38cda146521e33edac34272fdfe39af6a2d7c8847e419049e1fefad833dfe"}) SET c += {`id`:"9fc38cda146521e33edac34272fdfe39af6a2d7c8847e419049e1fefad833dfe",`source_id`:"living",`text`:"Both diabetes and smoking —including using tobacco products and e-cigarettes—cause your blood vessels to narrow. Both diabetes and smoking increase your risk of having a heart attack or stroke , nerve damage , kidney disease , eye disease , or amputation . Secondhand smoke can also affect the health of your family or others who live with you.",`section`:"Should I quit smoking?",`section_context`:"Should I quit smoking?",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"a0ffcc0ca25a0886d59ca2b33b3e55d7792eafabce78adeec63e8f773975e098"}) SET c += {`id`:"a0ffcc0ca25a0886d59ca2b33b3e55d7792eafabce78adeec63e8f773975e098",`source_id`:"eye",`text`:"Your doctor may recommend having eye exams more often than once a year, along with management of your diabetes. This means managing your diabetes ABCs, which include your A1c, blood pressure, and cholesterol; and quitting smoking. Ask your health care team what you can do to reach your goals.",`section`:"How do doctors treat diabetic eye disease?",`section_context`:"How do doctors treat diabetic eye disease?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prevention"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`title`:"Preventing Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba"} MERGE (c:DiabetesEvidence {id:"a1da21ec883f1474314af6b8e1d4484b0d740a4b4c6f8026333679b93683bef1"}) SET c += {`id`:"a1da21ec883f1474314af6b8e1d4484b0d740a4b4c6f8026333679b93683bef1",`source_id`:"prevention",`text`:"Most often, your best chance for preventing type 2 diabetes is to make lifestyle changes that work for you long term. Get started with Your Game Plan to Prevent Type 2 Diabetes .",`section`:"How can I lower my chances of developing type 2 diabetes?",`section_context`:"How can I lower my chances of developing type 2 diabetes?",`title`:"Preventing Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:49.393819+00:00",`last_reviewed`:"Last Reviewed November 2016",`source_sha256`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba",`topics`:["diabetes","prevention"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prevention"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"a23d7fdb0fe5df2ccf95a808aa1bb5b40b166411347fb3eb1ad847f6bc69f70e"}) SET c += {`id`:"a23d7fdb0fe5df2ccf95a808aa1bb5b40b166411347fb3eb1ad847f6bc69f70e",`source_id`:"type1",`text`:"Health care professionals can diagnose diabetes using blood tests that measure your blood glucose level to see if it’s higher than normal. Health care professionals may use the random plasma glucose test to diagnose diabetes in people who have diabetes symptoms the fasting plasma glucose test the A1C test",`section`:"Blood glucose tests",`section_context`:"How do health care professionals diagnose type 1 diabetes? / Blood glucose tests",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prevention"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`title`:"Preventing Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba"} MERGE (c:DiabetesEvidence {id:"a333908bd8e9e8f9d44e7d5355203afa37a930d2b4af1340c9af2ad3b8a57b37"}) SET c += {`id`:"a333908bd8e9e8f9d44e7d5355203afa37a930d2b4af1340c9af2ad3b8a57b37",`source_id`:"prevention",`text`:"Gestational diabetes is a type of diabetes that develops during pregnancy. Most of the time, gestational diabetes goes away after your baby is born. Even if your gestational diabetes goes away, you still have a greater chance of developing type 2 diabetes within 5 to 10 years. Your child may also be more likely to become obese and develop type 2 diabetes later in life. Making healthy choices helps the whole family and may protect your child from becoming obese or developing diabetes.",`section`:"If I had gestational diabetes when I was pregnant, how can I lower my chances of developing type 2 diabetes?",`section_context`:"If I had gestational diabetes when I was pregnant, how can I lower my chances of developing type 2 diabetes?",`title`:"Preventing Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:49.393819+00:00",`last_reviewed`:"Last Reviewed November 2016",`source_sha256`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba",`topics`:["diabetes","prevention"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prevention"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"a479570aaf2c3648bc4594f067a2b895bf4b8ed53e952f2ce848c2d85b55e1ca"}) SET c += {`id`:"a479570aaf2c3648bc4594f067a2b895bf4b8ed53e952f2ce848c2d85b55e1ca",`source_id`:"prediabetes",`text`:"Researchers don’t fully understand what causes insulin resistance and prediabetes. However, people with risk factors for type 2 diabetes are more likely to develop these conditions.",`section`:"What causes insulin resistance and prediabetes?",`section_context`:"What causes insulin resistance and prediabetes?",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"a4edeccbbfa12d17d05913e4c3a8bb9c69909098244eacc1a60ccbaee7f65579"}) SET c += {`id`:"a4edeccbbfa12d17d05913e4c3a8bb9c69909098244eacc1a60ccbaee7f65579",`source_id`:"tests",`text`:"Your doctor will report your A1C test result as a percentage, such as an A1C of 7%. The higher the percentage is, the higher your average blood glucose levels are.",`section`:"A1C test",`section_context`:"What tests are used to diagnose diabetes? / A1C test",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"a537f6963e5df6290765ff2df957e1301259e76139a5b9bb8e8a8a13d82737c6"}) SET c += {`id`:"a537f6963e5df6290765ff2df957e1301259e76139a5b9bb8e8a8a13d82737c6",`source_id`:"foot",`text`:"Wash your feet with soap in warm, not hot, water. Test the water to make sure it is not too hot. You can use a thermometer (90° to 95° F is safe) or your elbow to test the warmth of the water. Do not soak your feet because your skin will get too dry.",`section`:"Wash your feet every day",`section_context`:"What can I do to keep my feet healthy? / Wash your feet every day",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"gestational"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/gestational",`title`:"Gestational Diabetes",`publisher`:"NIDDK",`version`:"1841d78cf7d6313e8d45385c1bbec6ee62a83095a5dfc71de54228f8f11e02de"} MERGE (c:DiabetesEvidence {id:"a656bad55eaffe64fb6c3884719066fa090f2140a0a2a4733e3855802bceae1e"}) SET c += {`id`:"a656bad55eaffe64fb6c3884719066fa090f2140a0a2a4733e3855802bceae1e",`source_id`:"gestational",`text`:"Gestational diabetes often has no symptoms, or they may be mild, such as being thirstier than normal or having to urinate more often. Gestational diabetes is sometimes related to the hormonal changes of pregnancy that make your body less able to use insulin. Genes and extra weight may also play a role.",`section`:"Symptoms & Causes",`section_context`:"Symptoms & Causes",`title`:"Gestational Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/gestational",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:58.409138+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"1841d78cf7d6313e8d45385c1bbec6ee62a83095a5dfc71de54228f8f11e02de",`topics`:["diabetes","gestational"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","gestational"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"a6bbb542744eda06c06784a223c1cc81be7a38ece7fe451eab74ce123e02db8f"}) SET c += {`id`:"a6bbb542744eda06c06784a223c1cc81be7a38ece7fe451eab74ce123e02db8f",`source_id`:"prediabetes",`text`:"Healthy living may help prevent or reverse insulin resistance and prediabetes. Healthy living may also help prevent or delay the health problems related to these conditions. A healthy lifestyle may include consuming healthy foods and drinks being physically active managing your weight getting enough sleep",`section`:"Healthy living",`section_context`:"How can I prevent or reverse insulin resistance and prediabetes? / Healthy living",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"a87e95807389a937d8d215348465aa3e7447fb5d1939fa430cc3e7b29311bf9b"}) SET c += {`id`:"a87e95807389a937d8d215348465aa3e7447fb5d1939fa430cc3e7b29311bf9b",`source_id`:"living",`text`:"The plate method helps you control portion sizes without counting and measuring. This method divides a 9-inch plate into the following three sections to help you choose the types and amounts of foods to eat for each meal. Nonstarchy vegetables—such as leafy greens, peppers, carrots, or green beans—should make up half of your plate. Carb foods that are high in fiber—such as brown rice, whole grains, beans, or fruits—should make up one-quarter of your plate.",`section`:"Plan how much to eat or drink",`section_context`:"How can I plan what to eat or drink when I have diabetes? / Plan how much to eat or drink",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"a93e8d36d84474e19aa5e23545c95459db5752a086782fc3ecce1df5979e2f2f"}) SET c += {`id`:"a93e8d36d84474e19aa5e23545c95459db5752a086782fc3ecce1df5979e2f2f",`source_id`:"living",`text`:"Healthy living is a way to manage diabetes . To have a healthy lifestyle, take steps now to plan healthy meals and snacks, do physical activities, get enough sleep, and quit smoking or using tobacco products.",`section`:"Healthy Living with Diabetes",`section_context`:"Healthy Living with Diabetes",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"a9fd872cab3d02b89e260fb3af7df8478e2a7b323121b67540da38dc2fc832a2"}) SET c += {`id`:"a9fd872cab3d02b89e260fb3af7df8478e2a7b323121b67540da38dc2fc832a2",`source_id`:"eye",`text`:"Your doctor may suggest other tests, too, depending on your health history.",`section`:"How do doctors diagnose eye problems from diabetes?",`section_context`:"How do doctors diagnose eye problems from diabetes?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"aa355d038456ca5a3cb6cac88ba25103cbebdb94037abd2c7240a64020791520"}) SET c += {`id`:"aa355d038456ca5a3cb6cac88ba25103cbebdb94037abd2c7240a64020791520",`source_id`:"type1",`text`:"Some adults with diabetes have autoantibodies in their blood but develop symptoms slower than most people with type 1 diabetes. In this type of diabetes, your immune system damages your pancreas more slowly. You may not need to take insulin for several months after being diagnosed. This type of diabetes is sometimes called latent autoimmune diabetes in adults (LADA).",`section`:"Autoantibodies test",`section_context`:"How do health care professionals diagnose type 1 diabetes? / Autoantibodies test",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"aab67bbb8fa858e09864669261f1936f53488e0855aa8adbbe7d6bfee0192196"}) SET c += {`id`:"aab67bbb8fa858e09864669261f1936f53488e0855aa8adbbe7d6bfee0192196",`source_id`:"tests",`text`:"If you have diabetes, your doctor may look for certain autoantibodies to see if your diabetes is type 1. Autoantibodies are proteins in your immune system that mistakenly attack your healthy tissues and cells. A health care professional will take a sample of your blood for this test. If autoantibodies for diabetes are found in your blood, you may have type 1 diabetes. 1",`section`:"Autoantibodies",`section_context`:"Which tests help my doctor know what kind of diabetes I have? / Autoantibodies",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"ab4cdac27823b8d0298f91df07534c34c1e90b9c8f726a50d74ec31aaaae9fa9"}) SET c += {`id`:"ab4cdac27823b8d0298f91df07534c34c1e90b9c8f726a50d74ec31aaaae9fa9",`source_id`:"foot",`text`:"If you want to get a pedicure at a salon, you should bring your own nail tools to prevent getting an infection. You can ask your health care provider what other steps you can take at the salon to prevent infection.",`section`:"Trim your toenails straight across",`section_context`:"What can I do to keep my feet healthy? / Trim your toenails straight across",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"aba7dbc19f84439a063a368ee273716edf990e8bf897b53655d9f8aeca4d99d2"}) SET c += {`id`:"aba7dbc19f84439a063a368ee273716edf990e8bf897b53655d9f8aeca4d99d2",`source_id`:"tests",`text`:"Each test to detect diabetes and prediabetes uses a different measurement. Usually, your doctor will use a second test to confirm you have diabetes.",`section`:"What test results tell me if I have diabetes or prediabetes?",`section_context`:"What test results tell me if I have diabetes or prediabetes?",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"abdd20b7858f4bab99e86e0ccbb2fa913b500ee100ae3037fb5fe0411a39ba5f"}) SET c += {`id`:"abdd20b7858f4bab99e86e0ccbb2fa913b500ee100ae3037fb5fe0411a39ba5f",`source_id`:"symptoms",`text`:"Sometimes, people find out they have type 1 diabetes when they have signs and symptoms of a condition called diabetic ketoacidosis (DKA) . Symptoms of DKA may include",`section`:"Type 1 diabetes symptoms",`section_context`:"What are the symptoms of diabetes? / Type 1 diabetes symptoms",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"gestational"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/gestational",`title`:"Gestational Diabetes",`publisher`:"NIDDK",`version`:"1841d78cf7d6313e8d45385c1bbec6ee62a83095a5dfc71de54228f8f11e02de"} MERGE (c:DiabetesEvidence {id:"ac40f612f11ecfcd1c0f08b5f843af4889473107c380cd1f76618ad3acb80eb4"}) SET c += {`id`:"ac40f612f11ecfcd1c0f08b5f843af4889473107c380cd1f76618ad3acb80eb4",`source_id`:"gestational",`text`:"Gestational diabetes is a type of diabetes that occurs only during pregnancy. Gestational diabetes can cause health problems in both mother and baby. Managing your diabetes can help protect you and your baby.",`section`:"Definition & Facts",`section_context`:"Definition & Facts",`title`:"Gestational Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/gestational",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:58.409138+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"1841d78cf7d6313e8d45385c1bbec6ee62a83095a5dfc71de54228f8f11e02de",`topics`:["diabetes","gestational"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","gestational"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"ac774014be127566c068ff5132b3ccde0bf1d64f950524ba68f0760756ff762e"}) SET c += {`id`:"ac774014be127566c068ff5132b3ccde0bf1d64f950524ba68f0760756ff762e",`source_id`:"symptoms",`text`:"Studies such as The Environmental Determinants of Diabetes in the Young (TEDDY) are trying to learn more about the causes of type 1 diabetes. Type 1 Diabetes TrialNet and other groups are working to find treatments that may prevent or slow the development of type 1 diabetes in people who are at risk for getting the disease.",`section`:"What causes type 1 diabetes?",`section_context`:"What causes type 1 diabetes?",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"ad57eb0c83be0b37b1d170cae4517a435830abecd08b85c8fa2f6099bb170a4e"}) SET c += {`id`:"ad57eb0c83be0b37b1d170cae4517a435830abecd08b85c8fa2f6099bb170a4e",`source_id`:"management",`text`:"If you often have high blood glucose levels, you may need to make a change to your diabetes meal plan, physical activity plan, or medicines. Very high blood glucose may lead to confusion or fainting, and it may become a serious medical emergency that must be treated right away.",`section`:"Recommended targets for blood glucose levels",`section_context`:"How can I check my blood glucose level at home? / Recommended targets for blood glucose levels",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"ad8181f466b603b68758adb9a1a85f80d5431f3c989bc95d136ae2123f8b972c"}) SET c += {`id`:"ad8181f466b603b68758adb9a1a85f80d5431f3c989bc95d136ae2123f8b972c",`source_id`:"prediabetes",`text`:"People with prediabetes may be more at risk for developing type 2 diabetes. But not everyone with prediabetes develops type 2 diabetes. You can take steps to lower your risk .",`section`:"How common is prediabetes?",`section_context`:"How common is prediabetes?",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"ade793c80267237945c38a8002b5142b7fb03e2f2682b59cfc2b8c526abd4523"}) SET c += {`id`:"ade793c80267237945c38a8002b5142b7fb03e2f2682b59cfc2b8c526abd4523",`source_id`:"tests",`text`:"If you do not have diabetes but your parent or sibling has type 1 diabetes, your doctor might give you this test to see if you have a higher risk of developing type 1 diabetes. You may want to learn about diabetes symptoms and have follow-up testing as recommended by your doctor. 1",`section`:"Autoantibodies",`section_context`:"Which tests help my doctor know what kind of diabetes I have? / Autoantibodies",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"ae536208f723071e074bd101d53fc37d426098ccf87605e47630b8aabb607735"}) SET c += {`id`:"ae536208f723071e074bd101d53fc37d426098ccf87605e47630b8aabb607735",`source_id`:"symptoms",`text`:"Sometimes, people find out they have type 1 diabetes when they have signs and symptoms of a condition called diabetic ketoacidosis (DKA) . Symptoms of DKA may include feeling very tired having trouble breathing having fruity-smelling breath fainting from dehydration having pain in your abdomen , nausea , or vomiting",`section`:"Type 1 diabetes symptoms",`section_context`:"What are the symptoms of diabetes? / Type 1 diabetes symptoms",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"aeac7c68d3026f951c540874eb8ca353066236362136f63a44d9a443644e4385"}) SET c += {`id`:"aeac7c68d3026f951c540874eb8ca353066236362136f63a44d9a443644e4385",`source_id`:"symptoms",`text`:"Certain medicines may harm the pancreas or affect the way insulin works in the body. Some of these medicines may include",`section`:"Taking certain medicines",`section_context`:"What else can cause diabetes? / Taking certain medicines",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"af300045439ab9644c0d3bfac8aa0a9b31baa6877bcb3e6df9b7742ff741f719"}) SET c += {`id`:"af300045439ab9644c0d3bfac8aa0a9b31baa6877bcb3e6df9b7742ff741f719",`source_id`:"management",`text`:"Talk with your health care team about any challenges you may have finding healthy food . A doctor, registered dietician, diabetes educator, or social worker may be able to recommend resources that can help you. The U.S. Department of Agriculture also provides a list of resources about affording healthy food and finding help from food assistance programs.",`section`:"Create a healthy meal plan",`section_context`:"How can a healthy lifestyle help manage my diabetes? / Create a healthy meal plan",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"risk"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`title`:"Risk Factors for Type 2 Diabetes",`publisher`:"NIDDK",`version`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114"} MERGE (c:DiabetesEvidence {id:"af4682d68e8a373b2b060f34c3aceaa5f44a3d52874251cd2bab8653ef0eea32"}) SET c += {`id`:"af4682d68e8a373b2b060f34c3aceaa5f44a3d52874251cd2bab8653ef0eea32",`source_id`:"risk",`text`:"You can develop type 2 diabetes at any age, even during childhood. You are more likely to develop type 2 diabetes if you 1 are overweight or have obesity . are age 35 or older. Children and teens can also develop type 2 diabetes, but the risk increases as a person gets older. have a family history of diabetes. are African American, American Indian, Asian American, Hispanic/Latino, or Pacific Islander. are not physically active, because of physical limitations, a sedentary lifestyle, or a job that requires sitting for long periods of time.",`section`:"What are the risk factors for type 2 diabetes?",`section_context`:"What are the risk factors for type 2 diabetes?",`title`:"Risk Factors for Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:48.116337+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114",`topics`:["diabetes","risk"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","risk"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"af8b2fec4f534a52622feb5e5ae6e17f07d9d0d16ffb1ffb5c9c30080b2be33e"}) SET c += {`id`:"af8b2fec4f534a52622feb5e5ae6e17f07d9d0d16ffb1ffb5c9c30080b2be33e",`source_id`:"tests",`text`:"Before the test, you will need to fast for at least 8 hours. A health care professional will take a blood sample to measure your glucose level after fasting. Next, you will drink a liquid that is high in sugar. Another blood sample is taken 2 hours later to check your blood glucose level. If your blood glucose level is high, you may have diabetes.",`section`:"Oral glucose tolerance test",`section_context`:"What tests are used to diagnose diabetes? / Oral glucose tolerance test",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"afb59f5aadb0cc8d2cfa2f1016f96102c07df2024fa74954218f030208790e2e"}) SET c += {`id`:"afb59f5aadb0cc8d2cfa2f1016f96102c07df2024fa74954218f030208790e2e",`source_id`:"living",`text`:"If you have diabetes, managing your weight may bring you several health benefits. Ask your health care professional or health care team if you are at a healthy weight or if you should try to lose weight.",`section`:"What can I do to reach or maintain a healthy weight?",`section_context`:"What can I do to reach or maintain a healthy weight?",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"b01ecbf0a2cff4d05072b62dcdb9de7aff6f47be35532bac54acb6514c8ded98"}) SET c += {`id`:"b01ecbf0a2cff4d05072b62dcdb9de7aff6f47be35532bac54acb6514c8ded98",`source_id`:"tests",`text`:"If you have gestational diabetes, you should get tested after your baby is born to see if you have type 2 diabetes, usually within 12 weeks after delivery.",`section`:"Gestational diabetes",`section_context`:"Who should be tested for diabetes? / Gestational diabetes",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"b0b8d22747d1b350f212ffc91e08dd773ed7c58ef99822f0c5bc1ff9b08538aa"}) SET c += {`id`:"b0b8d22747d1b350f212ffc91e08dd773ed7c58ef99822f0c5bc1ff9b08538aa",`source_id`:"foot",`text`:"Call your health care provider right away if you have a cut, blister, or bruise on your foot that does not start to heal after a few days skin on your foot that becomes red, warm, or painful—signs of a possible infection a callus with dried blood inside of it,which often can be the first sign of a wound under the callus a foot infection that becomes black and smelly—signs you might have gangrene",`section`:"When should I see my health care provider about foot problems?",`section_context`:"When should I see my health care provider about foot problems?",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"b19243dfe4191c36f3478f48a29a115942744d9485c677a691b87fe2891f65db"}) SET c += {`id`:"b19243dfe4191c36f3478f48a29a115942744d9485c677a691b87fe2891f65db",`source_id`:"management",`text`:"You may find it helpful to keep track of your ABCs and other important health information that you get during checkups with your primary care professional or other health care professionals. Download the Health Checkups Tracker (DOCX, 67.97 KB) , which includes information you may want to track. You can take this information with you when you visit your health care team. Talk with your primary care professional about your goals and whether you need to make any changes to your diabetes care plan.",`section`:"How can I keep track of my progress?",`section_context`:"How can I keep track of my progress?",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"b1e1b3eee85dd79b7325298a89a44ea2ec96b5d8a2591ee1a2224d2dc464cdfd"}) SET c += {`id`:"b1e1b3eee85dd79b7325298a89a44ea2ec96b5d8a2591ee1a2224d2dc464cdfd",`source_id`:"tests",`text`:"Doctors often diagnose type 1 diabetes in children and young adults when they have diabetes symptoms, such as feeling thirsty and having to urinate more often, or if they may have diabetic ketoacidosis . Symptoms in adults may be less specific. 1",`section`:"Type 1 diabetes",`section_context`:"Who should be tested for diabetes? / Type 1 diabetes",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"b1eb4f2d440eecfef5e74546ba8ae6e675023b349f3cb5d03baad02cd5f13394"}) SET c += {`id`:"b1eb4f2d440eecfef5e74546ba8ae6e675023b349f3cb5d03baad02cd5f13394",`source_id`:"living",`text`:"You should also limit how much alcohol you drink. If you take insulin or certain diabetes medicines , drinking alcohol can make your blood glucose level drop too low, which is called hypoglycemia . If you do drink alcohol, be sure to eat food when you drink and remember to check your blood glucose level after drinking. Talk with your health care team about your alcohol-drinking habits.",`section`:"Choose healthy foods and drinks",`section_context`:"How can I plan what to eat or drink when I have diabetes? / Choose healthy foods and drinks",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"b31cb244b6839a61ae723305ab7e726d8ca5bafe00e3276b26d7b2e9c1fac4ab"}) SET c += {`id`:"b31cb244b6839a61ae723305ab7e726d8ca5bafe00e3276b26d7b2e9c1fac4ab",`source_id`:"living",`text`:"Research shows that regular physical activity helps people manage their diabetes and stay healthy. Benefits of physical activity may include",`section`:"How can physical activity help manage my diabetes?",`section_context`:"How can physical activity help manage my diabetes?",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"b55862d0be69cd5d9388667f479daba767094492c9a1c007290f35cf9d5754ec"}) SET c += {`id`:"b55862d0be69cd5d9388667f479daba767094492c9a1c007290f35cf9d5754ec",`source_id`:"management",`text`:"You are the most important member of your health care team, but working with your health care team may help you improve your self-care. Most people with diabetes get help from a primary care professional, such as an internal medicine doctor, family doctor, pediatrician, physician assistant, or certified nurse practitioner trained in diabetes care.",`section`:"Who should be on my health care team?",`section_context`:"Who should be on my health care team?",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"b5ea7c0ad34486d4c8d94b6ef0f6e730747c11c62c95b4e1c14fdf930a423f88"}) SET c += {`id`:"b5ea7c0ad34486d4c8d94b6ef0f6e730747c11c62c95b4e1c14fdf930a423f88",`source_id`:"symptoms",`text`:"Symptoms of type 1 diabetes usually develop quickly, over a few days or weeks. Type 1 diabetes is often diagnosed in children and young adults, but it can begin at any age. Children with type 1 diabetes typically develop symptoms over a short period of time. Common symptoms of type diabetes in children include",`section`:"Type 1 diabetes symptoms",`section_context`:"What are the symptoms of diabetes? / Type 1 diabetes symptoms",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"b742bf8ceae912153d9fe804be17c5f9f6cc7662b0bbe18b068c52e7d07d4f91"}) SET c += {`id`:"b742bf8ceae912153d9fe804be17c5f9f6cc7662b0bbe18b068c52e7d07d4f91",`source_id`:"living",`text`:"If you can, try to do different types of physical activities. Start slowly with activities you enjoy.",`section`:"Do different types of physical activity",`section_context`:"How can physical activity help manage my diabetes? / Do different types of physical activity",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"b8606e2a574f1333a069859420661f263dceee469827f937d2388102a364b9d7"}) SET c += {`id`:"b8606e2a574f1333a069859420661f263dceee469827f937d2388102a364b9d7",`source_id`:"symptoms",`text`:"In addition to some of the common diabetes symptoms listed above, people with type 1 diabetes may also have an unexplained weight loss. Most people don’t know they have type 1 diabetes until they develop diabetes symptoms.",`section`:"Type 1 diabetes symptoms",`section_context`:"What are the symptoms of diabetes? / Type 1 diabetes symptoms",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"b8c69d19e71fecdbd24a10b2a19fc50d058e80673a5d2ec870e95c7fe9942cbf"}) SET c += {`id`:"b8c69d19e71fecdbd24a10b2a19fc50d058e80673a5d2ec870e95c7fe9942cbf",`source_id`:"eye",`text`:"Talk with your eye doctor if you have any of these symptoms.",`section`:"What are the symptoms of diabetic eye disease?",`section_context`:"What are the symptoms of diabetic eye disease?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"b96e61d745fd2099ce743c323bceb4255c581cf574ec2b53cb490cce52ca3636"}) SET c += {`id`:"b96e61d745fd2099ce743c323bceb4255c581cf574ec2b53cb490cce52ca3636",`source_id`:"type1",`text`:"Health care professionals may consider a pancreas transplant for people with type 1 diabetes who need a kidney transplant or who haven’t been able to manage their blood glucose levels in any other way. A pancreas transplant may restore normal blood glucose levels and prevent other diabetes-related health problems. After a pancreas transplant, you’ll take immunosuppressants to prevent the immune system from attacking and destroying the new pancreas.",`section`:"Pancreatic islet and pancreas transplant",`section_context`:"How can I manage type 1 diabetes? / Pancreatic islet and pancreas transplant",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"b9a0c9821e458b148f3d058ede2ce8183fd5fdf24d5938bed87afed20e465e18"}) SET c += {`id`:"b9a0c9821e458b148f3d058ede2ce8183fd5fdf24d5938bed87afed20e465e18",`source_id`:"symptoms",`text`:"are not physically active, because of a job that requires sitting for long periods of time or because of difficulty moving their body. smoke , including tobacco products and e-cigarettes , or are exposed to secondhand smoke . have prediabetes. have a history of gestational diabetes, a type of diabetes that develops during pregnancy, or gave birth to a baby weighing 9 pounds or more.",`section`:"What causes type 2 diabetes?",`section_context`:"What causes type 2 diabetes?",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"b9d48345e63352f8bc77fc05df5c902f6ada68ecfcf40de6eaabad3d1fd0092b"}) SET c += {`id`:"b9d48345e63352f8bc77fc05df5c902f6ada68ecfcf40de6eaabad3d1fd0092b",`source_id`:"living",`text`:"Talk with your health care professional or health care team about when you should eat or drink. The best time to have meals and snacks may depend on what medicines you take for diabetes what your level of physical activity or your work schedule is whether you have other health conditions or diseases",`section`:"Find the best times to eat or drink",`section_context`:"How can I plan what to eat or drink when I have diabetes? / Find the best times to eat or drink",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"definition"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`title`:"What Is Diabetes?",`publisher`:"NIDDK",`version`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1"} MERGE (c:DiabetesEvidence {id:"ba8ac1434169b8f8b6364dbfcc4d9fd6f239875425df045b889224d10b0b98f0"}) SET c += {`id`:"ba8ac1434169b8f8b6364dbfcc4d9fd6f239875425df045b889224d10b0b98f0",`source_id`:"definition",`text`:"Gestational diabetes is a type of diabetes that develops during pregnancy. Most of the time, this type of diabetes goes away after the baby is born. However, if you’ve had gestational diabetes, you have a higher chance of developing type 2 diabetes later in life. Sometimes diabetes diagnosed during pregnancy is type 2 diabetes.",`section`:"Gestational diabetes",`section_context`:"What are the different types of diabetes? / Gestational diabetes",`title`:"What Is Diabetes?",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.530017+00:00",`last_reviewed`:"Last Reviewed April 2023",`source_sha256`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1",`topics`:["diabetes","types"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","types"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"bb2c64e5ce771844604fc9e49b22fe875290d679a65de6ee6579a1cc4bee6ac4"}) SET c += {`id`:"bb2c64e5ce771844604fc9e49b22fe875290d679a65de6ee6579a1cc4bee6ac4",`source_id`:"prediabetes",`text`:"Insulin resistance is a condition in which your body doesn’t respond to insulin the way it should. Insulin is a hormone made by your pancreas . Insulin resistance can lead to increased blood glucose levels, also called blood sugar levels, and weight gain. People have prediabetes if they have blood glucose levels that are higher than normal but not high enough to be diagnosed as type 2 diabetes.",`section`:"What are insulin resistance and prediabetes?",`section_context`:"What are insulin resistance and prediabetes?",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"bbf1e10784500a30104f7afa90a7f258de745a398cd7e93287c36b48cf7c6e41"}) SET c += {`id`:"bbf1e10784500a30104f7afa90a7f258de745a398cd7e93287c36b48cf7c6e41",`source_id`:"living",`text`:"Strength training or resistance training may make your muscles and bones stronger. You can try lifting weights or doing other exercises such as wall pushups or arm raises. Try to do this kind of training two times a week. 1",`section`:"Do different types of physical activity",`section_context`:"How can physical activity help manage my diabetes? / Do different types of physical activity",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prevention"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`title`:"Preventing Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba"} MERGE (c:DiabetesEvidence {id:"bc06ca701d1592a7ec35bde2e613e498113185460280ba59b7e4a10e427999ec"}) SET c += {`id`:"bc06ca701d1592a7ec35bde2e613e498113185460280ba59b7e4a10e427999ec",`source_id`:"prevention",`text`:"Perhaps you have learned that you have a high chance of developing type 2 diabetes , the most common type of diabetes. You might be overweight or have a parent, brother, or sister with type 2 diabetes. Maybe you had gestational diabetes, which is diabetes that develops during pregnancy. These are just a few examples of factors that can raise your chances of developing type 2 diabetes .",`section`:"Preventing Type 2 Diabetes",`section_context`:"Preventing Type 2 Diabetes",`title`:"Preventing Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:49.393819+00:00",`last_reviewed`:"Last Reviewed November 2016",`source_sha256`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba",`topics`:["diabetes","prevention"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prevention"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"bc35d39ae20d35842c9ab28ace9da3ecc0124ab90ad341d1ed048b7c8d2a86c1"}) SET c += {`id`:"bc35d39ae20d35842c9ab28ace9da3ecc0124ab90ad341d1ed048b7c8d2a86c1",`source_id`:"symptoms",`text`:"You’re more likely to develop gestational diabetes if you have certain risk factors, such as having overweight or obesity gaining too much weight during pregnancy having a family history of gestational diabetes, type 2 diabetes, or both",`section`:"What causes gestational diabetes?",`section_context`:"What causes gestational diabetes?",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"bc54238bc9714c5b3a9fbdb70c4e0e726e53c35e3c5344a584e3be7cedb2a281"}) SET c += {`id`:"bc54238bc9714c5b3a9fbdb70c4e0e726e53c35e3c5344a584e3be7cedb2a281",`source_id`:"living",`text`:"In some cases, health care professionals may also recommend diabetes medicines that may help you lose weight, or weight-loss surgery, also called metabolic and bariatric surgery.",`section`:"How can I plan what to eat or drink when I have diabetes?",`section_context`:"How can I plan what to eat or drink when I have diabetes?",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"bc9a022bd647bac54df9a0bd7f1177badec77721eb7fdabd121e0e1fea99cf34"}) SET c += {`id`:"bc9a022bd647bac54df9a0bd7f1177badec77721eb7fdabd121e0e1fea99cf34",`source_id`:"prediabetes",`text`:"Health care professionals may not test for insulin resistance. The test for insulin resistance is primarily used only for research studies.",`section`:"How do health care professionals diagnose insulin resistance and prediabetes?",`section_context`:"How do health care professionals diagnose insulin resistance and prediabetes?",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"bcd548be5bea90e6ab917a3bdcc9ad8e080c046bdc7ceae843fba9e8f591f941"}) SET c += {`id`:"bcd548be5bea90e6ab917a3bdcc9ad8e080c046bdc7ceae843fba9e8f591f941",`source_id`:"type1",`text`:"Autoantibodies are proteins made by your immune system that attack healthy tissues and cells by mistake. If you have certain autoantibodies in your blood, you may have type 1 diabetes.",`section`:"Autoantibodies test",`section_context`:"How do health care professionals diagnose type 1 diabetes? / Autoantibodies test",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"bd088140cde669ac8731c4c2dce02129cc0ba3afb9be449b883c52e39d0687ae"}) SET c += {`id`:"bd088140cde669ac8731c4c2dce02129cc0ba3afb9be449b883c52e39d0687ae",`source_id`:"foot",`text`:"Have a foot doctor trim your toenails if you cannot see, feel, or reach your feet your toenails are thick or yellowed your nails curve and grow into the skin",`section`:"Trim your toenails straight across",`section_context`:"What can I do to keep my feet healthy? / Trim your toenails straight across",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"bd1c7feaa0c46fb317c44a7e03c710ddb574dccb0e55226f1a6e08516a4264b7"}) SET c += {`id`:"bd1c7feaa0c46fb317c44a7e03c710ddb574dccb0e55226f1a6e08516a4264b7",`source_id`:"foot",`text`:"Do NOT cut corns and calluses use corn plasters, which are medicated pads use liquid corn and callus removers",`section`:"Smooth corns and calluses gently",`section_context`:"What can I do to keep my feet healthy? / Smooth corns and calluses gently",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"bdc4ee2458a9b7d69a5bab27cc0c26ecb74425b09c3c29a8f5b9bf113e5cf237"}) SET c += {`id`:"bdc4ee2458a9b7d69a5bab27cc0c26ecb74425b09c3c29a8f5b9bf113e5cf237",`source_id`:"tests",`text`:"Don’t try to diagnose yourself if you think you might have diabetes. Blood testing equipment that you can buy over the counter, such as a blood glucose meter , cannot diagnose diabetes.",`section`:"Diabetes Tests & Diagnosis",`section_context`:"Diabetes Tests & Diagnosis",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"bdeb0c8005fca5e8835f380e93c5370d63bf6c7659b2db265f886a7a6f2ed781"}) SET c += {`id`:"bdeb0c8005fca5e8835f380e93c5370d63bf6c7659b2db265f886a7a6f2ed781",`source_id`:"type1",`text`:"Symptoms of type 1 diabetes may include increased urination feeling very thirsty feeling very hungry, even after you’ve eaten blurred vision fatigue sores that don’t heal frequent infections, such as urinary tract infections , skin infections , or yeast infections unexplained weight loss",`section`:"What are the symptoms of type 1 diabetes?",`section_context`:"What are the symptoms of type 1 diabetes?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"be1e81a41730d6cb29863a8795c879ec927c699d09eca404fa1de45721d9cd52"}) SET c += {`id`:"be1e81a41730d6cb29863a8795c879ec927c699d09eca404fa1de45721d9cd52",`source_id`:"prediabetes",`text`:"If you have health problems related to insulin resistance and prediabetes , your health care professional may prescribe other medicines, such as medicines to lower blood pressure or triglyceride levels.",`section`:"Medicines for insulin resistance and prediabetes",`section_context`:"How can I prevent or reverse insulin resistance and prediabetes? / Medicines for insulin resistance and prediabetes",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"be704ee331ca8988fa119612b6b48f9aadb190fa1fef7f395f2567c74b2a4018"}) SET c += {`id`:"be704ee331ca8988fa119612b6b48f9aadb190fa1fef7f395f2567c74b2a4018",`source_id`:"symptoms",`text`:"Symptoms of type 1 diabetes usually develop quickly, over a few days or weeks. Type 1 diabetes is often diagnosed in children and young adults, but it can begin at any age. Children with type 1 diabetes typically develop symptoms over a short period of time. Common symptoms of type diabetes in children include having to urinate more often eating more but losing weight feeling very thirsty",`section`:"Type 1 diabetes symptoms",`section_context`:"What are the symptoms of diabetes? / Type 1 diabetes symptoms",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"beb07f25f5d9f34c6cf54dcfa538d6a5355b8d8268e313313d93d81939f46de2"}) SET c += {`id`:"beb07f25f5d9f34c6cf54dcfa538d6a5355b8d8268e313313d93d81939f46de2",`source_id`:"living",`text`:"If you are pregnant , trying to lose weight may not be healthy. However, you should ask your health care professional whether it makes sense to monitor or limit your weight gain during pregnancy.",`section`:"What can I do to reach or maintain a healthy weight?",`section_context`:"What can I do to reach or maintain a healthy weight?",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"bf1c72bce485ca955a712a2800203b72e709320999d9e5a2db424802d6fd5812"}) SET c += {`id`:"bf1c72bce485ca955a712a2800203b72e709320999d9e5a2db424802d6fd5812",`source_id`:"eye",`text`:"Symptoms depend on which type of glaucoma you have. Learn more about glaucoma .",`section`:"Glaucoma",`section_context`:"How does diabetes affect my eyes? / Glaucoma",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"bf2dd299a56ebceae407f90d5a28bf7ab6acabcffe8b93dfd5b2a2638f76cb0d"}) SET c += {`id`:"bf2dd299a56ebceae407f90d5a28bf7ab6acabcffe8b93dfd5b2a2638f76cb0d",`source_id`:"prediabetes",`text`:"Some people with prediabetes may have changes in their blood vessels . Changes in your blood vessels can lead to some of the same health problems caused by type 2 diabetes.",`section`:"What health problems can people with insulin resistance and prediabetes develop?",`section_context`:"What health problems can people with insulin resistance and prediabetes develop?",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"c0719fc4fc123e286f1edabf4eb706dd926f5b5d27e39dc3ca0743d13e67fb8f"}) SET c += {`id`:"c0719fc4fc123e286f1edabf4eb706dd926f5b5d27e39dc3ca0743d13e67fb8f",`source_id`:"management",`text`:"Cholesterol is a fat, also called lipid, that is produced by your liver. Unhealthy levels of cholesterol in your blood can build up and clog your blood vessels, which may result in a heart attack or a stroke. Ask your health care team how often you need a cholesterol test , also called a lipid panel, and what your cholesterol level should be. Some people may need to take a medicine called a statin , or another medicine, to lower their cholesterol for heart health.",`section`:"C is for cholesterol",`section_context`:"What are the diabetes ABCs? / C is for cholesterol",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"neuropathy"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/nerve-damage-diabetic-neuropathies",`title`:"Diabetic Neuropathy",`publisher`:"NIDDK",`version`:"66214ea6f35f8b8a45f96550a4cc6c1101fa8e41650833491e65c7370e991455"} MERGE (c:DiabetesEvidence {id:"c1c6fe1de694c9b2d6b1ccc82a3dadee0e0636e17e93bbd18d88fb8ac4f547bb"}) SET c += {`id`:"c1c6fe1de694c9b2d6b1ccc82a3dadee0e0636e17e93bbd18d88fb8ac4f547bb",`source_id`:"neuropathy",`text`:"Peripheral neuropathy is a type of nerve damage that typically affects the feet and legs and sometimes affects the hands and arms. This type of neuropathy is very common. About one-third to one-half of people with diabetes have peripheral neuropathy.",`section`:"Peripheral Neuropathy",`section_context`:"Peripheral Neuropathy",`title`:"Diabetic Neuropathy",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/nerve-damage-diabetic-neuropathies",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:59.657648+00:00",`last_reviewed`:"Last Reviewed February 2018",`source_sha256`:"66214ea6f35f8b8a45f96550a4cc6c1101fa8e41650833491e65c7370e991455",`topics`:["diabetes","complications","neuropathy"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","neuropathy"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"c2bc18752eea36f1702feb11fdd8a4187c9005bb501b75cffb5e2a4ca5305332"}) SET c += {`id`:"c2bc18752eea36f1702feb11fdd8a4187c9005bb501b75cffb5e2a4ca5305332",`source_id`:"eye",`text`:"The best ways to manage your diabetes and keep your eyes healthy are to manage your blood glucose , blood pressure , and cholesterol , sometimes called the diabetes ABCs If you smoke, get help to quit smoking have a dilated eye exam once a year",`section`:"What is diabetic eye disease?",`section_context`:"What is diabetic eye disease?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"c3e20bfcd6b2406f0cb3ed2de9e2f39a1a88c7820e4750903c56175df6fc672d"}) SET c += {`id`:"c3e20bfcd6b2406f0cb3ed2de9e2f39a1a88c7820e4750903c56175df6fc672d",`source_id`:"prediabetes",`text`:"Most often, health care professionals recommend lifestyle changes that may help you lose excess weight safely and keep it off. In some cases, weight-loss medicines or weight-loss surgery , also called metabolic and bariatric surgery, can be helpful.",`section`:"Managing your weight",`section_context`:"How can I prevent or reverse insulin resistance and prediabetes? / Managing your weight",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"c3e4534c7370d27ff23086b503759ab818f0a9fae8f25df34afa961bcf262948"}) SET c += {`id`:"c3e4534c7370d27ff23086b503759ab818f0a9fae8f25df34afa961bcf262948",`source_id`:"tests",`text`:"Anyone who has symptoms of diabetes should be tested for the disease. Some people will not have any symptoms but may have risk factors for type 2 diabetes and need to be tested. Most pregnant women should also be tested for gestational diabetes. Testing helps doctors find diabetes sooner, so they can work with their patients to manage the disease and prevent health problems .",`section`:"Who should be tested for diabetes?",`section_context`:"Who should be tested for diabetes?",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"c3e780847134937e797594370ce2357bb316c1ad1bf1fe1343b0c0c97b7516a1"}) SET c += {`id`:"c3e780847134937e797594370ce2357bb316c1ad1bf1fe1343b0c0c97b7516a1",`source_id`:"tests",`text`:"In this section: Who should be tested for diabetes? What tests are used to diagnose diabetes? What test results tell me if I have diabetes or prediabetes? Which tests help my doctor know what kind of diabetes I have?",`section`:"Diabetes Tests & Diagnosis",`section_context`:"Diabetes Tests & Diagnosis",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"risk"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`title`:"Risk Factors for Type 2 Diabetes",`publisher`:"NIDDK",`version`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114"} MERGE (c:DiabetesEvidence {id:"c49138727825e9ef012507e9f38d4c18f6aec5137046809c9ff9b206286955d3"}) SET c += {`id`:"c49138727825e9ef012507e9f38d4c18f6aec5137046809c9ff9b206286955d3",`source_id`:"risk",`text`:"Your chances of developing type 2 diabetes depend on a combination of risk factors. Although you can’t change risk factors related to family history, age, race, or ethnicity, you may be able to avoid some risk factors by maintaining a healthy weight and being physically active. 1",`section`:"Risk Factors for Type 2 Diabetes",`section_context`:"Risk Factors for Type 2 Diabetes",`title`:"Risk Factors for Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:48.116337+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114",`topics`:["diabetes","risk"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","risk"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type2"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`title`:"Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9"} MERGE (c:DiabetesEvidence {id:"c4f1bd9c496b1af03a960c9fd348246a6bdd8c3d6112ff2687938233c52258ae"}) SET c += {`id`:"c4f1bd9c496b1af03a960c9fd348246a6bdd8c3d6112ff2687938233c52258ae",`source_id`:"type2",`text`:"Symptoms of type 2 diabetes often develop slowly—over the course of several years—and can be so mild that you might not even notice them. Many people have no symptoms. Some people do not find out they have the disease until they have diabetes-related health problems, such as blurred vision or heart disease .",`section`:"What are the symptoms of diabetes?",`section_context`:"What are the symptoms of diabetes?",`title`:"Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:56.897529+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9",`topics`:["diabetes","type2","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type2","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"c5c28f089e186788376494ab1bc53bd609c7807cf0489e31aeb8d91baff46996"}) SET c += {`id`:"c5c28f089e186788376494ab1bc53bd609c7807cf0489e31aeb8d91baff46996",`source_id`:"foot",`text`:"Work with your health care team to make a diabetes self-care plan, which is an action plan for how you will manage your diabetes. Your plan should include foot care. A foot doctor, also called a podiatrist, and other specialists may be part of your health care team.",`section`:"What can I do to keep my feet healthy?",`section_context`:"What can I do to keep my feet healthy?",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"c6a9d17038d71df03164e0a03bb9fea7ef0b0c10f787e54331225f85f8aeb0da"}) SET c += {`id`:"c6a9d17038d71df03164e0a03bb9fea7ef0b0c10f787e54331225f85f8aeb0da",`source_id`:"foot",`text`:"You may have foot problems, but feel no pain in your feet. Checking your feet each day will help you spot problems early before they get worse. A good way to remember is to check your feet each evening when you take off your shoes. Also check between your toes. If you have trouble bending over to see your feet, try using a mirror to see them, or ask someone else to look at your feet.",`section`:"Check your feet every day",`section_context`:"What can I do to keep my feet healthy? / Check your feet every day",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type2"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`title`:"Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9"} MERGE (c:DiabetesEvidence {id:"c77e5f5eafc2796b6acd513c578b525a4029c763c3949bc9499ff5be05962f5c"}) SET c += {`id`:"c77e5f5eafc2796b6acd513c578b525a4029c763c3949bc9499ff5be05962f5c",`source_id`:"type2",`text`:"Your health care professional can diagnose type 2 diabetes based on blood tests. Learn more about blood tests for diabetes and what the results mean.",`section`:"How do health care professionals diagnose type 2 diabetes?",`section_context`:"How do health care professionals diagnose type 2 diabetes?",`title`:"Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:56.897529+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9",`topics`:["diabetes","type2","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type2","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"c7c9b6ffc54202101a9f18f3f30d4ab02526056613d0682a122872307f3f6ca8"}) SET c += {`id`:"c7c9b6ffc54202101a9f18f3f30d4ab02526056613d0682a122872307f3f6ca8",`source_id`:"type1",`text`:"The stress of managing type 1 diabetes can make some people more likely to develop sleep problems , anxiety , or depression . You may find it helpful to speak with a counselor or your primary health care professional about your mental health. Your primary health care professional may be a doctor, physician assistant, or nurse practitioner.",`section`:"Mental health conditions",`section_context`:"What health problems can people with type 1 diabetes develop? / Mental health conditions",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"c7ca8851683630a94027bc225e44662ec0610b06fa7edff1f2bca5acc5bb9b98"}) SET c += {`id`:"c7ca8851683630a94027bc225e44662ec0610b06fa7edff1f2bca5acc5bb9b98",`source_id`:"type1",`text`:"Type 1 diabetes develops when the body’s immune system destroys the cells in the pancreas that make insulin. These cells are called beta cells. Genes and factors in the environment—the place where people live, play, work, study, and gather—may trigger the immune system to destroy beta cells in type 1 diabetes.",`section`:"What causes type 1 diabetes?",`section_context`:"What causes type 1 diabetes?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"c8737eef44a7a6a13680f83d9df4901b9f2a1b7a5f0082bab5d19d16945d5029"}) SET c += {`id`:"c8737eef44a7a6a13680f83d9df4901b9f2a1b7a5f0082bab5d19d16945d5029",`source_id`:"symptoms",`text`:"People with a history of gestational diabetes are at higher risk of developing type 2 diabetes later in life. If you have a history of gestational diabetes, your health care professional may recommend regular testing for type 2 diabetes.",`section`:"Gestational diabetes symptoms",`section_context`:"What are the symptoms of diabetes? / Gestational diabetes symptoms",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"c8b909bdb5bbc0d66ff8332e1d55d86c4f8fc65ffe531803d0f74ddca6777258"}) SET c += {`id`:"c8b909bdb5bbc0d66ff8332e1d55d86c4f8fc65ffe531803d0f74ddca6777258",`source_id`:"tests",`text`:"Even though the tests described above can confirm you have diabetes, they can’t identify what type you have—type 1, type 2, or a rare type of diabetes called monogenic diabetes. Treatment can depend on the type of diabetes you have, so knowing which type you have is important.",`section`:"Which tests help my doctor know what kind of diabetes I have?",`section_context`:"Which tests help my doctor know what kind of diabetes I have?",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"c91bf4b95369c2d4d0a3b7dfa9da901817fdf34ee962a78d3d66b96f784e497e"}) SET c += {`id`:"c91bf4b95369c2d4d0a3b7dfa9da901817fdf34ee962a78d3d66b96f784e497e",`source_id`:"eye",`text`:"The sooner you work to manage your diabetes and other health conditions, the better. And, even if you’ve struggled in the past to manage your health, taking better care of yourself now can protect your eyes for the future. It’s never too late to begin.",`section`:"What can I do to protect my eyes?",`section_context`:"What can I do to protect my eyes?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"ca14331a4e6a953425cf65221d4a9f7079c2d62e71790b3a475d4e8a2cba9209"}) SET c += {`id`:"ca14331a4e6a953425cf65221d4a9f7079c2d62e71790b3a475d4e8a2cba9209",`source_id`:"prediabetes",`text`:"Some people with prediabetes may have changes in their blood vessels . Changes in your blood vessels can lead to some of the same health problems caused by type 2 diabetes. People with insulin resistance and prediabetes can also develop other health problems, including",`section`:"What health problems can people with insulin resistance and prediabetes develop?",`section_context`:"What health problems can people with insulin resistance and prediabetes develop?",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"ca6288995e260d6cb1dcfe7b7507f0d7526756f04dcb56e5f2528925dd9b4c15"}) SET c += {`id`:"ca6288995e260d6cb1dcfe7b7507f0d7526756f04dcb56e5f2528925dd9b4c15",`source_id`:"management",`text`:"On this page: What are the diabetes ABCs? How can a healthy lifestyle help manage my diabetes? What types of medicines should I take? How can I check my blood glucose level at home? How can I keep track of my progress? What special situations should I plan for? Who should be on my health care team? Clinical Trials for Managing Diabetes",`section`:"Managing Diabetes",`section_context`:"Managing Diabetes",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type2"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`title`:"Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9"} MERGE (c:DiabetesEvidence {id:"ca7018a2642b80e1582f41442190762e3c7a55b045b10b2fa4bdb5c26bd25e92"}) SET c += {`id`:"ca7018a2642b80e1582f41442190762e3c7a55b045b10b2fa4bdb5c26bd25e92",`source_id`:"type2",`text`:"Learn more about the causes of type 2 diabetes .",`section`:"What causes type 2 diabetes?",`section_context`:"What causes type 2 diabetes?",`title`:"Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:56.897529+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9",`topics`:["diabetes","type2","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type2","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"cc00dabb2b5a72e74d83202c0464925ac47fce88c731077a0310db8c67c622e3"}) SET c += {`id`:"cc00dabb2b5a72e74d83202c0464925ac47fce88c731077a0310db8c67c622e3",`source_id`:"eye",`text`:"If your blood glucose stays high over time, it can damage the tiny blood vessels in the back of your eyes. This damage can begin during prediabetes , when blood glucose is higher than normal, but not high enough for you to be diagnosed with diabetes. Damaged blood vessels may leak fluid and cause swelling. New, weak blood vessels may also begin to grow. These blood vessels can bleed into the middle part of the eye, lead to scarring, or cause dangerously high pressure inside your eye.",`section`:"How does diabetes affect my eyes?",`section_context`:"How does diabetes affect my eyes?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prevention"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`title`:"Preventing Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba"} MERGE (c:DiabetesEvidence {id:"cc939650ed1699b5bc460ec0f5e3b307bc2e818459331296f05533a0a7a7574d"}) SET c += {`id`:"cc939650ed1699b5bc460ec0f5e3b307bc2e818459331296f05533a0a7a7574d",`source_id`:"prevention",`text`:"If you have not been active, talk with your health care professional about which activities are best. Start slowly to build up to your goal. Eat healthy foods most of the time. Eat smaller portions to reduce the amount of calories you eat each day and help you lose weight. Choosing foods with less fat is another way to reduce calories. Drink water instead of sweetened beverages.",`section`:"How can I lower my chances of developing type 2 diabetes?",`section_context`:"How can I lower my chances of developing type 2 diabetes?",`title`:"Preventing Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:49.393819+00:00",`last_reviewed`:"Last Reviewed November 2016",`source_sha256`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba",`topics`:["diabetes","prevention"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prevention"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"ccbc6be96c2b3b6c105bf6bfc74cd65868b3b62dac42d32f21143290dd063c06"}) SET c += {`id`:"ccbc6be96c2b3b6c105bf6bfc74cd65868b3b62dac42d32f21143290dd063c06",`source_id`:"eye",`text`:"Laser treatment, also called photocoagulation, creates tiny burns inside the eye with a beam of light. This method treats leaky blood vessels and extra fluid, called edema. Your doctor usually provides this treatment during several office visits, using medicine to numb your eyes. Laser treatment can keep eye disease from getting worse, which is important to prevent vision loss or blindness. But laser treatment is less likely to bring back vision you’ve already lost compared with anti-VEGF medicines.",`section`:"Laser Treatment",`section_context`:"How do doctors treat diabetic eye disease? / Laser Treatment",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"ccd0474fc23e501ab4f979f9bbf362c26378d4cbb48d2dc0570932691f4685e2"}) SET c += {`id`:"ccd0474fc23e501ab4f979f9bbf362c26378d4cbb48d2dc0570932691f4685e2",`source_id`:"prediabetes",`text`:"Health care professionals begin to test children who have overweight or obesity when they’re age 10 or have reached puberty.",`section`:"How do health care professionals diagnose insulin resistance and prediabetes?",`section_context`:"How do health care professionals diagnose insulin resistance and prediabetes?",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"cd7bb6d732e425e108b2d3d7c8c9c4c7cdf17123385afb4275093be87b715352"}) SET c += {`id`:"cd7bb6d732e425e108b2d3d7c8c9c4c7cdf17123385afb4275093be87b715352",`source_id`:"symptoms",`text`:"Type 1 diabetes develops when the body’s immune system destroys the cells in the pancreas that make insulin. These cells are called beta cells. Genes and factors in the environment—the places where people live, play, work, study, and gather—may trigger the immune system to destroy beta cells in type 1 diabetes.",`section`:"What causes type 1 diabetes?",`section_context`:"What causes type 1 diabetes?",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"cdebf42d406b0202c1778940e07eadac6aae249b8386ddd9c61b077897c4f2a1"}) SET c += {`id`:"cdebf42d406b0202c1778940e07eadac6aae249b8386ddd9c61b077897c4f2a1",`source_id`:"living",`text`:"If you smoke or use other tobacco products, stop. Ask for help . You don’t have to do it alone.",`section`:"Should I quit smoking?",`section_context`:"Should I quit smoking?",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"cdee68b35fa82d9a2e4b3c96f1f98b595ee58e45bb026c7a307e675c3e2b9cce"}) SET c += {`id`:"cdee68b35fa82d9a2e4b3c96f1f98b595ee58e45bb026c7a307e675c3e2b9cce",`source_id`:"type1",`text`:"Hypoglycemia unawareness is a medical emergency that needs to be treated right away. That’s because hypoglycemia unawareness can cause problems with thinking and other brain functions and, if not treated, may lead to a coma .",`section`:"Hypoglycemia unawareness",`section_context`:"What health problems can people with type 1 diabetes develop? / Hypoglycemia unawareness",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"ced24d01f34cb7fe9c7444423858b386bde49cacc2e5007935576fda4cc1c3bf"}) SET c += {`id`:"ced24d01f34cb7fe9c7444423858b386bde49cacc2e5007935576fda4cc1c3bf",`source_id`:"eye",`text`:"Over time, diabetes can cause damage to your eyes that can lead to poor vision or even blindness. But you can take steps to prevent diabetic eye disease, or keep it from getting worse, by taking care of your diabetes.",`section`:"What is diabetic eye disease?",`section_context`:"What is diabetic eye disease?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"cf2c648a31cc90e84b58c99b4fbb8b6d127e6d4f14560dd7f988315cbd39f6bb"}) SET c += {`id`:"cf2c648a31cc90e84b58c99b4fbb8b6d127e6d4f14560dd7f988315cbd39f6bb",`source_id`:"type1",`text`:"Symptoms of type 1 diabetes usually develop quickly, over a few days or weeks. Children with type 1 diabetes typically develop symptoms over a short period of time. Common symptoms in children include having to urinate more often eating more but losing weight feeling very thirsty",`section`:"What are the symptoms of type 1 diabetes?",`section_context`:"What are the symptoms of type 1 diabetes?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"d0d890472d80715f5582f6705eae7a89df6ad2952f2c4700943a1eb756999dad"}) SET c += {`id`:"d0d890472d80715f5582f6705eae7a89df6ad2952f2c4700943a1eb756999dad",`source_id`:"foot",`text`:"Wear shoes that fit well and protect your feet. Here are some tips for finding the right type of shoes:",`section`:"Wear shoes and socks at all times",`section_context`:"What can I do to keep my feet healthy? / Wear shoes and socks at all times",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"d11fceb4b311045a41a25ca87f05ce11270219a2b420e048f620d5242cbd2a06"}) SET c += {`id`:"d11fceb4b311045a41a25ca87f05ce11270219a2b420e048f620d5242cbd2a06",`source_id`:"type1",`text`:"People with type 1 diabetes also have a higher risk of developing a condition called diabetic ketoacidosis (DKA) . When you have type 1 diabetes, your body doesn’t have enough insulin to use blood glucose for energy. Your body will begin to use fat as a source of energy instead. This process produces substances called ketones . High levels of ketones can cause DKA. People have a higher risk of developing DKA when they have an infection or when they’re under stress . DKA is a medical emergency that needs to be treated right away.",`section`:"Diabetic ketoacidosis",`section_context`:"What health problems can people with type 1 diabetes develop? / Diabetic ketoacidosis",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type2"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`title`:"Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9"} MERGE (c:DiabetesEvidence {id:"d13aa532e72500b61ec7f03028455c432bf07125e456a4c1e612c3b1e7f6fcac"}) SET c += {`id`:"d13aa532e72500b61ec7f03028455c432bf07125e456a4c1e612c3b1e7f6fcac",`source_id`:"type2",`text`:"Type 2 diabetes is caused by several factors, including",`section`:"What causes type 2 diabetes?",`section_context`:"What causes type 2 diabetes?",`title`:"Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:56.897529+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9",`topics`:["diabetes","type2","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type2","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"d15cc59ab29311d23684bc83c5f25f1fa3f5eb72b7eec7f5566f461694fd488c"}) SET c += {`id`:"d15cc59ab29311d23684bc83c5f25f1fa3f5eb72b7eec7f5566f461694fd488c",`source_id`:"symptoms",`text`:"Statins, which are medicines to reduce LDL (“bad”) cholesterol levels, can slightly increase the chance that you’ll develop diabetes. However, statins help protect you from heart disease and stroke . For this reason, the strong benefits of taking statins outweigh the small chance that you could develop diabetes.",`section`:"Taking certain medicines",`section_context`:"What else can cause diabetes? / Taking certain medicines",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"d35999542065044597a459277a0fd2fc60c35b1d39c235e72c75c115e1cb2856"}) SET c += {`id`:"d35999542065044597a459277a0fd2fc60c35b1d39c235e72c75c115e1cb2856",`source_id`:"symptoms",`text`:"Type 2 diabetes is the most common form of diabetes. Type 2 diabetes develops when your pancreas doesn’t produce enough insulin, and your body has trouble using insulin, a condition called insulin resistance . Insulin resistance is when the cells in your muscles, fat, and liver don’t respond well to insulin. When there isn’t enough insulin to balance blood glucose levels, they begin to rise.",`section`:"What causes type 2 diabetes?",`section_context`:"What causes type 2 diabetes?",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"d431a2c08678822068b95413610a0d751f8c84183d20e7c5b77c5118a6e2e941"}) SET c += {`id`:"d431a2c08678822068b95413610a0d751f8c84183d20e7c5b77c5118a6e2e941",`source_id`:"symptoms",`text`:"There are different types of diabetes. People with any type of diabetes can have these symptoms. Some other symptoms, and how quickly the symptoms develop, depend on the type of diabetes that you have. Talk with your primary health care professional about any symptoms you are having and ask if you should be tested for diabetes . Your primary health care professional may be a doctor, physician assistant, or nurse practitioner.",`section`:"What are the symptoms of diabetes?",`section_context`:"What are the symptoms of diabetes?",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"d638ca8632487399dc4e6c3f310f62e6d6703f3ce67a802d6f891af8fd9e6b0e"}) SET c += {`id`:"d638ca8632487399dc4e6c3f310f62e6d6703f3ce67a802d6f891af8fd9e6b0e",`source_id`:"living",`text`:"High levels of ketones in your blood can lead to a condition called diabetic ketoacidosis (DKA) . DKA is a medical emergency that should be treated right away. DKA is most common in people with type 1 diabetes . Occasionally, DKA may affect people with type 2 diabetes who have lost their ability to produce insulin. Ask your health care professional how much insulin you should take before physical activity, whether you need to test your urine for ketones, and what level of ketones is dangerous for you.",`section`:"Stay safe during physical activity",`section_context`:"How can physical activity help manage my diabetes? / Stay safe during physical activity",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"definition"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`title`:"What Is Diabetes?",`publisher`:"NIDDK",`version`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1"} MERGE (c:DiabetesEvidence {id:"d67f70874bd7994c3e17c7a755b9a470018f6134650044dd176e9fcbe625c229"}) SET c += {`id`:"d67f70874bd7994c3e17c7a755b9a470018f6134650044dd176e9fcbe625c229",`source_id`:"definition",`text`:"About 90% to 95% of diabetes cases are type 2 diabetes. 3",`section`:"How common are diabetes and prediabetes?",`section_context`:"How common are diabetes and prediabetes?",`title`:"What Is Diabetes?",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.530017+00:00",`last_reviewed`:"Last Reviewed April 2023",`source_sha256`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1",`topics`:["diabetes","types"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","types"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prevention"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`title`:"Preventing Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba"} MERGE (c:DiabetesEvidence {id:"d7143ad2a7d10a823152cfde87d868c58dabf84c0d79bc7a321e7b0229be5c8c"}) SET c += {`id`:"d7143ad2a7d10a823152cfde87d868c58dabf84c0d79bc7a321e7b0229be5c8c",`source_id`:"prevention",`text`:"Ask your health care professional about what other changes you can make to prevent or delay type 2 diabetes.",`section`:"How can I lower my chances of developing type 2 diabetes?",`section_context`:"How can I lower my chances of developing type 2 diabetes?",`title`:"Preventing Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:49.393819+00:00",`last_reviewed`:"Last Reviewed November 2016",`source_sha256`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba",`topics`:["diabetes","prevention"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prevention"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"d861f93d341ca646280f449fb7e77aa378649cdededad68aaf9c694fe3117c8b"}) SET c += {`id`:"d861f93d341ca646280f449fb7e77aa378649cdededad68aaf9c694fe3117c8b",`source_id`:"symptoms",`text`:"Symptoms of type 2 diabetes can develop slowly, over several years. Many people with type 2 diabetes have no symptoms, or symptoms can be so mild that people might not even notice them. In addition to the common symptoms of diabetes listed above, people may find out they have type 2 diabetes when they develop symptoms of other health problems from diabetes . These include pain, numbness, or tingling in the feet or hands sexual problems chest pain vision loss",`section`:"Type 2 diabetes symptoms",`section_context`:"What are the symptoms of diabetes? / Type 2 diabetes symptoms",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"definition"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`title`:"What Is Diabetes?",`publisher`:"NIDDK",`version`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1"} MERGE (c:DiabetesEvidence {id:"d90c0314449d5bdba11d65092085231854c90f8676e0bdb2ad1f2fb0aac00fe9"}) SET c += {`id`:"d90c0314449d5bdba11d65092085231854c90f8676e0bdb2ad1f2fb0aac00fe9",`source_id`:"definition",`text`:"The most common types of diabetes are type 1, type 2, and gestational diabetes.",`section`:"What are the different types of diabetes?",`section_context`:"What are the different types of diabetes?",`title`:"What Is Diabetes?",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.530017+00:00",`last_reviewed`:"Last Reviewed April 2023",`source_sha256`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1",`topics`:["diabetes","types"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","types"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"da7daf643d9aec3e68a1a50355379a6756048c742f26fc163edabdd739ab0af9"}) SET c += {`id`:"da7daf643d9aec3e68a1a50355379a6756048c742f26fc163edabdd739ab0af9",`source_id`:"tests",`text`:"If you have Medicare, it may cover the cost of tests if you have certain risk factors for diabetes. If you have different insurance, ask your insurance company if it covers diabetes tests.",`section`:"Who should be tested for diabetes?",`section_context`:"Who should be tested for diabetes?",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"gestational"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/gestational",`title`:"Gestational Diabetes",`publisher`:"NIDDK",`version`:"1841d78cf7d6313e8d45385c1bbec6ee62a83095a5dfc71de54228f8f11e02de"} MERGE (c:DiabetesEvidence {id:"db4348eb6f6f29c02755c55e62d8c026856b4e09189cf0cdadee504607e9b9bf"}) SET c += {`id`:"db4348eb6f6f29c02755c55e62d8c026856b4e09189cf0cdadee504607e9b9bf",`source_id`:"gestational",`text`:"You can lower your chance of getting gestational diabetes by losing extra weight before you get pregnant if you are overweight. Being physically active before and during pregnancy also may help prevent gestational diabetes.",`section`:"Prevention",`section_context`:"Prevention",`title`:"Gestational Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/gestational",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:58.409138+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"1841d78cf7d6313e8d45385c1bbec6ee62a83095a5dfc71de54228f8f11e02de",`topics`:["diabetes","gestational"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","gestational"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"dcaae560f2eee4c96905b798c898a27f20f2d275f1210e47240a731d9d6f5c1f"}) SET c += {`id`:"dcaae560f2eee4c96905b798c898a27f20f2d275f1210e47240a731d9d6f5c1f",`source_id`:"prediabetes",`text`:"Certain factors can increase your chances of developing insulin resistance or prediabetes, including 2 having overweight, obesity , or a large waist size. being age 35 or older. Children and teens can also develop insulin resistance and prediabetes, but the risk goes up as a person gets older. having a family history of diabetes. being African American, American Indian, Asian American, Hispanic, Latino, or Pacific Islander. not being physically active. smoking , including tobacco products and e-cigarettes, or being exposed to secondhand smoke.",`section`:"Who is more likely to develop insulin resistance or prediabetes?",`section_context`:"Who is more likely to develop insulin resistance or prediabetes?",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"dcb930949a2a5081d61bd6379cbc2b9ef207256df43d01c81ef823e8c48f257c"}) SET c += {`id`:"dcb930949a2a5081d61bd6379cbc2b9ef207256df43d01c81ef823e8c48f257c",`source_id`:"living",`text`:"Balance and stretching activities may help you move better and have stronger muscles and bones. You may want to try standing on one leg or stretching your legs when sitting on the floor. Try to do these kinds of activities two or three times a week. 1",`section`:"Do different types of physical activity",`section_context`:"How can physical activity help manage my diabetes? / Do different types of physical activity",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"ddbf2da0cedd8d5934d845c56c69ef7cf26d3322310fe1926392f904cd6c5dc2"}) SET c += {`id`:"ddbf2da0cedd8d5934d845c56c69ef7cf26d3322310fe1926392f904cd6c5dc2",`source_id`:"living",`text`:"Try to choose foods that include nutrients such as vitamins, calcium, fiber, and healthy fats.",`section`:"Choose healthy foods and drinks",`section_context`:"How can I plan what to eat or drink when I have diabetes? / Choose healthy foods and drinks",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"de58e0288efedcf5768e4c131a5296aacb177197117e5f49b807b4e3d326822a"}) SET c += {`id`:"de58e0288efedcf5768e4c131a5296aacb177197117e5f49b807b4e3d326822a",`source_id`:"eye",`text`:"Glaucoma is a group of eye diseases that can damage the optic nerve—the bundle of nerves that connects the eye to the brain. Diabetes doubles the chances of having glaucoma, which can lead to vision loss and blindness if not treated early.",`section`:"Glaucoma",`section_context`:"How does diabetes affect my eyes? / Glaucoma",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"de5f650d5afffdb173b8f69187fa8412dd068a3590b53d57d058db4b20509cab"}) SET c += {`id`:"de5f650d5afffdb173b8f69187fa8412dd068a3590b53d57d058db4b20509cab",`source_id`:"symptoms",`text`:"Gestational diabetes is a type of diabetes that may develop when you are pregnant. Most people with this type of diabetes have no symptoms. If you do have symptoms of gestational diabetes, they may be mild, such as being thirstier than usual or having to urinate more often.",`section`:"Gestational diabetes symptoms",`section_context`:"What are the symptoms of diabetes? / Gestational diabetes symptoms",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type2"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`title`:"Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9"} MERGE (c:DiabetesEvidence {id:"de8128fc2bdb2314cb248bc77f39e817d4c8fc70012e47b990d27ba96ee6d02d"}) SET c += {`id`:"de8128fc2bdb2314cb248bc77f39e817d4c8fc70012e47b990d27ba96ee6d02d",`source_id`:"type2",`text`:"Type 2 diabetes, the most common type of diabetes, is a disease that occurs when your blood glucose, also called blood sugar, is too high. Blood glucose is your main source of energy and comes mainly from the food you eat. Insulin , a hormone made by the pancreas , helps glucose get into your cells to be used for energy. In type 2 diabetes, your body doesn’t make enough insulin or doesn’t use insulin well. Too much glucose then stays in your blood, and not enough reaches your cells.",`section`:"What is type 2 diabetes?",`section_context`:"What is type 2 diabetes?",`title`:"Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:56.897529+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9",`topics`:["diabetes","type2","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type2","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"dea8a8efbf8a1afd56e624abac4612e0f58421fa4c40c67406dd3a05e4ed0969"}) SET c += {`id`:"dea8a8efbf8a1afd56e624abac4612e0f58421fa4c40c67406dd3a05e4ed0969",`source_id`:"tests",`text`:"The oral glucose tolerance test (OGTT) helps doctors detect type 2 diabetes, prediabetes, and gestational diabetes. However, the OGTT is a more expensive test than the FPG test and the glucose challenge test, and it is not as easy to give.",`section`:"Oral glucose tolerance test",`section_context`:"What tests are used to diagnose diabetes? / Oral glucose tolerance test",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"df56950953a827294d0c95cdcf4a40712534af57221fc1614807f11c6fdf72c0"}) SET c += {`id`:"df56950953a827294d0c95cdcf4a40712534af57221fc1614807f11c6fdf72c0",`source_id`:"eye",`text`:"About one in three people with diabetes who are older than age 40 already have some signs of diabetic retinopathy. 1 Diabetic retinopathy is the most common cause of vision loss in people with diabetes. Each person’s outlook for the future, however, depends in large part on regular care. Finding and treating diabetic retinopathy early can reduce the risk of blindness by 95 percent.",`section`:"Diabetic retinopathy",`section_context`:"How common is diabetic eye disease? / Diabetic retinopathy",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"risk"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`title`:"Risk Factors for Type 2 Diabetes",`publisher`:"NIDDK",`version`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114"} MERGE (c:DiabetesEvidence {id:"e034c204449ef7dd07775362b436a5a8a40a2a099c3e4da4407e411673b08829"}) SET c += {`id`:"e034c204449ef7dd07775362b436a5a8a40a2a099c3e4da4407e411673b08829",`source_id`:"risk",`text`:"Most adults with a BMI of 25 or higher are overweight and have a higher risk of developing type 2 diabetes. 2 Asian Americans are overweight if their BMI is 23 or higher, 1 while Pacific Islanders are overweight if their BMI is 26 or higher. 3,4,5",`section`:"Body mass index",`section_context`:"Does your weight put you at risk for type 2 diabetes? / Body mass index",`title`:"Risk Factors for Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:48.116337+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114",`topics`:["diabetes","risk"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","risk"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"e0b2271f196b4d148c937e16abe34a90e56872bbea5bac22d8872c3d512056ea"}) SET c += {`id`:"e0b2271f196b4d148c937e16abe34a90e56872bbea5bac22d8872c3d512056ea",`source_id`:"living",`text`:"Your health care professional may recommend weight-loss surgery if you aren’t able to reach a healthy weight with meal planning, physical activity, and taking diabetes medicines that help with weight loss.",`section`:"What can I do to reach or maintain a healthy weight?",`section_context`:"What can I do to reach or maintain a healthy weight?",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"e3024473760ba4cb69deda4a5758f1e7444d2c72e36159a3c4b2a7a410fcce8b"}) SET c += {`id`:"e3024473760ba4cb69deda4a5758f1e7444d2c72e36159a3c4b2a7a410fcce8b",`source_id`:"management",`text`:"If you often have low blood glucose levels, you may need to change your diabetes meal plan, physical activity plan, or medicines. Very low blood glucose may lead to confusion or fainting , and it can become a serious medical emergency that must be treated right away.",`section`:"Recommended targets for blood glucose levels",`section_context`:"How can I check my blood glucose level at home? / Recommended targets for blood glucose levels",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"e327f589c3d0ae7ad5d2dfcf8145de1c0a229f428bcdd8690699d587820ffee9"}) SET c += {`id`:"e327f589c3d0ae7ad5d2dfcf8145de1c0a229f428bcdd8690699d587820ffee9",`source_id`:"foot",`text`:"Wear shoes and socks at all times. Do not walk barefoot or in just socks – even when you are indoors. You could step on something and hurt your feet. You may not feel any pain and may not know that you hurt yourself.",`section`:"Wear shoes and socks at all times",`section_context`:"What can I do to keep my feet healthy? / Wear shoes and socks at all times",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"e356a98b9ba5574aa4ceb56927dbae027774509ee17012e34b70b1f3449fdaa7"}) SET c += {`id`:"e356a98b9ba5574aa4ceb56927dbae027774509ee17012e34b70b1f3449fdaa7",`source_id`:"management",`text`:"Write a list of questions before your visit with a health care professional so you don’t forget what you want to ask.",`section`:"Who should be on my health care team?",`section_context`:"Who should be on my health care team?",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"e3ffa2d8069da9bdb98e9601c6643d3b35eca14119b664ad3576faffba46d299"}) SET c += {`id`:"e3ffa2d8069da9bdb98e9601c6643d3b35eca14119b664ad3576faffba46d299",`source_id`:"management",`text`:"You may worry that having diabetes means going without foods you enjoy. The good news is that you can still eat your favorite foods, but you might need to eat smaller portions or enjoy them less often. Work with your health care team, which may include a registered dietitian or a diabetes educator , to create a meal plan that works for you.",`section`:"Create a healthy meal plan",`section_context`:"How can a healthy lifestyle help manage my diabetes? / Create a healthy meal plan",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"e58d11c78b5c90b1b9d1188c0b45b4c561469fa858f6204d915efe47ee589b56"}) SET c += {`id`:"e58d11c78b5c90b1b9d1188c0b45b4c561469fa858f6204d915efe47ee589b56",`source_id`:"foot",`text`:"Make sure you wear socks, stockings, or nylons with your shoes to keep from getting blisters and sores. Choose clean, lightly padded socks that fit well. Socks with no seams are best.",`section`:"Wear shoes and socks at all times",`section_context`:"What can I do to keep my feet healthy? / Wear shoes and socks at all times",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"e67165a2f6d1cd478629bef8e3acb8be93f704f3b245b9b871cbb5e7e466d975"}) SET c += {`id`:"e67165a2f6d1cd478629bef8e3acb8be93f704f3b245b9b871cbb5e7e466d975",`source_id`:"foot",`text`:"If your doctor tells you to, use a pumice stone to smooth corns and calluses after bathing or showering. A pumice stone is a type of rock used to smooth the skin. Rub gently, only in one direction, to avoid tearing the skin.",`section`:"Smooth corns and calluses gently",`section_context`:"What can I do to keep my feet healthy? / Smooth corns and calluses gently",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"e67f2cbbfc8a70f2f28ba49b11fcace9804646b433ef1d75956d6be180c566f9"}) SET c += {`id`:"e67f2cbbfc8a70f2f28ba49b11fcace9804646b433ef1d75956d6be180c566f9",`source_id`:"type1",`text`:"The random plasma glucose test and fasting plasma glucose test measure your blood glucose level at the time your blood is drawn. The A1C test shows your average blood glucose level over the past 3 months.",`section`:"Blood glucose tests",`section_context`:"How do health care professionals diagnose type 1 diabetes? / Blood glucose tests",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"e6d94121fb43963a09bcf8e844fea63d47f16cf6aa6dc275e925f368a674bc3a"}) SET c += {`id`:"e6d94121fb43963a09bcf8e844fea63d47f16cf6aa6dc275e925f368a674bc3a",`source_id`:"foot",`text`:"Try the following tips to improve blood flow to your feet:",`section`:"Keep the blood flowing to your feet",`section_context`:"What can I do to keep my feet healthy? / Keep the blood flowing to your feet",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"e76bcd986fd3c13ac18601121374826ab88a9af4e484025d582ed4e080103f41"}) SET c += {`id`:"e76bcd986fd3c13ac18601121374826ab88a9af4e484025d582ed4e080103f41",`source_id`:"tests",`text`:"Certain types of hemoglobin , called hemoglobin variants, can interfere with measuring A1C levels. Most A1C tests used in the United States are not affected by the most common variants. If your A1C test results and blood glucose levels do not match, your doctor should consider that the A1C test may not be a reliable test for you.",`section`:"A1C test",`section_context`:"What tests are used to diagnose diabetes? / A1C test",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"e85760949167f7f6bab11fe40c782edb4d8e99040a79f330b4622580a22d1439"}) SET c += {`id`:"e85760949167f7f6bab11fe40c782edb4d8e99040a79f330b4622580a22d1439",`source_id`:"eye",`text`:"In the short term, you are not likely to have vision loss from high blood glucose. People sometimes have blurry vision for a few days or weeks when they’re changing their diabetes care plan or medicines. High glucose can change fluid levels or cause swelling in the tissues of your eyes that help you to focus, causing blurred vision. This type of blurry vision is temporary and goes away when your glucose level gets closer to normal.",`section`:"How does diabetes affect my eyes?",`section_context`:"How does diabetes affect my eyes?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"e86027438f9661e86612fdfad763245a23343f17f9e795d3df683ab0a60292a6"}) SET c += {`id`:"e86027438f9661e86612fdfad763245a23343f17f9e795d3df683ab0a60292a6",`source_id`:"living",`text`:"Healthy living may help keep your body’s blood pressure , cholesterol , and blood glucose level, also called blood sugar level, in the range your primary health care professional recommends. Your primary health care professional may be a doctor, a physician assistant, or a nurse practitioner. Healthy living may also help prevent or delay health problems from diabetes that can affect your heart, kidneys, eyes, brain, and other parts of your body.",`section`:"Healthy Living with Diabetes",`section_context`:"Healthy Living with Diabetes",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prevention"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`title`:"Preventing Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba"} MERGE (c:DiabetesEvidence {id:"e8e7a60f0d0e1fbd4f11ab2de6257d8f4b31bfde5657bef9dabcf045c9b07f5b"}) SET c += {`id`:"e8e7a60f0d0e1fbd4f11ab2de6257d8f4b31bfde5657bef9dabcf045c9b07f5b",`source_id`:"prevention",`text`:"Here are steps you should take for yourself and your child if you had gestational diabetes: Get tested for diabetes 6 to 12 weeks after your baby is born. If your blood glucose is still high, you may have type 2 diabetes. If your blood glucose is normal, you should get tested every 3 years to see if you have developed type 2 diabetes. Be more active and make healthy food choices to get back to a healthy weight. Breastfeed your baby. Breastfeeding gives your baby the right balance of nutrients and helps you burn calories.",`section`:"If I had gestational diabetes when I was pregnant, how can I lower my chances of developing type 2 diabetes?",`section_context`:"If I had gestational diabetes when I was pregnant, how can I lower my chances of developing type 2 diabetes?",`title`:"Preventing Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:49.393819+00:00",`last_reviewed`:"Last Reviewed November 2016",`source_sha256`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba",`topics`:["diabetes","prevention"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prevention"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"e8f0731228d8d9228f8161bf9e3c384760b66faf00840063db883f4dba2c2837"}) SET c += {`id`:"e8f0731228d8d9228f8161bf9e3c384760b66faf00840063db883f4dba2c2837",`source_id`:"type1",`text`:"Health care professionals often test for type 1 diabetes in people who have common diabetes symptoms. Since type 1 diabetes can run in families, your health care professional may test you for type 1 diabetes if you have no symptoms but have a parent or sibling with type 1 diabetes.",`section`:"How do health care professionals diagnose type 1 diabetes?",`section_context`:"How do health care professionals diagnose type 1 diabetes?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"e8fc89fdb1790ecee7fdc464722590eb9ddbbb371e5e673ef5910ce9b90fe086"}) SET c += {`id`:"e8fc89fdb1790ecee7fdc464722590eb9ddbbb371e5e673ef5910ce9b90fe086",`source_id`:"eye",`text`:"When symptoms do occur, they may include blurry or wavy vision frequently changing vision—sometimes from day to day dark areas or vision loss poor color vision spots or dark strings (also called floaters) flashes of light",`section`:"What are the symptoms of diabetic eye disease?",`section_context`:"What are the symptoms of diabetic eye disease?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"e9389cdab23c4306c40b5e32e025112415b4619845da28a56439693c7e4bb07e"}) SET c += {`id`:"e9389cdab23c4306c40b5e32e025112415b4619845da28a56439693c7e4bb07e",`source_id`:"living",`text`:"You may be able to reach and maintain a healthy weight by",`section`:"What can I do to reach or maintain a healthy weight?",`section_context`:"What can I do to reach or maintain a healthy weight?",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"ea13beaf0c8b310928956ce144eae3efffea85acb23346623667b9d50ce16aeb"}) SET c += {`id`:"ea13beaf0c8b310928956ce144eae3efffea85acb23346623667b9d50ce16aeb",`source_id`:"eye",`text`:"To prevent diabetic eye disease, or to keep it from getting worse, manage your diabetes ABCs: your A1c, blood pressure, and cholesterol; and quit smoking if you smoke. Read more information on how to manage diabetes .",`section`:"What can I do to protect my eyes?",`section_context`:"What can I do to protect my eyes?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"eadd389f84472f719d2e7b8ece6ceb246d2192d578cef26dd9c3b1a07dd3a232"}) SET c += {`id`:"eadd389f84472f719d2e7b8ece6ceb246d2192d578cef26dd9c3b1a07dd3a232",`source_id`:"eye",`text`:"Your chances of developing glaucoma or cataracts are about twice that of someone without diabetes.",`section`:"Glaucoma and cataracts",`section_context`:"How common is diabetic eye disease? / Glaucoma and cataracts",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"eb35f7a831e7541dd9baffb5be1185758b4a5d3914ff0fe638bb8bb2f0a89269"}) SET c += {`id`:"eb35f7a831e7541dd9baffb5be1185758b4a5d3914ff0fe638bb8bb2f0a89269",`source_id`:"living",`text`:"If you are an adult with overweight or obesity, work with your health care team to create a weight-loss plan. Losing 5% to 7% of your current weight may help you prevent or improve some health problems and manage your blood glucose, cholesterol, and blood pressure levels. 2 If you are worried about your child’s weight and they have diabetes, talk with their health care professional before your child starts a new weight-loss plan.",`section`:"What can I do to reach or maintain a healthy weight?",`section_context`:"What can I do to reach or maintain a healthy weight?",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type2"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`title`:"Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9"} MERGE (c:DiabetesEvidence {id:"ec71ef0fb09ad24c6cf1d135af56497d451728734a57df0f600a57978669cd67"}) SET c += {`id`:"ec71ef0fb09ad24c6cf1d135af56497d451728734a57df0f600a57978669cd67",`source_id`:"type2",`text`:"Ask your health care team what other changes you can make to prevent or delay type 2 diabetes.",`section`:"How can I lower my chances of developing type 2 diabetes?",`section_context`:"How can I lower my chances of developing type 2 diabetes?",`title`:"Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:56.897529+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9",`topics`:["diabetes","type2","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type2","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"ec9c913e1ffe4c54ec1be8ac1718459dd8fc060c8368e791d72e0b3c7d511cfa"}) SET c += {`id`:"ec9c913e1ffe4c54ec1be8ac1718459dd8fc060c8368e791d72e0b3c7d511cfa",`source_id`:"eye",`text`:"The retina is the inner lining at the back of each eye. The retina senses light and turns it into signals that your brain decodes, so you can see the world around you. Damaged blood vessels can harm the retina, causing a disease called diabetic retinopathy.",`section`:"Diabetic retinopathy",`section_context`:"How does diabetes affect my eyes? / Diabetic retinopathy",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"ec9ebe2fd80d31253e1132d56acf98b48150951362239ef4aeb92fba8aece832"}) SET c += {`id`:"ec9ebe2fd80d31253e1132d56acf98b48150951362239ef4aeb92fba8aece832",`source_id`:"type1",`text`:"TrialNet is a research network that offers autoantibody testing to some family members of people with type 1 diabetes. Some people at risk of developing symptoms of type 1 diabetes may be able to participate in TrialNet studies.",`section`:"Autoantibodies test",`section_context`:"How do health care professionals diagnose type 1 diabetes? / Autoantibodies test",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type2"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`title`:"Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9"} MERGE (c:DiabetesEvidence {id:"ecd75014fb4891a87302682746240263d1451fc139b441d3405775107eba434c"}) SET c += {`id`:"ecd75014fb4891a87302682746240263d1451fc139b441d3405775107eba434c",`source_id`:"type2",`text`:"Research such as the Diabetes Prevention Program , sponsored by the National Institutes of Health, has shown that you can take steps to reduce your chances of developing type 2 diabetes if you have risk factors for the disease. Here are some things you can do to lower your risk: Lose weight if you are overweight, and keep it off. You may be able to prevent or delay diabetes by losing 5 to 7 percent of your current weight. 1 For instance, if you weigh 200 pounds, your goal would be to lose about 10 to 14 pounds. Move more.",`section`:"How can I lower my chances of developing type 2 diabetes?",`section_context`:"How can I lower my chances of developing type 2 diabetes?",`title`:"Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:56.897529+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9",`topics`:["diabetes","type2","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type2","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"edcb35c8655f2dc521d0de2bdbbc7febc72904ae37fba577f2f34f11799a57a9"}) SET c += {`id`:"edcb35c8655f2dc521d0de2bdbbc7febc72904ae37fba577f2f34f11799a57a9",`source_id`:"eye",`text`:"The best ways to manage your diabetes and keep your eyes healthy are to",`section`:"What is diabetic eye disease?",`section_context`:"What is diabetic eye disease?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"ee50fd0585e3357c24fe52a99a9226f02fae179baa2efe21508cf4dfef668f4e"}) SET c += {`id`:"ee50fd0585e3357c24fe52a99a9226f02fae179baa2efe21508cf4dfef668f4e",`source_id`:"type1",`text`:"If you have type 1 diabetes, you need to take insulin to stay alive. Different types of insulin are available. Some types start to work quickly while others start to work more slowly. The effects of each type of insulin last for varying lengths of time. You may need to take more than one type of insulin. You can take insulin in a few ways, including needle and syringe insulin pen insulin pump",`section`:"Insulin and other diabetes medicines",`section_context`:"How can I manage type 1 diabetes? / Insulin and other diabetes medicines",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prevention"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`title`:"Preventing Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba"} MERGE (c:DiabetesEvidence {id:"ef25dd3e2d1b91fecb5704c5f3e4fa3001df3aa7b4099f5a3acc2209ccd49217"}) SET c += {`id`:"ef25dd3e2d1b91fecb5704c5f3e4fa3001df3aa7b4099f5a3acc2209ccd49217",`source_id`:"prevention",`text`:"Other names for prediabetes include impaired fasting glucose or impaired glucose tolerance. Some people call prediabetes “borderline diabetes.”",`section`:"What should I do if my health care professional told me I have prediabetes?",`section_context`:"What should I do if my health care professional told me I have prediabetes?",`title`:"Preventing Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:49.393819+00:00",`last_reviewed`:"Last Reviewed November 2016",`source_sha256`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba",`topics`:["diabetes","prevention"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prevention"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"ef94162276537a680b2f389db0c896549fa893083792799e2d2999a7f8f3ec24"}) SET c += {`id`:"ef94162276537a680b2f389db0c896549fa893083792799e2d2999a7f8f3ec24",`source_id`:"management",`text`:"Most often, ketoacidosis affects people with type 1 diabetes. However, some people with type 2 diabetes can develop ketoacidosis if they do not produce enough insulin.",`section`:"Checking urine for ketones",`section_context`:"How can I check my blood glucose level at home? / Checking urine for ketones",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"f084559bac675f674517e252ea3361d565bd3c9a8b93ecf6e42e095882fd1b59"}) SET c += {`id`:"f084559bac675f674517e252ea3361d565bd3c9a8b93ecf6e42e095882fd1b59",`source_id`:"living",`text`:"For people who have diabetes, carb counting and the plate method are two common ways to plan how much to eat or drink. Talk with your health care professional or health care team to find a method that works for you.",`section`:"Plan how much to eat or drink",`section_context`:"How can I plan what to eat or drink when I have diabetes? / Plan how much to eat or drink",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"symptoms"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`title`:"Symptoms & Causes of Diabetes",`publisher`:"NIDDK",`version`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60"} MERGE (c:DiabetesEvidence {id:"f118f48253e1a63cdd9a82419630b29065f8d98ea3180f3e27653771cfaa20cb"}) SET c += {`id`:"f118f48253e1a63cdd9a82419630b29065f8d98ea3180f3e27653771cfaa20cb",`source_id`:"symptoms",`text`:"If you take medicines for these conditions, you may want to ask your primary health care professional if your medicines could affect your risk of developing diabetes.",`section`:"Taking certain medicines",`section_context`:"What else can cause diabetes? / Taking certain medicines",`title`:"Symptoms & Causes of Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/symptoms-causes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.749054+00:00",`last_reviewed`:"Last Reviewed October 2024",`source_sha256`:"3a137e296650a8d9e6d9ca6b5a39e59dfcf9ced0f346ac9b222b8aa43092ed60",`topics`:["diabetes","symptoms","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","symptoms","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"f21fc23e87f538fa6d2478e6074e95825f55b92b56988efac25c6cfe549aa468"}) SET c += {`id`:"f21fc23e87f538fa6d2478e6074e95825f55b92b56988efac25c6cfe549aa468",`source_id`:"management",`text`:"For safety, you may sometimes need to compare your CGM glucose readings with results from a standard blood glucose meter. This could be needed if you doubt the accuracy of your CGM readings, if you are changing your insulin dose, or if your CGM gives a warning alert.",`section`:"Devices to help manage diabetes",`section_context`:"How can I check my blood glucose level at home? / Devices to help manage diabetes",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"f23fb10a0a726e8703b1cce13d9aec725db3403c188098146b2703822d25db8b"}) SET c += {`id`:"f23fb10a0a726e8703b1cce13d9aec725db3403c188098146b2703822d25db8b",`source_id`:"type1",`text`:"Type 1 diabetes is increasing among youth from certain racial and ethnic groups. However, new cases of type 1 diabetes are most common among White youth. Adults with diabetes who are younger than age 35 and have a healthy body weight are more likely to have type 1 diabetes than type 2 diabetes. 2",`section`:"Who is more likely to have type 1 diabetes?",`section_context`:"Who is more likely to have type 1 diabetes?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"f398346579f658ae18332a2361ff9aa4cad408d6ee25f9b62ed3ebeeb393ae4b"}) SET c += {`id`:"f398346579f658ae18332a2361ff9aa4cad408d6ee25f9b62ed3ebeeb393ae4b",`source_id`:"management",`text`:"Ask your primary care professional about adding other members to your team, including a diabetes educator, nurse, or registered dietitian who can tell you more about your disease and how to improve your self-care a dentist to check for gum diseases and other dental problems an eye doctor to check for diabetic eye disease a pharmacist to help you with your medicines other specialists if you develop health problems such as heart disease , kidney disease , erectile dysfunction , or foot problems a social worker who may be able to help you find financial help for diabetes care and community resources",`section`:"Who should be on my health care team?",`section_context`:"Who should be on my health care team?",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"f46e53d03ba28f207d9f78f3621a59275084e93eb284c6752fe058e6b99aa0fe"}) SET c += {`id`:"f46e53d03ba28f207d9f78f3621a59275084e93eb284c6752fe058e6b99aa0fe",`source_id`:"management",`text`:"You can check your blood glucose level at home with a blood glucose meter . The meter tests a drop of your blood, usually from a prick of your fingertip. The meter will show you how much glucose is in your blood at that moment.",`section`:"Devices to help manage diabetes",`section_context`:"How can I check my blood glucose level at home? / Devices to help manage diabetes",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"f59554639d2985e05472973bbb58f05aabc80b5ab0da9bc237edec32bda3a281"}) SET c += {`id`:"f59554639d2985e05472973bbb58f05aabc80b5ab0da9bc237edec32bda3a281",`source_id`:"prediabetes",`text`:"Healthy living may help prevent or reverse insulin resistance and prediabetes. Healthy living may also help prevent or delay the health problems related to these conditions. A healthy lifestyle may include",`section`:"Healthy living",`section_context`:"How can I prevent or reverse insulin resistance and prediabetes? / Healthy living",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prevention"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`title`:"Preventing Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba"} MERGE (c:DiabetesEvidence {id:"f5d3776706e6515cc8f795a6d8321878cc1e081fd2b6f172e01faa156c7a0201"}) SET c += {`id`:"f5d3776706e6515cc8f795a6d8321878cc1e081fd2b6f172e01faa156c7a0201",`source_id`:"prevention",`text`:"Get started with Your Game Plan to Prevent Type 2 Diabetes . For more support, you can find a lifestyle change program near you through the National Diabetes Prevention Program .",`section`:"What should I do if my health care professional told me I have prediabetes?",`section_context`:"What should I do if my health care professional told me I have prediabetes?",`title`:"Preventing Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:49.393819+00:00",`last_reviewed`:"Last Reviewed November 2016",`source_sha256`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba",`topics`:["diabetes","prevention"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prevention"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"f645a3cd27dc596d01deaf5e6ee4e026a30a1dbd6f3b9681b65632b7e660b990"}) SET c += {`id`:"f645a3cd27dc596d01deaf5e6ee4e026a30a1dbd6f3b9681b65632b7e660b990",`source_id`:"type1",`text`:"Although these blood glucose tests can help your health care professional tell if you have diabetes, the tests don’t show the type of diabetes you have.",`section`:"Blood glucose tests",`section_context`:"How do health care professionals diagnose type 1 diabetes? / Blood glucose tests",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prediabetes"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`title`:"Insulin Resistance & Prediabetes",`publisher`:"NIDDK",`version`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5"} MERGE (c:DiabetesEvidence {id:"f65a1d0be1a4219ab4744a556960f4b429d1d36e683e7c7ffc6ece2f2573c10a"}) SET c += {`id`:"f65a1d0be1a4219ab4744a556960f4b429d1d36e683e7c7ffc6ece2f2573c10a",`source_id`:"prediabetes",`text`:"The good news is that many people can take steps to prevent or delay prediabetes and type 2 diabetes. If you have prediabetes or type 2 diabetes, working with your health care team to manage your prediabetes or type 2 diabetes may help you prevent other health problems .",`section`:"What are insulin resistance and prediabetes?",`section_context`:"What are insulin resistance and prediabetes?",`title`:"Insulin Resistance & Prediabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/prediabetes-insulin-resistance",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:57.125356+00:00",`last_reviewed`:"Last Reviewed March 2025",`source_sha256`:"5e7bd38fd5f4c3cb0249be077a61a15a522a5394c259b41307e53cb3e0862fb5",`topics`:["diabetes","prediabetes","insulin_resistance"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prediabetes","insulin_resistance"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"f6793acbda1edcc162954220c255cfed51355787f61df500f780f1fde26a1c28"}) SET c += {`id`:"f6793acbda1edcc162954220c255cfed51355787f61df500f780f1fde26a1c28",`source_id`:"foot",`text`:"Wear shoes that fit well and protect your feet. Here are some tips for finding the right type of shoes: Walking shoes and athletic shoes are good for daily wear. They support your feet and allow them to “breathe.” Do not wear vinyl or plastic shoes, because they do not stretch or “breathe.” When buying shoes, make sure they feel good and have enough room for your toes. Buy shoes at the end of the day, when your feet are the largest, so that you can find the best fit.",`section`:"Wear shoes and socks at all times",`section_context`:"What can I do to keep my feet healthy? / Wear shoes and socks at all times",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type2"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`title`:"Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9"} MERGE (c:DiabetesEvidence {id:"f67cbccb4a5397effbc61594308e80e0417d30416a8f725a54e76118665eb1d6"}) SET c += {`id`:"f67cbccb4a5397effbc61594308e80e0417d30416a8f725a54e76118665eb1d6",`source_id`:"type2",`text`:"On this page: What is type 2 diabetes? Who is more likely to develop type 2 diabetes? What are the symptoms of diabetes? What causes type 2 diabetes? How do health care professionals diagnose type 2 diabetes? How can I manage my type 2 diabetes? What medicines do I need to treat my type 2 diabetes? What health problems can people with diabetes develop? How can I lower my chances of developing type 2 diabetes?",`section`:"Type 2 Diabetes",`section_context`:"Type 2 Diabetes",`title`:"Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:56.897529+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"9288f02c8e76a2ce40ca3feb4e59048b15942a42103b1813e76b3419120ba7c9",`topics`:["diabetes","type2","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type2","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"type1"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`title`:"Type 1 Diabetes",`publisher`:"NIDDK",`version`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff"} MERGE (c:DiabetesEvidence {id:"f77097146d7f4aa65b9736559ca73e38457b29e4324ed33db0b084b69a9a4d88"}) SET c += {`id`:"f77097146d7f4aa65b9736559ca73e38457b29e4324ed33db0b084b69a9a4d88",`source_id`:"type1",`text`:"People with type 1 diabetes can develop the same diabetes health problems as people with other types of diabetes. High blood glucose levels from diabetes can damage many parts of your body, including your",`section`:"What health problems can people with type 1 diabetes develop?",`section_context`:"What health problems can people with type 1 diabetes develop?",`title`:"Type 1 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes/type-1-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:55.533410+00:00",`last_reviewed`:"Last Reviewed February 2025",`source_sha256`:"607febf2245750fabf6efc7115db568b91d2a76c4550281eaec1f68676f911ff",`topics`:["diabetes","type1","causes"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","type1","causes"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"f8c9b0fd2de320ac5495b3fbbdf3cb3e05237e27e84b652ec617e9d53c05f1b5"}) SET c += {`id`:"f8c9b0fd2de320ac5495b3fbbdf3cb3e05237e27e84b652ec617e9d53c05f1b5",`source_id`:"eye",`text`:"Also, have a dilated eye exam at least once a year—or more often if recommended by your eye care professional. These actions are powerful ways to protect the health of your eyes—and can prevent blindness.",`section`:"What can I do to protect my eyes?",`section_context`:"What can I do to protect my eyes?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"f93afa858058a2ac1fd0430660691fb348c04d03a1a55546f2d4bb44a0329580"}) SET c += {`id`:"f93afa858058a2ac1fd0430660691fb348c04d03a1a55546f2d4bb44a0329580",`source_id`:"foot",`text`:"Try the following tips to improve blood flow to your feet: Put your feet up when you are sitting. Wiggle your toes for a few minutes throughout the day. Move your ankles up and down and in and out to help blood flow in your feet and legs. Do not wear tight socks or elastic stockings. Do not try to hold up loose socks with rubber bands. Be more physically active . Choose activities that are easy on your feet, such as walking, dancing, yoga or stretching, swimming, or bike riding. Stop smoking.",`section`:"Keep the blood flowing to your feet",`section_context`:"What can I do to keep my feet healthy? / Keep the blood flowing to your feet",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"tests"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`title`:"Diabetes Tests & Diagnosis",`publisher`:"NIDDK",`version`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47"} MERGE (c:DiabetesEvidence {id:"fa4a0e4eb98a4abc884861df22a9238bebbbafa98ed6eacc0b0dd047ba7f2b2c"}) SET c += {`id`:"fa4a0e4eb98a4abc884861df22a9238bebbbafa98ed6eacc0b0dd047ba7f2b2c",`source_id`:"tests",`text`:"The fasting plasma glucose (FPG) test measures your blood glucose level at a single point in time. For the most reliable results, your doctor will give you the test in the morning after you have fasted for at least 8 hours. Fasting means having nothing to eat or drink except sips of water.",`section`:"Fasting plasma glucose test",`section_context`:"What tests are used to diagnose diabetes? / Fasting plasma glucose test",`title`:"Diabetes Tests & Diagnosis",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:50.716485+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"673a94da406b41dcc9cc828708264ed155462dabaf7d65df5b59945172025f47",`topics`:["diabetes","tests"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","tests"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"risk"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`title`:"Risk Factors for Type 2 Diabetes",`publisher`:"NIDDK",`version`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114"} MERGE (c:DiabetesEvidence {id:"fc3e74db6353820b42ed165d797113f1b3159391342f9eb1106099564404356b"}) SET c += {`id`:"fc3e74db6353820b42ed165d797113f1b3159391342f9eb1106099564404356b",`source_id`:"risk",`text`:"Your BMI can help you tell if you are at a healthy weight or have overweight or obesity.",`section`:"Body mass index",`section_context`:"Does your weight put you at risk for type 2 diabetes? / Body mass index",`title`:"Risk Factors for Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/risk-factors-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:48.116337+00:00",`last_reviewed`:"Last Reviewed July 2022",`source_sha256`:"5032dd98da6293b99b43035840a28acf9a73213d45fe9ddf8dcca7bf2033c114",`topics`:["diabetes","risk"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","risk"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"living"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`title`:"Healthy Living with Diabetes",`publisher`:"NIDDK",`version`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0"} MERGE (c:DiabetesEvidence {id:"fccebb6ed1f88d280df83a1ccf45d2109f4dc15c4fde98c92e6b296148c9d6b7"}) SET c += {`id`:"fccebb6ed1f88d280df83a1ccf45d2109f4dc15c4fde98c92e6b296148c9d6b7",`source_id`:"living",`text`:"On this page: How can I plan what to eat or drink when I have diabetes? How can physical activity help manage my diabetes? What can I do to reach or maintain a healthy weight? Should I quit smoking? How can I take care of my mental health? Clinical Trials for Healthy Living with Diabetes",`section`:"Healthy Living with Diabetes",`section_context`:"Healthy Living with Diabetes",`title`:"Healthy Living with Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:52.390119+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"f109ed046abdfcbdc5ce5c2b28fd5e642c0ade2ea45dba81508cfbfed9d668e0",`topics`:["diabetes","nutrition","activity"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","nutrition","activity"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"definition"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`title`:"What Is Diabetes?",`publisher`:"NIDDK",`version`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1"} MERGE (c:DiabetesEvidence {id:"fce03546df07c0b9adbd61f854d212fb9485b20fcc71a6d00311d2b3a40f23d2"}) SET c += {`id`:"fce03546df07c0b9adbd61f854d212fb9485b20fcc71a6d00311d2b3a40f23d2",`source_id`:"definition",`text`:"A less common type of diabetes, called monogenic diabetes , is caused by a change in a single gene . Diabetes can also come from having surgery to remove the pancreas, or from damage to the pancreas due to conditions such as cystic fibrosis or pancreatitis .",`section`:"Other types of diabetes",`section_context`:"What are the different types of diabetes? / Other types of diabetes",`title`:"What Is Diabetes?",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.530017+00:00",`last_reviewed`:"Last Reviewed April 2023",`source_sha256`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1",`topics`:["diabetes","types"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","types"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"fd158d52e0946cf74259002c67eb726ac767e4164d8e2461f2c294adef300427"}) SET c += {`id`:"fd158d52e0946cf74259002c67eb726ac767e4164d8e2461f2c294adef300427",`source_id`:"eye",`text`:"Vitrectomy is a surgery to remove the clear gel that fills the center of the eye, called the vitreous gel. The procedure treats problems with severe bleeding or scar tissue caused by proliferative diabetic retinopathy. Scar tissue can force the retina to peel away from the tissue beneath it, like wallpaper peeling away from a wall. A retina that comes completely loose, or detaches, can cause blindness.",`section`:"Vitrectomy",`section_context`:"How do doctors treat diabetic eye disease? / Vitrectomy",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"fd8427da1cebe95d6737588f9690c75ff7815b14b835e399c98d1bea46c90cd5"}) SET c += {`id`:"fd8427da1cebe95d6737588f9690c75ff7815b14b835e399c98d1bea46c90cd5",`source_id`:"eye",`text`:"Having a full, dilated eye exam is the best way to check for eye problems from diabetes. Your doctor will place drops in your eyes to widen your pupils. This allows the doctor to examine a larger area at the back of each eye, using a special magnifying lens. Your vision will be blurry for a few hours after a dilated exam.",`section`:"How do doctors diagnose eye problems from diabetes?",`section_context`:"How do doctors diagnose eye problems from diabetes?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"prevention"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`title`:"Preventing Type 2 Diabetes",`publisher`:"NIDDK",`version`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba"} MERGE (c:DiabetesEvidence {id:"fe0bb337785c3f092b315ae4a19bf0281f8fe7b9a0eab274e5d76bd55fcec14e"}) SET c += {`id`:"fe0bb337785c3f092b315ae4a19bf0281f8fe7b9a0eab274e5d76bd55fcec14e",`source_id`:"prevention",`text`:"Research such as the Diabetes Prevention Program shows that you can do a lot to reduce your chances of developing type 2 diabetes. Here are some things you can change to lower your risk: Lose weight and keep it off. You may be able to prevent or delay diabetes by losing 5 to 7 percent of your starting weight. 1 For instance, if you weigh 200 pounds, your goal would be to lose about 10 to 14 pounds. Move more. Get at least 30 minutes of physical activity 5 days a week.",`section`:"How can I lower my chances of developing type 2 diabetes?",`section_context`:"How can I lower my chances of developing type 2 diabetes?",`title`:"Preventing Type 2 Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:49.393819+00:00",`last_reviewed`:"Last Reviewed November 2016",`source_sha256`:"9143c8f8b5fac24bc9aed8645afa048c97273d422b693539031a191cbe24d1ba",`topics`:["diabetes","prevention"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","prevention"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"eye"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`title`:"Diabetic Eye Disease",`publisher`:"NIDDK",`version`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e"} MERGE (c:DiabetesEvidence {id:"fedff0709157d05c0de417d4306df639b2af2a92d3ca84e299de5c410c598f47"}) SET c += {`id`:"fedff0709157d05c0de417d4306df639b2af2a92d3ca84e299de5c410c598f47",`source_id`:"eye",`text`:"Ask your eye care professional to help you find a low vision and rehabilitation clinic. Special eye care professionals can help you manage vision loss that cannot be corrected with glasses, contact lenses, medicine, or surgery. Special devices and training may help you make the most of your remaining vision so that you can continue to be active, enjoy hobbies, visit friends and family members, and live without help from others.",`section`:"What if I already have some vision loss from diabetes?",`section_context`:"What if I already have some vision loss from diabetes?",`title`:"Diabetic Eye Disease",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/diabetic-eye-disease",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:02.232149+00:00",`last_reviewed`:"Last Reviewed May 2017",`source_sha256`:"7c63d5ce9d38037ae4e6cc60acd07de1e68b59dcd64c0dc7e1f580d05946841e",`topics`:["diabetes","complications","eye"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","eye"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"foot"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`title`:"Diabetes & Foot Problems",`publisher`:"NIDDK",`version`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584"} MERGE (c:DiabetesEvidence {id:"ff5a1d9f758fb7784c9a779f86a4a90735e7030325d2dd9a4ef3d5cbc9bc7a21"}) SET c += {`id`:"ff5a1d9f758fb7784c9a779f86a4a90735e7030325d2dd9a4ef3d5cbc9bc7a21",`source_id`:"foot",`text`:"Over time, diabetes may cause nerve damage, also called diabetic neuropathy , that can cause tingling and pain, and can make you lose feeling in your feet. When you lose feeling in your feet, you may not feel a pebble inside your sock or a blister on your foot, which can lead to cuts and sores. Cuts and sores can become infected.",`section`:"How can diabetes affect my feet?",`section_context`:"How can diabetes affect my feet?",`title`:"Diabetes & Foot Problems",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:06:00.926475+00:00",`last_reviewed`:"Last Reviewed January 2017",`source_sha256`:"3f3b4808bf3230506d83f38ed2492edfe993e0e5184b3523bc28804507c7d584",`topics`:["diabetes","complications","foot"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","foot"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"neuropathy"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/nerve-damage-diabetic-neuropathies",`title`:"Diabetic Neuropathy",`publisher`:"NIDDK",`version`:"66214ea6f35f8b8a45f96550a4cc6c1101fa8e41650833491e65c7370e991455"} MERGE (c:DiabetesEvidence {id:"ff7d7898f2984836aa72f9fae43ee67f79b7a506ae9fb30116e600953e26b7ea"}) SET c += {`id`:"ff7d7898f2984836aa72f9fae43ee67f79b7a506ae9fb30116e600953e26b7ea",`source_id`:"neuropathy",`text`:"Focal neuropathies are conditions in which you typically have damage to single nerves, most often in your hand, head, torso, or leg. The most common types of focal neuropathy are entrapment syndromes, such as carpal tunnel syndrome. Other types of focal neuropathy are much less common.",`section`:"Focal Neuropathies",`section_context`:"Focal Neuropathies",`title`:"Diabetic Neuropathy",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/nerve-damage-diabetic-neuropathies",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:59.657648+00:00",`last_reviewed`:"Last Reviewed February 2018",`source_sha256`:"66214ea6f35f8b8a45f96550a4cc6c1101fa8e41650833491e65c7370e991455",`topics`:["diabetes","complications","neuropathy"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","complications","neuropathy"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"definition"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`title`:"What Is Diabetes?",`publisher`:"NIDDK",`version`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1"} MERGE (c:DiabetesEvidence {id:"ffb0867ae2193c3dd534c71c774453b807a329ea6fea6712aa392d51841977ed"}) SET c += {`id`:"ffb0867ae2193c3dd534c71c774453b807a329ea6fea6712aa392d51841977ed",`source_id`:"definition",`text`:"More than 133 million Americans have diabetes or prediabetes. 1",`section`:"How common are diabetes and prediabetes?",`section_context`:"How common are diabetes and prediabetes?",`title`:"What Is Diabetes?",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:46.530017+00:00",`last_reviewed`:"Last Reviewed April 2023",`source_sha256`:"790010f499a5fd554ede7491c44dfa040ccb69419cf1daa9eebf0fdcfde2b6b1",`topics`:["diabetes","types"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","types"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
MERGE (s:DiabetesSource {id:"management"}) SET s += {`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`title`:"Managing Diabetes",`publisher`:"NIDDK",`version`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9"} MERGE (c:DiabetesEvidence {id:"ffd9ea61121d9babd208f1d54dd6af32d598b56205748d7ad26026178238ac3e"}) SET c += {`id`:"ffd9ea61121d9babd208f1d54dd6af32d598b56205748d7ad26026178238ac3e",`source_id`:"management",`text`:"The A1C test shows your average blood glucose level over the last 3 months. This test is done at a health care professional’s office or lab. For most people with diabetes, their goal is an A1C level below 7%. 1 Your A1C goal may be different if you have other health problems. 2 Ask your health care team how often you should have the test and what your goal should be.",`section`:"A is for the A1C blood glucose test",`section_context`:"What are the diabetes ABCs? / A is for the A1C blood glucose test",`title`:"Managing Diabetes",`url`:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",`publisher`:"NIDDK",`retrieved_at`:"2026-11-02T16:05:53.969587+00:00",`last_reviewed`:"Last Reviewed October 2023",`source_sha256`:"8701db338bb2277ba22685ee0431ef3c7210172ebefbc8a665fb93184d1005f9",`topics`:["diabetes","management","monitoring"],`release`:"9bc475f0262cb2e45f985a8c1bb671b29828fb944eb6fdf1cee033e38fea5724"} MERGE (s)-[:HAS_CHUNK]->(c) WITH c UNWIND ["diabetes","management","monitoring"] AS topic MERGE (t:DiabetesTopic {id:topic}) MERGE (t)-[:SUPPORTED_BY]->(c);
